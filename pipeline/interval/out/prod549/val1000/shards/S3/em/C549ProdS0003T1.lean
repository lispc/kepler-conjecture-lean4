/-- mono 折叠组合（叶 10381，两叶引用零重算）. -/

theorem Fold10381 :
    checkPosFaceLo E549 (derivIExpr E549 2)
    B10381 2 PF10381 DP10381 = true := by
  have h1 : checkPosTMHull (derivIExpr E549 2) B10381 DP10381 = true := Der10381
  have h2 : checkPosTMHull E549 (faceBoxLo B10381 2) PF10381 = true := Face10381
  show (checkPosTMHull (derivIExpr E549 2) B10381 DP10381
      && checkPosTMHull E549 (faceBoxLo B10381 2) PF10381) = true
  rw [h1, h2, Bool.and_true]

/-- 全链 fold（叶 10381）：面叶+导数叶+证书 ⇒ 语义正性. -/

theorem Sem10381 (ρ : Fin 6 → ℝ) (hρ : boxMem B10381 ρ) :
    0 < E549.evalReal ρ :=
  checkPosFaceLo_sound DSafe10381 Fold10381 hρ

