+-- 有限集 u：vsub-像张成的 span 维数 ≤ Nat.card u（辅助件）。
+private theorem p2g_span_image_le_ncard (u : Set V3) (hu : u.Finite) (p : V3) :
+    Module.finrank ℝ ↥(Submodule.span ℝ ((fun x : V3 => x -ᵥ p) '' u)) ≤ Nat.card ↥u := by
+  obtain ⟨F, hF⟩ := hu.exists_finset_coe
+  have hstep1 : Module.finrank ℝ ↥(Submodule.span ℝ ((fun x : V3 => x -ᵥ p) '' u))
+      ≤ Module.finrank ℝ ↥(Submodule.span ℝ
+          ((F.image (fun x : V3 => x -ᵥ p) : Finset V3) : Set V3)) :=
+    Submodule.finrank_mono (Submodule.span_mono (by
+      rw [← hF, Finset.coe_image]))
+  have hstep2 : Module.finrank ℝ ↥(Submodule.span ℝ
+      ((F.image (fun x : V3 => x -ᵥ p) : Finset V3) : Set V3))
+      ≤ (F.image (fun x : V3 => x -ᵥ p)).card := by
+    have h2 := finrank_span_le_card (R := ℝ) (M := V3)
+      ((F.image (fun x : V3 => x -ᵥ p) : Finset V3) : Set V3)
+    simpa using h2
+  have h3 : (F.image (fun x : V3 => x -ᵥ p)).card ≤ F.card := Finset.card_image_le
+  have h4 : F.card = Nat.card u := by
+    rw [Nat.card_coe_set_eq, ← hF]
+    exact (Set.ncard_coe_finset F).symm
+  exact le_trans (le_trans hstep1 hstep2) (le_trans h3 (le_of_eq h4))
+
