+/-- pack3.hl:1956 `p2e_VORONOI_SET_SING`. -/
+private theorem p2e_VORONOI_SET_SING (V : Set V3) (u : V3) :
+    voronoiSet V {u} = voronoiClosed V u := by
+  ext x
+  constructor
+  · intro h t ht
+    exact h (voronoiClosed V u) ⟨u, rfl, rfl⟩ t ht
+  · intro h t ht
+    obtain ⟨v, hv, hvt⟩ := ht
+    rw [Set.mem_singleton_iff.1 hv] at hvt
+    rw [← hvt]
+    exact h
+
