+            rw [hcpX', hcp2, (p2e_MCELL_EXPLICIT 2 V (cellParams V X).2).2.2.1]
+            rw [mcell2, if_pos hcond, hhd0, hhd1, ← hsu1', ← hsu', ← hmm]
+            exact p23_pivot_mid_mem_mcell2shape (Ne.symm hne) (le_of_lt ht1')
