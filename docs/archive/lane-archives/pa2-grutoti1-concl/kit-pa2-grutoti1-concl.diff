+    have hax2 : (w - 0 : V3) = dist w 0 • e3 := by
+      rw [sub_zero]; exact haxD
+    rw [show zOf e1 e2 w1 = zOf e1 e2 (w1 - 0) from by rw [sub_zero]]
+    exact (zOf_ne_zero_iff he hax2 hw w1).mpr h1
