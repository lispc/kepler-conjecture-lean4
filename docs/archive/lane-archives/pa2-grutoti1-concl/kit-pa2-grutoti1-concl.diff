+/-- pack3.hl:1044 `p2e_INITIAL_SUBLIST_TRANS`. -/
+private theorem p2e_INITIAL_SUBLIST_TRANS {xl yl zl : List V3} (h1 : initialSublist xl yl)
+    (h2 : initialSublist yl zl) : initialSublist xl zl := by
+  obtain ⟨t1, ht1⟩ := h1
+  obtain ⟨t2, ht2⟩ := h2
+  exact ⟨t1 ++ t2, by rw [ht2, ht1, List.append_assoc]⟩
+
