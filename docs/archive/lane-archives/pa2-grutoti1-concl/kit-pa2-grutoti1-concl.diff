+/-- The bisector of a nondegenerate pair is a hyperplane, `affDim = 2`
+（`p2e_BIS_EQ_HYPERPLANE`（PA5 公开）+ `affDim_hyperplane`（Polytope 公开））. -/
+private theorem p2e_p15_affDim_bis_pair {u0 u1 : V3} (hne : u0 ≠ u1) :
+    affDim (p2e_bis u0 u1) = 2 := by
+  have hsub : u1 - u0 ≠ 0 := sub_ne_zero.mpr (Ne.symm hne)
+  rw [p2e_BIS_EQ_HYPERPLANE]
+  have heq : {x : V3 | 2 * ((u1 - u0) ⬝ᵥ x) = u1 ⬝ᵥ u1 - u0 ⬝ᵥ u0} =
+      {x : V3 | (u1 - u0) ⬝ᵥ x = (u1 ⬝ᵥ u1 - u0 ⬝ᵥ u0) / 2} := by
+    ext x
+    simp only [Set.mem_setOf_eq]
+    constructor
+    · intro h
+      linarith
+    · intro h
+      linarith
+  rw [heq]
+  exact affDim_hyperplane hsub _
