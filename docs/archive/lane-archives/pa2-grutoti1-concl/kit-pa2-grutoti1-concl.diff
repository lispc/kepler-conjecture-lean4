+/-- Real-linearity of `inner ℝ` in the right argument. -/
+private theorem p2e_p12_hsmR (t : ℝ) (u v : V3) : inner ℝ u (t • v) = t * inner ℝ u v :=
+  (inner_smul_real_right u v t).trans (smul_eq_mul t (inner ℝ u v))
