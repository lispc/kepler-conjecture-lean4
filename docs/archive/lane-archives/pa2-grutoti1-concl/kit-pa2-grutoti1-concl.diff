+      module
+    · -- orthogonality
+      have horthI : inner ℝ (x - (a + t • (b - a))) (b - a) = 0 := by
+        have hdec : x - (a + t • (b - a)) = (x - a) - t • (b - a) := by abel
+        rw [hdec, inner_sub_left, p2e_p12_hsmL t, htkeyI]
