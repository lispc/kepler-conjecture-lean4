+    (hbar : barV V k ul) (hsub : initialSublist vl ul) (hpos : 0 < vl.length) :
+    barV V (vl.length - 1) vl := by
+  refine ⟨by omega, fun wl hwl => hbar.2 wl ⟨p2e_INITIAL_SUBLIST_TRANS hwl.1 hsub, hwl.2⟩⟩
