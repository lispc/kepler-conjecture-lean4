+/-- pack3.hl:1740 `p2e_BARV_IMP_K_LE_3`. -/
+private theorem p2e_BARV_IMP_K_LE_3 (V : Set V3) (ul : List V3) (k : ℕ) (hbar : barV V k ul) :
+    k ≤ 3 := by
+  have h1 := hbar.2 ul ⟨p2e_INITIAL_SUBLIST_REFL ul, by simp [hbar.1]⟩
+  have h2 := h1.1
+  have h3 := hbar.1
+  omega
+
