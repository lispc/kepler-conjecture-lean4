+/-- Off `Z`, the covering cell index of a point is unique
+(`i,j ≤ 4`, `p ∈ mcell i ∩ mcell j` implies `i = j`). -/
+private theorem p2e_p13_cell_unique_off_Z (V : Set V3) (ul : List V3) (p : V3)
+    (hs : saturated V) (hp : Packing V) (hb : barV V 3 ul)
+    (hpZ : p ∈ rogers V ul \ p2e_sltZ V ul)
+    {i j : ℕ} (hi : i ≤ 4) (hj : j ≤ 4)
+    (hpi : p ∈ mcell i V ul) (hpj : p ∈ mcell j V ul) : i = j := by
+  by_cases h4 : p ∈ mcell 4 V ul
+  · have hlt : hl ul < Real.sqrt 2 := by
+      by_contra hc
+      rw [(p2e_MCELL_EXPLICIT 4 V ul).2.2.2.2 (le_refl 4), mcell4, if_neg hc] at h4
+      exact absurd h4 (Set.notMem_empty p)
+    have hall : ∀ k : ℕ, k ≤ 4 → p ∈ mcell k V ul → k = 4 := by
+      intro k hk hpk
+      interval_cases k
+      · exfalso
+        apply hpZ.2
+        have hB2 := p2e_p13t_mcell0_subset_B2 V ul p hs hp hb hlt hpk
+        simp only [p2e_sltZ, Set.mem_union]
+        tauto
+      · rw [(p2e_MCELL_EXPLICIT 1 V ul).2.1, mcell1,
+          if_neg (not_le.mpr hlt)] at hpk
+        exact absurd hpk (Set.notMem_empty p)
+      · rw [(p2e_MCELL_EXPLICIT 2 V ul).2.2.1, mcell2,
+          if_neg (by intro h; exact absurd h.2 (not_le.mpr hlt))] at hpk
+        exact absurd hpk (Set.notMem_empty p)
+      · rw [(p2e_MCELL_EXPLICIT 3 V ul).2.2.2.1, mcell3,
+          if_neg (by intro h; exact absurd h.2 (not_le.mpr hlt))] at hpk
+        exact absurd hpk (Set.notMem_empty p)
+      · rfl
+    rw [hall i hi hpi, hall j hj hpj]
+  · have hi3 : i ≤ 3 := by
+      rcases Nat.lt_or_ge i 4 with h | h
+      · omega
+      · exfalso
+        have hEq : mcell i V ul = mcell4 V ul := (p2e_MCELL_EXPLICIT i V ul).2.2.2.2 h
+        rw [hEq, ← (p2e_MCELL_EXPLICIT 4 V ul).2.2.2.2 (le_refl 4)] at hpi
+        exact h4 hpi
+    have hj3 : j ≤ 3 := by
+      rcases Nat.lt_or_ge j 4 with h | h
+      · omega
+      · exfalso
+        have hEq : mcell j V ul = mcell4 V ul := (p2e_MCELL_EXPLICIT j V ul).2.2.2.2 h
+        rw [hEq, ← (p2e_MCELL_EXPLICIT 4 V ul).2.2.2.2 (le_refl 4)] at hpj
+        exact h4 hpj
+    interval_cases i <;> interval_cases j
+    · rfl
+    · exact (p2e_p13_disjoint_mcell0_mcell1 V ul p hpZ hpi hpj).elim
+    · exact (p2e_p13_disjoint_mcell0_mcell2 V ul p hs hp hb hpZ hpi hpj).elim
+    · exact (hpZ.2 (p2e_p13t_mcell0_mcell3_subset_Z V ul p hs hp hb hpi hpj)).elim
+    · exact (p2e_p13_disjoint_mcell0_mcell1 V ul p hpZ hpj hpi).elim
+    · rfl
+    · exact (p2e_p13_disjoint_mcell1_mcell2 V ul p hpZ hpi hpj).elim
+    · exact (hpZ.2 (p2e_p13t_mcell1_mcell3_subset_Z V ul p hs hp hb hpi hpj)).elim
+    · exact (p2e_p13_disjoint_mcell0_mcell2 V ul p hs hp hb hpZ hpj hpi).elim
+    · exact (p2e_p13_disjoint_mcell1_mcell2 V ul p hpZ hpj hpi).elim
+    · rfl
+    · exact (hpZ.2 (p2e_p13t_mcell2_mcell3_subset_Z V ul p hs hp hb hpi hpj)).elim
+    · exact (hpZ.2 (p2e_p13t_mcell0_mcell3_subset_Z V ul p hs hp hb hpj hpi)).elim
+    · exact (hpZ.2 (p2e_p13t_mcell1_mcell3_subset_Z V ul p hs hp hb hpj hpi)).elim
+    · exact (hpZ.2 (p2e_p13t_mcell2_mcell3_subset_Z V ul p hs hp hb hpj hpi)).elim
+    · rfl
+
