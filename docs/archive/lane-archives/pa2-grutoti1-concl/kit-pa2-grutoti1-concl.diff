+/-- 非空集合的 `affDim ≥ 0`（`affDim = -1 ↔ s = ∅` 的另一半）。 -/
+private theorem p2e_p5_affDim_of_nonempty {s : Set V3} (hs : s ≠ ∅) : 0 ≤ affDim s := by
+  by_cases h0 : s = ∅
+  · exact absurd h0 hs
+  · rw [affDim, if_neg h0]
+    exact Nat.cast_nonneg _
