+          simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
+          obtain ⟨hinit4, -⟩ := p23_trunc_init_len 3 (cellParams V X).2
+            (by have h4 : (cellParams V X).2.length = 4 := hcpbar.1; omega)
