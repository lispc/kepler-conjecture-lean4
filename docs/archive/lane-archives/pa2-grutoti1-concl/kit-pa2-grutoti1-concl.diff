+/-- Real-linearity of `inner ℝ` in the left argument. -/
+private theorem p2e_p12_hsmL (t : ℝ) (u v : V3) : inner ℝ (t • u) v = t * inner ℝ u v :=
+  (inner_smul_real_left u v t).trans (smul_eq_mul t (inner ℝ u v))
