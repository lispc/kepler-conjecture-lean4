+/-- Dot functional on `V3`（Polytope `dotRight` 私拷）. -/
+private def p2e_p15_dotR (a : V3) : V3 →ₗ[ℝ] ℝ where
+  toFun x := a ⬝ᵥ x
+  map_add' x y := by
+    show a.ofLp ⬝ᵥ (x.ofLp + y.ofLp) = a.ofLp ⬝ᵥ x.ofLp + a.ofLp ⬝ᵥ y.ofLp
+    rw [dotProduct_add]
+  map_smul' r x := by
+    show a.ofLp ⬝ᵥ (r • x.ofLp) = (RingHom.id ℝ) r • (a.ofLp ⬝ᵥ x.ofLp)
+    rw [dotProduct_smul]
+    simp
+
