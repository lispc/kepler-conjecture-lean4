+PA8 消费面，九发波二处方）。 -/
+private theorem p2e_OMEGA_LIST_1_EXPLICIT_NEW (a b c d : V3) (V : Set V3) (ul : List V3)
+    (_hs : saturated V) (_hp : Packing V) (hb : barV V 3 ul)
+    (hul : ul = [a, b, c, d]) (hh : hl [a, b] < Real.sqrt 2) :
+    omegaListN V ul 1 = circumcenter {a, b} := by
+  rw [hul] at hb ⊢
+  have hb1 : barV V 1 [a, b] := by
+    simpa using p2e_BARV_INITIAL_SUBLIST V 3 [a, b, c, d] [a, b] hb
+      (p2e_INITIAL_SUBLIST_APPEND [a, b] [c, d]) (by simp)
+  have h1 : omegaListN V [a, b, c, d] 1 = omegaList V [a, b] := by
