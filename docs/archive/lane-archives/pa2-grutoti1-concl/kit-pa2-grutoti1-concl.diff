+/-- pack3.hl:1108 `p2e_INITIAL_SUBLIST_LENGTH_LE`. -/
+private theorem p2e_INITIAL_SUBLIST_LENGTH_LE {xl zl : List V3} (h : initialSublist xl zl) :
+    xl.length ≤ zl.length := by
+  obtain ⟨yl, hyl⟩ := h
+  rw [hyl, List.length_append]
+  omega
