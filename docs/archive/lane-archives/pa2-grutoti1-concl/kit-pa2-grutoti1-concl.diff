+    have htr1 : truncateSimplex 1 [u0, u1, u2, u3] =
+        truncateSimplex 1 [v0, v1, v2, v3] :=
+      p2e_TEZFFSK V [u0, u1, u2, u3] [v0, v1, v2, v3] 1 hs hp hb1 hb2 hrogers hdim
