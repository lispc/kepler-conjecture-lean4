+/-- B8a: the `p2e_SLTSTLO2` null set is null. -/
+private theorem p2e_p13_sltZ_null (V : Set V3) (ul : List V3)
+    (hs : saturated V) (hp : Packing V) (hb : barV V 3 ul) :
+    nullSet (p2e_sltZ V ul) := by
+  unfold p2e_sltZ
+  refine measure_union_null (measure_union_null (measure_union_null
+    (measure_union_null (measure_union_null (measure_union_null ?_ ?_) ?_) ?_)
+    ?_) ?_) ?_
+  · exact p2e_p13_nullset_frontier_rogers V ul hs hp hb
+  · exact p2e_NULLSET_SPHERE _ ⟨hdV ul, Real.sqrt 2, Real.sqrt_pos.2 (by norm_num), rfl⟩
+  · exact p2e_nullset_rcone_eq (hdV ul) (hdV (ul.tail))
+      (hl (truncateSimplex 1 ul) / Real.sqrt 2) (Ne.symm (p2e_p13_barV_hd_ne_tail V ul hb))
+  · exact p2e_p13_nullset_affineSpan_triple _ _ _
+  · exact p2e_p13_nullset_convexHull_pair _ _
+  · exact p2e_p13_nullset_affineSpan_triple _ _ _
+  · exact p2e_p13_nullset_affineSpan_triple _ _ _
+
+
+/-- B8a: existence of a covering cell index off `Z` (HOL's `p2e_SLTSTLO1`
+call, including the `p ∈ rogers \ Z` p2e_projection). -/
+private theorem p2e_p13_sltstlo2_exists (V : Set V3) (ul : List V3) (p : V3)
+    (hs : saturated V) (hp : Packing V) (hb : barV V 3 ul)
+    (hpZ : p ∈ rogers V ul \ p2e_sltZ V ul) :
+    ∃ i : ℕ, i ≤ 4 ∧ p ∈ mcell i V ul :=
+  p2e_SLTSTLO1 V ul p hs hp hb hpZ.1
+
+
+/-- GIANT — HOL `p2e_SLTSTLO2` (SLTSTLO.hl:582-3692; concl
+`pack_concl.hl:138`): away from an explicit null set `Z` the covering of
+the Rogers simplex by `mcell 0..4` is unique.
+
+DISCHARGES: PackingAuto2.SLTSTLO2_concl (PackingAuto2.lean:736).
+
+Proof architecture (HL). The witness is the union `Z = B1 ∪ … ∪ B7` of
+seven boundary surfaces of `ul`'s data: `B1 = frontier (rogers V ul)`
+(NEEDS `p2e_NULLSET_SPHERE`-style frontier/null arguments, `NEGLIGIBLE_UNION`
+for the finite union — the sphere piece is `p2e_NULLSET_SPHERE` above),
+`B2 = {w | norm (w - HD ul) = sqrt 2}` (the `mcell0`/`mcell1` interface,
+null by `p2e_NULLSET_SPHERE`), `B3 = rcone_eq (HD ul) (HD (TL ul))
+(hl (truncate_simplex 1 ul) / sqrt 2)` (the `mcell1`/`mcell2` cone
+interface; null as a surface via NEEDS `TRANSLATE_AFFINE_KY_LEMMA1`),
+`B4/B6` = affine hulls through `HD ul`-based triples (null: images of
+lower-dimensional flats, NEEDS `IN_AFFINE_KY_LEMMA1`),
+`B5 = convex hull {omega_list_n V ul 2, omega_list_n V ul 3}` and
+`B7 = affine hull {omega_list_n V ul 1, 2, 3}` (the `mcell3`/`mcell4`
+interfaces). Off `Z`, double membership `p ∈ mcell i V ul ∩ mcell j V vl`
+(`i ≠ j`, `i,j ≤ 4`) is killed by RVFXZBU1 (Auto10; its proof consumes
+NEEDS `XNHPWAB3/4` case algebra per index pair), giving the `∃!`. -/
+private theorem p2e_SLTSTLO2 (V : Set V3) (ul : List V3) :
+    ∃ Z : Set V3, ∀ p : V3, saturated V → Packing V → barV V 3 ul →
+      nullSet Z ∧ (p ∈ rogers V ul \ Z → ∃! i : ℕ, i ≤ 4 ∧ p ∈ mcell i V ul) := by
+  refine ⟨p2e_sltZ V ul, fun p hs hp hb => ⟨p2e_p13_sltZ_null V ul hs hp hb, ?_⟩⟩
+  rintro ⟨hpR, hpZ⟩
+  obtain ⟨i, hi4, hpi⟩ := p2e_p13_sltstlo2_exists V ul p hs hp hb ⟨hpR, hpZ⟩
+  refine ⟨i, ⟨hi4, hpi⟩, ?_⟩
+  rintro j ⟨hj4, hpj⟩
+  exact (p2e_p13_cell_unique_off_Z V ul p hs hp hb ⟨hpR, hpZ⟩ hi4 hj4 hpi hpj).symm
+
+
+/-- HOL `FINITE_SET_LIST_LEMMA` (p2e_AJRIPQN.hl:66-84): the `barV`-shaped 4-point
+lists drawn from a finite set form a finite set (HL: `FINITE_PRODUCT_DEPENDENT`
+along `CONS`). -/
+private theorem p2e_finiteSetListLemma_p17 {s : Set V3} (hs : s.Finite) :
+    {y : List V3 | ∃ u0 ∈ s, ∃ u1 ∈ s, ∃ u2 ∈ s, ∃ u3 ∈ s, y = [u0, u1, u2, u3]}.Finite := by
+  refine Set.Finite.subset (Set.Finite.image
+    (fun q : V3 × V3 × V3 × V3 => [q.1, q.2.1, q.2.2.1, q.2.2.2])
+    (hs.prod (hs.prod (hs.prod hs)))) ?_
+  rintro y ⟨u0, hu0, u1, hu1, u2, hu2, u3, hu3, rfl⟩
+  exact ⟨(u0, u1, u2, u3), ⟨hu0, hu1, hu2, hu3⟩, rfl⟩
+
