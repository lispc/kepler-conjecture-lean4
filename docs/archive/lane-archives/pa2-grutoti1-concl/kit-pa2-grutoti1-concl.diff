+private theorem p2e_p14_range_three (a b c : V3) :
+    Set.range ![a, b, c] = ({a, b, c} : Set V3) := by
+  ext z
+  constructor
+  · rintro ⟨t, rfl⟩
+    fin_cases t
+    · exact Or.inl rfl
+    · exact Or.inr (Or.inl rfl)
+    · exact Or.inr (Or.inr rfl)
+  · intro hz
+    rcases hz with h | h | h
+    · exact ⟨0, by simpa using h.symm⟩
+    · exact ⟨1, by simpa using h.symm⟩
+    · exact ⟨2, by simpa using h.symm⟩
+
+
+private theorem p2e_p14_three_set {v : Fin 3 → V3} {i j k : Fin 3}
+    (hbij : Function.Bijective ![i, j, k]) :
+    ({v i, v j, v k} : Set V3) = Set.range v := by
+  ext z
+  constructor
+  · intro hz
+    rcases hz with h | h | h
+    · exact ⟨i, h.symm⟩
+    · exact ⟨j, h.symm⟩
+    · exact ⟨k, h.symm⟩
+  · rintro ⟨t, rfl⟩
+    obtain ⟨s, rfl⟩ := hbij.2 t
+    fin_cases s
+    · exact Or.inl rfl
+    · exact Or.inr (Or.inl rfl)
+    · exact Or.inr (Or.inr rfl)
+
+
+private theorem p2e_p14_triple_set (a b c : V3) :
+    setOfList [a, b, c] = ({a, b, c} : Set V3) := by
+  ext z; simp [setOfList]
+
