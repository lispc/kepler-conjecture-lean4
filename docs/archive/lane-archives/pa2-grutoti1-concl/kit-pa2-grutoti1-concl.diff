+/-- pack3.hl:1961 `p2e_VORONOI_LIST_SING`. -/
+private theorem p2e_VORONOI_LIST_SING (V : Set V3) (u : V3) :
+    voronoiList V [u] = voronoiClosed V u := by
+  have hs : setOfList [u] = {u} := by simp [setOfList]
+  rw [voronoiList, hs, p2e_VORONOI_SET_SING]
