+  have hV : hdV ul ∈ V :=
+    p2e_BARV_SUBSET V 3 ul hul (p2e_HD_IN_SET_OF_LIST ul (by rw [hul.1]; norm_num))
+  exact p2e_p9_rogersInV_of_gltvhum V vl (hdV ul) hs hP hvl hV hmem'
