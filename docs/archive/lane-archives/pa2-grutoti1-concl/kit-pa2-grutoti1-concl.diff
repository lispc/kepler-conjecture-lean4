+/-- pack3.hl:428 `p2e_MID_POINT_EXISTS` (`between x (v,w)` encoded as
+`dist v x + dist x w = dist v w`). -/
+private theorem p2e_MID_POINT_EXISTS (v w : V3) (d : ℝ) (hd1 : 0 ≤ d) (hd2 : d ≤ dist v w) :
+    ∃ x : V3, dist v x + dist x w = dist v w ∧ dist v x = d := by
+  by_cases hvw : v = w
+  · subst hvw
+    have hd0 : d = 0 := by have h := dist_self v; linarith
+    refine ⟨v, ?_, ?_⟩ <;> simp [dist_self, hd0]
+  · have hD : 0 < dist v w := dist_pos.2 hvw
+    have hpos : 0 ≤ d / dist v w := div_nonneg hd1 hD.le
+    have hle1 : d / dist v w ≤ 1 := (div_le_one hD).2 hd2
+    have hnorm : ‖w - v‖ = dist v w := by rw [← dist_eq_norm, dist_comm]
+    have xeq : dist (v + (d / dist v w) • (w - v)) v = d := by
+      rw [dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_eq_abs,
+        abs_of_nonneg hpos, hnorm]
+      field_simp
+    have xeq2 : dist (v + (d / dist v w) • (w - v)) w = dist v w - d := by
+      rw [dist_eq_norm]
+      have hex : (v + (d / dist v w) • (w - v)) - w =
+          ((d / dist v w) - 1) • (w - v) := by
+        rw [sub_smul, smul_sub, one_smul]
+        abel
+      rw [hex, norm_smul, Real.norm_eq_abs,
+        abs_of_nonpos (by linarith : (d / dist v w) - 1 ≤ 0), hnorm]
+      field_simp
+      ring
+    have xe1 : dist v (v + (d / dist v w) • (w - v)) = d := by
+      rw [dist_comm]
+      exact xeq
+    exact ⟨v + (d / dist v w) • (w - v), by rw [xe1, xeq2]; ring, xe1⟩
+
+
+/-- pack3.hl:419 `p2e_AFFINE_HULL_INTERS_BIS`. An intersection of bisectors
+(affine sets, by `p2e_AFFINE_BIS`) is its own affine hull: take the infimum of the
+bisector subspaces in `AffineSubspace ℝ V3` and use `affineSpan_coe`. -/
+private theorem p2e_AFFINE_HULL_INTERS_BIS (p : V3) (s : Set V3) :
+    affineSpan ℝ (⋂₀ {p2e_bis p u | u ∈ s}) = ⋂₀ {p2e_bis p u | u ∈ s} := by
+  classical
+  have hex : ∀ u : s, ∃ K : AffineSubspace ℝ V3, (K : Set V3) = p2e_bis p (u : V3) :=
+    fun u => p2e_AFFINE_BIS p u
+  choose Kf hKf using hex
+  set K : AffineSubspace ℝ V3 := sInf (Set.range Kf) with hKdef
+  have hcarrier : ⋂₀ {p2e_bis p u | u ∈ s} = (K : Set V3) := by
+    ext x
+    rw [Set.mem_sInter, SetLike.mem_coe, AffineSubspace.mem_sInf_iff]
+    constructor
+    · intro hx K' hK'
+      obtain ⟨u, rfl⟩ := Set.mem_range.1 hK'
+      rw [← SetLike.mem_coe, hKf u]
+      exact hx _ ⟨u.1, u.2, rfl⟩
+    · intro hx T hT
+      obtain ⟨u, hu, rfl⟩ := hT
+      have he : x ∈ Kf ⟨u, hu⟩ := hx _ ⟨⟨u, hu⟩, rfl⟩
+      rw [← SetLike.mem_coe, hKf ⟨u, hu⟩] at he
+      exact he
+  rw [hcarrier, AffineSubspace.affineSpan_coe]
+
+
+/-- pack3.hl:415 `p2e_AFFINE_BIS`. The bisector is the carrier of the affine
+subspace through the midpoint `2⁻¹ • (a + b)` with direction the kernel of
+`x ↦ inner (b - a) x` (membership algebra on the distance-equality squares). -/
+private theorem p2e_AFFINE_BIS (a b : V3) : ∃ K : AffineSubspace ℝ V3, (K : Set V3) = p2e_bis a b := by
+  refine ⟨AffineSubspace.mk' ((2⁻¹ : ℝ) • (a + b))
+    (LinearMap.ker (innerSL ℝ (b - a) : V3 →ₗ[ℝ] ℝ)), ?_⟩
+  ext x
+  rw [SetLike.mem_coe, AffineSubspace.mem_mk', LinearMap.mem_ker]
+  show inner ℝ (b - a) (x - (2⁻¹ : ℝ) • (a + b)) = 0 ↔ dist x a = dist x b
+  have hsqinj : ‖x - a‖ = ‖x - b‖ ↔ ‖x - a‖ ^ 2 = ‖x - b‖ ^ 2 := by
+    constructor
+    · intro hh; rw [hh]
+    · intro hh
+      have hA : 0 ≤ ‖x - a‖ := norm_nonneg _
+      have hB : 0 ≤ ‖x - b‖ := norm_nonneg _
+      have hmul : (‖x - a‖ + ‖x - b‖) * (‖x - a‖ - ‖x - b‖) = 0 := by
+        have key : ‖x - a‖ * ‖x - a‖ - ‖x - b‖ * ‖x - b‖ = 0 := by
+          rw [← pow_two, ← pow_two, hh, sub_self]
+        nlinarith [key]
+      rcases mul_eq_zero.1 hmul with h | h
+      · linarith
+      · linarith
+  rw [inner_sub_right, real_inner_smul_right, dist_eq_norm, dist_eq_norm, hsqinj,
+    norm_sub_sq_real x a, norm_sub_sq_real x b]
+  have hL : inner ℝ (b - a) x = inner ℝ b x - inner ℝ a x := inner_sub_left b a x
+  have hE : inner ℝ (b - a) (a + b) = ‖b‖ ^ 2 - ‖a‖ ^ 2 := by
+    rw [inner_add_right, inner_sub_left, inner_sub_left, real_inner_comm b a,
+      real_inner_self_eq_norm_sq a, real_inner_self_eq_norm_sq b]
+    ring
+  rw [hL, hE]
+  constructor <;> intro h
+  · linarith [real_inner_comm x a, real_inner_comm x b]
+  · linarith [real_inner_comm x a, real_inner_comm x b]
+
+
+/-- `affDim` of an affine hull (HOL `AFF_DIM_AFFINE_HULL`). -/
+private theorem p2e_p6_affDim_affineSpan (s : Set V3) :
+    affDim ((affineSpan ℝ s : Set V3)) = affDim s := by
+  rcases s.eq_empty_or_nonempty with hs | hs
+  · rw [hs, affDim_empty, AffineSubspace.span_empty, AffineSubspace.bot_coe, affDim_empty]
+  · have hne : s ≠ ∅ := Set.nonempty_iff_ne_empty.mp hs
+    have hne2 : (affineSpan ℝ s : Set V3) ≠ ∅ := by
+      intro h0
+      exact hne (Set.subset_empty_iff.1 (h0 ▸ subset_affineSpan ℝ s))
+    simp only [affDim, if_neg hne, if_neg hne2]
+    rw [← AffineSubspace.direction_eq_vectorSpan (affineSpan ℝ s), direction_affineSpan]
+
+
+/-- HL `p2e_AFFINE_HULL_VORONOI_LIST_SUBSET_INTERS_BIS` (Rogers.hl:8623). -/
+private theorem p2e_AFFINE_HULL_VORONOI_LIST_SUBSET_INTERS_BIS (V : Set V3) (ul : List V3)
+    (hsub : setOfList ul ⊆ V) :
+    (affineSpan ℝ (voronoiList V ul) : Set V3) ⊆
+      ⋂₀ {p2e_bis (hdV ul) u | u ∈ setOfList ul} := by
+  cases ul with
+  | nil =>
+    intro z hz
+    rw [Set.mem_sInter]
+    intro T hT
+    exact absurd hT (by simp [setOfList])
+  | cons a t =>
+    have h1 : 1 ≤ (a :: t).length := by
+      show 1 ≤ t.length + 1
+      exact Nat.succ_le_succ (Nat.zero_le t.length)
+    rw [p2e_VORONOI_LIST_EQ_INTERS_BIS V (a :: t) hsub h1]
+    intro z hz
+    rw [Set.mem_sInter]
+    intro T hT
+    obtain ⟨u, hu, rfl⟩ := by simpa using hT
+    obtain ⟨K, hK⟩ := p2e_AFFINE_BIS (hdV (a :: t)) u
+    have hsubK : voronoiClosed V (hdV (a :: t)) ∩
+        ⋂₀ {p2e_bis (hdV (a :: t)) u | u ∈ setOfList (a :: t)} ⊆ (K : Set V3) := by
+      intro w hw
+      have hw2 : w ∈ ⋂₀ {p2e_bis (hdV (a :: t)) u | u ∈ setOfList (a :: t)} := hw.2
+      rw [Set.mem_sInter] at hw2
+      rw [hK]
+      exact hw2 _ (by simpa using ⟨u, hu, rfl⟩)
+    have hle : affineSpan ℝ (voronoiClosed V (hdV (a :: t)) ∩
+        ⋂₀ {p2e_bis (hdV (a :: t)) u | u ∈ setOfList (a :: t)}) ≤ K :=
+      affineSpan_le.mpr hsubK
+    have hzK : z ∈ (K : Set V3) := hle hz
+    rw [hK] at hzK
+    exact hzK
+
+
+/-- HL `p2e_VORONOI_LIST_EQ_INTERS_BIS` (Rogers.hl:8576). -/
+private theorem p2e_VORONOI_LIST_EQ_INTERS_BIS (V : Set V3) (ul : List V3)
+    (hsub : setOfList ul ⊆ V) (h1 : 1 ≤ ul.length) :
+    voronoiList V ul =
+      voronoiClosed V (hdV ul) ∩ ⋂₀ {p2e_bis (hdV ul) u | u ∈ setOfList ul} := by
+  have hhd_mem : hdV ul ∈ setOfList ul := by
+    cases ul with
+    | nil => exact absurd h1 (by simp)
+    | cons a t => simp [setOfList, hdV]
+  ext x
+  constructor
+  · intro hx
+    have hx2 : x ∈ ⋂₀ {voronoiClosed V v | v ∈ setOfList ul} := hx
+    rw [Set.mem_sInter] at hx2
+    have hx' : ∀ w ∈ setOfList ul, ∀ w' ∈ V, dist x w ≤ dist x w' := by
+      intro w hw w' hw'
+      have hzw : x ∈ voronoiClosed V w := hx2 _ (by simpa using ⟨w, hw, rfl⟩)
+      exact hzw w' hw'
+    have hA : ∀ w ∈ V, dist x (hdV ul) ≤ dist x w := hx' (hdV ul) hhd_mem
+    have hB : ∀ w ∈ setOfList ul, dist x (hdV ul) = dist x w := by
+      intro w hw
+      exact le_antisymm (hA w (hsub hw)) (hx' w hw (hdV ul) (hsub hhd_mem))
+    refine ⟨hA, ?_⟩
+    rw [Set.mem_sInter]
+    intro T hT
+    obtain ⟨u, hu, rfl⟩ := by simpa using hT
+    exact hB u hu
+  · intro hx
+    have hx1 : ∀ w' ∈ V, dist x (hdV ul) ≤ dist x w' := hx.1
+    have hxI : ∀ T ∈ {p2e_bis (hdV ul) u | u ∈ setOfList ul}, x ∈ T := hx.2
+    show x ∈ ⋂₀ {voronoiClosed V v | v ∈ setOfList ul}
+    rw [Set.mem_sInter]
+    intro U hU
+    obtain ⟨u, hu, rfl⟩ := by simpa using hU
+    intro w hw
+    have hC : dist x (hdV ul) = dist x u := hxI _ (by simpa using ⟨u, hu, rfl⟩)
+    rw [← hC]
+    exact hx1 w hw
+
+
+/-- HL `p2e_AFFINES_INTER_BALL_EQ_IMP_EQ` (Rogers.hl:8527). HL `affine s`
+(affine-set predicate) is rendered by the existential over
+`AffineSubspace ℝ V3`. -/
+private theorem p2e_AFFINES_INTER_BALL_EQ_IMP_EQ (s t : Set V3) (x : V3) (r : ℝ)
+    (hs : ∃ K : AffineSubspace ℝ V3, (K : Set V3) = s)
+    (ht : ∃ K : AffineSubspace ℝ V3, (K : Set V3) = t)
+    (hr : 0 < r) (heq : s ∩ Metric.ball x r = t ∩ Metric.ball x r)
+    (hx : x ∈ s) : s = t := by
+  have hxt : x ∈ t := by
+    have h1 : x ∈ s ∩ Metric.ball x r := ⟨hx, Metric.mem_ball.mpr (by simpa using hr)⟩
+    rw [heq] at h1
+    exact h1.1
+  obtain ⟨Ks, rfl⟩ := hs
+  obtain ⟨Kt, rfl⟩ := ht
+  -- the shift `p ↦ p - x` carries a carrier through `x` onto its direction
+  have shift : ∀ K : AffineSubspace ℝ V3, x ∈ K →
+      ∃ L : Submodule ℝ V3, (L : Set V3) = (fun p : V3 => p - x) '' (K : Set V3) := by
+    intro K hxK
+    refine ⟨K.direction, ?_⟩
+    ext q
+    constructor
+    · intro hq
+      exact ⟨q + x, AffineSubspace.vadd_mem_of_mem_direction hq hxK, by simp⟩
+    · rintro ⟨p, hp, rfl⟩
+      exact AffineSubspace.vsub_mem_direction hp hxK
+  obtain ⟨Ls, hLs⟩ := shift Ks hx
+  obtain ⟨Lt, hLt⟩ := shift Kt hxt
+  -- the ball intersection transfers through the shift
+  have key : ∀ K₁ K₂ : AffineSubspace ℝ V3,
+      (K₁ : Set V3) ∩ Metric.ball x r = (K₂ : Set V3) ∩ Metric.ball x r →
+      ((fun p : V3 => p - x) '' (K₁ : Set V3)) ∩ Metric.ball 0 r =
+        ((fun p : V3 => p - x) '' (K₂ : Set V3)) ∩ Metric.ball 0 r := by
+    intro K₁ K₂ h'
+    ext q
+    rw [Set.mem_inter_iff, Set.mem_inter_iff, Set.mem_image, Set.mem_image]
+    constructor
+    · rintro ⟨⟨p, hpK, rfl⟩, hqb⟩
+      have hpx : dist p x < r := by
+        rw [dist_eq_norm]
+        simpa using hqb
+      have hp2 : p ∈ (K₂ : Set V3) ∩ Metric.ball x r := by
+        rw [← h']
+        exact ⟨hpK, hpx⟩
+      exact ⟨⟨p, hp2.1, rfl⟩, hqb⟩
+    · rintro ⟨⟨p, hpK, rfl⟩, hqb⟩
+      have hpx : dist p x < r := by
+        rw [dist_eq_norm]
+        simpa using hqb
+      have hp2 : p ∈ (K₁ : Set V3) ∩ Metric.ball x r := by
+        rw [h']
+        exact ⟨hpK, hpx⟩
+      exact ⟨⟨p, hp2.1, rfl⟩, hqb⟩
+  have hshift := key Ks Kt heq
+  have hsubspace := p2e_SUBSPACES_INTER_BALL_EQ_IMP_EQ
+    ((fun p : V3 => p - x) '' (Ks : Set V3)) ((fun p : V3 => p - x) '' (Kt : Set V3)) r
+    ⟨Ls, hLs⟩ ⟨Lt, hLt⟩ hr hshift
+  -- translate back
+  ext p
+  constructor
+  · intro hp
+    have h1 : (p - x : V3) ∈ (fun p : V3 => p - x) '' (Ks : Set V3) := ⟨p, hp, rfl⟩
+    have h2 : (p - x : V3) ∈ (fun p : V3 => p - x) '' (Kt : Set V3) := by
+      rw [← hsubspace]
+      exact h1
+    obtain ⟨p', hp'Kt, hp'q⟩ := h2
+    have hp'p : p' = p := by simpa using hp'q
+    rw [hp'p] at hp'Kt
+    exact hp'Kt
+  · intro hp
+    have h1 : (p - x : V3) ∈ (fun p : V3 => p - x) '' (Kt : Set V3) := ⟨p, hp, rfl⟩
+    have h2 : (p - x : V3) ∈ (fun p : V3 => p - x) '' (Ks : Set V3) := by
+      rw [hsubspace]
+      exact h1
+    obtain ⟨p', hp'Ks, hp'q⟩ := h2
+    have hp'p : p' = p := by simpa using hp'q
+    rw [hp'p] at hp'Ks
+    exact hp'Ks
+
+
+/-- pack3.hl:536 `p2e_PACKING_IMP_DISCRETE`. -/
+private theorem p2e_PACKING_IMP_DISCRETE (V : Set V3) (hV : Packing V) : p2e_discrete V :=
+  ⟨2, two_pos, fun x y hx hy hlt => hV x hx y hy hlt⟩
+
+
+/-- pack3.hl:629 `p2e_VORONOI_CLOSED_CONTAINS_BALL`. -/
+private theorem p2e_VORONOI_CLOSED_CONTAINS_BALL (V : Set V3) (v : V3) (hV : Packing V) :
+    ∃ r : ℝ, 0 < r ∧ Metric.ball v r ⊆ voronoiClosed V v := by
+  by_cases hvV : v ∈ V
+  · refine ⟨1, one_pos, fun x hx w hw => ?_⟩
+    by_cases hvw : w = v
+    · subst hvw; exact le_refl _
+    · have h2 : 2 ≤ dist v w := by
+        have h3 := hV.dist_ge_two hw hvV hvw
+        rwa [dist_comm w v] at h3
+      have h1 : dist x v < 1 := Metric.mem_ball.1 hx
+      have ht := dist_triangle v x w
+      rw [dist_comm v x] at ht
+      linarith
+  · have hVcl : IsClosed V := p2e_CLOSED_DISCRETE V (p2e_PACKING_IMP_DISCRETE V hV)
+    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hVcl.isOpen_compl v (by simpa using hvV)
+    refine ⟨ε / 4, by linarith, fun x hx u hu => ?_⟩
+    have hge : ∀ u ∈ V, ε ≤ dist v u := by
+      intro u hu
+      refine le_of_not_gt fun hcon => ?_
+      have hmem : u ∈ Metric.ball v ε := Metric.mem_ball.2 (by rw [dist_comm]; exact hcon)
+      have hc : u ∈ Vᶜ := hball hmem
+      rw [Set.mem_compl_iff] at hc
+      exact hc hu
+    have hxv := Metric.mem_ball.1 hx
+    have ht := dist_triangle v x u
+    rw [dist_comm v x] at ht
+    have hge' := hge u hu
+    linarith
+
+
+/-! ## Center and ball containment (pack3.hl:613-789) -/
+
+/-- pack3.hl:613 `p2e_CENTER_IN_VORONOI_CELL`. -/
+private theorem p2e_CENTER_IN_VORONOI_CELL (V : Set V3) (v : V3) :
+    v ∈ voronoiClosed V v ∧ v ∈ p2e_voronoiOpen V v := by
+  refine ⟨fun w _ => by rw [dist_self]; exact dist_nonneg, fun w _ hwne => by
+    rw [dist_self v]
+    exact dist_pos.2 (Ne.symm hwne)⟩
+
+
+/-- pack3.hl:564 `p2e_TIWWFYQ`. The closest packing point to `p` (among the finite
+set `V ∩ ball p 2`, nonempty by saturation) has `p` in its Voronoi cell. -/
+private theorem p2e_TIWWFYQ (V : Set V3) (p : V3) (hV : Packing V) (hs : saturated V) :
+    ∃ v ∈ V, p ∈ voronoiClosed V v := by
+  obtain ⟨y, hyV, hyd⟩ := hs p
+  have hyb : y ∈ V ∩ Metric.ball p 2 :=
+    ⟨hyV, Metric.mem_ball.2 (by rwa [dist_comm])⟩
+  obtain ⟨v, hv, hvmin⟩ := Set.exists_min_image (V ∩ Metric.ball p 2)
+    (fun w : V3 => dist p w) (p2e_KIUMVTC p 2 V hV) ⟨y, hyb⟩
+  refine ⟨v, hv.1, fun w hw => ?_⟩
+  by_cases hfar : 2 ≤ dist p w
+  · -- `v` is within 2 of `p` (it competes with `y`), so a far `w` loses
+    have hvy : dist p v ≤ dist p y := hvmin y hyb
+    have hylt : dist p y < 2 := hyd
+    linarith
+  · exact hvmin w ⟨hw, Metric.mem_ball.2 (by rw [dist_comm]; exact not_le.1 hfar)⟩
+
+
+/-! ## p2e_KIUMVTC, p2e_TIWWFYQ (pack3.hl:541-613) -/
+
+/-- pack3.hl:541 `p2e_KIUMVTC`. -/
+private theorem p2e_KIUMVTC (p : V3) (r : ℝ) (V : Set V3) (hV : Packing V) :
+    (V ∩ Metric.ball p r).Finite := by
+  by_cases hr : r ≤ 0
+  · rw [Metric.ball_eq_empty.2 hr]
+    simp
+  · have hV' : Packing ((fun x : V3 => x - p) '' V) := by
+      intro u hu v hv hlt
+      obtain ⟨u, huV, rfl⟩ := hu
+      obtain ⟨v, hvV, rfl⟩ := hv
+      have hab : (u - p) - (v - p) = u - v := by abel
+      have h1 : dist u v < 2 := by
+        rw [dist_eq_norm, ← hab, ← dist_eq_norm]
+        exact hlt
+      exact congrArg (fun x => x - p) (hV u huV v hvV h1)
+    have hfin : (((fun x : V3 => x - p) '' V) ∩ Metric.ball 0 r).Finite :=
+      hV'.finite_inter_ball r
+    have hsub : V ∩ Metric.ball p r ⊆
+        (fun x : V3 => x + p) '' ((fun x : V3 => x - p) '' V ∩ Metric.ball 0 r) := by
+      rintro x ⟨hxV, hxb⟩
+      refine ⟨x - p, ⟨⟨x, hxV, rfl⟩, ?_⟩, by simp⟩
+      have h0 : dist 0 (x - p) = dist x p := by
+        rw [dist_eq_norm, dist_eq_norm, zero_sub, norm_neg]
+      exact Metric.mem_ball.2 (by rw [dist_comm, h0]; exact hxb)
+    have himg : ((fun x : V3 => x + p) ''
+        ((fun x : V3 => x - p) '' V ∩ Metric.ball 0 r)).Finite :=
+      Set.Finite.image (fun x : V3 => x + p) hfin
+    exact himg.subset hsub
+
+
+/-- HL `p2e_NEIGHBORHOOD_lemma` (Rogers.hl:8305). -/
+private theorem p2e_NEIGHBORHOOD_lemma (V S : Set V3) (p : V3) (hV : Packing V)
+    (hSV : S ⊆ V)
+    (hgap : ∀ u ∈ S, ∀ v ∈ V \ S, dist v p > dist u p) :
+    ∃ r : ℝ, 0 < r ∧ ∀ x ∈ Metric.ball p r, ∀ u ∈ S, ∀ v ∈ V \ S,
+      dist v x > dist u x := by
+  by_cases hSE : S = ∅
+  · refine ⟨1, by norm_num, ?_⟩
+    rw [hSE]
+    intro x _ u hu
+    exact absurd hu (by simp)
+  by_cases hVE : V \ S = ∅
+  · refine ⟨1, by norm_num, ?_⟩
+    intro x _ u _ v hv
+    exact absurd hv (by simp [hVE])
+  obtain ⟨v0, hv0⟩ := Set.nonempty_iff_ne_empty.mpr hVE
+  have hR : ∀ u ∈ S, dist u p < dist v0 p := fun u hu => hgap u hu v0 hv0
+  have hfin1 : (V ∩ Metric.ball p (dist v0 p)).Finite := p2e_KIUMVTC p (dist v0 p) V hV
+  have hfin2 : (V ∩ Metric.ball p (dist v0 p + 2)).Finite :=
+    p2e_KIUMVTC p (dist v0 p + 2) V hV
+  have hSfin : S.Finite := hfin1.subset fun u hu =>
+    ⟨hSV hu, Metric.mem_ball.mpr (hR u hu)⟩
+  have hWfin : ((V \ S) ∩ Metric.ball p (dist v0 p + 2)).Finite :=
+    hfin2.subset fun z hz => ⟨hz.1.1, hz.2⟩
+  obtain ⟨u0, hu0⟩ := Set.nonempty_iff_ne_empty.mpr hSE
+  have hv0b : v0 ∈ Metric.ball p (dist v0 p + 2) :=
+    Metric.mem_ball.mpr (show dist v0 p < dist v0 p + 2 by linarith)
+  have hv0W : v0 ∈ (V \ S) ∩ Metric.ball p (dist v0 p + 2) := ⟨hv0, hv0b⟩
+  have hPW : (S ×ˢ ((V \ S) ∩ Metric.ball p (dist v0 p + 2))).Finite :=
+    hSfin.prod hWfin
+  have hmem0 : (u0, v0) ∈ S ×ˢ ((V \ S) ∩ Metric.ball p (dist v0 p + 2)) :=
+    ⟨hu0, hv0W⟩
+  have hPWne : (S ×ˢ ((V \ S) ∩ Metric.ball p (dist v0 p + 2))).Nonempty :=
+    ⟨(u0, v0), hmem0⟩
+  have hgapU : (fun z : V3 × V3 => dist z.2 p - dist z.1 p) (u0, v0) ∈
+      (Set.Finite.toFinset hPW).image
+        (fun z : V3 × V3 => dist z.2 p - dist z.1 p) := by
+    refine Finset.mem_image.mpr ⟨(u0, v0), ?_, rfl⟩
+    exact Set.Finite.mem_toFinset _ |>.mpr hmem0
+  have hgne : ((Set.Finite.toFinset hPW).image
+      (fun z : V3 × V3 => dist z.2 p - dist z.1 p)).Nonempty :=
+    ⟨_, hgapU⟩
+  set gaps : Finset ℝ := (Set.Finite.toFinset hPW).image
+      (fun z : V3 × V3 => dist z.2 p - dist z.1 p) with hgdef
+  set d : ℝ := Finset.min' gaps hgne with hddef
+  have hdmin2 : ∀ b ∈ gaps, d ≤ b := fun b hb => Finset.min'_le gaps b hb
+  have hdm0 : d ≤ dist v0 p - dist u0 p := by
+    have h1 := hdmin2 ((fun z : V3 × V3 => dist z.2 p - dist z.1 p) (u0, v0)) hgapU
+    simpa using h1
+  have hdin2 : d ∈ gaps := Finset.min'_mem gaps hgne
+  obtain ⟨w, hwU, hdweq⟩ := Finset.mem_image.mp hdin2
+  have hwP : w ∈ S ×ˢ ((V \ S) ∩ Metric.ball p (dist v0 p + 2)) :=
+    (Set.Finite.mem_toFinset _).mp hwU
+  have hdw : dist w.2 p - dist w.1 p = d := hdweq
+  have hgtw : dist w.1 p < dist w.2 p := hgap w.1 hwP.1 w.2 hwP.2.1
+  have hdpos : 0 < d := by rw [← hdw]; linarith
+  refine ⟨min (d / 2) (1 / 2), lt_min (by linarith) (by norm_num), ?_⟩
+  intro x hx u hu v hv
+  have hxp : dist p x < min (d / 2) (1 / 2) := by
+    rw [dist_comm]; exact Metric.mem_ball.mp hx
+  have hxd : dist p x < d / 2 := lt_of_lt_of_le hxp (min_le_left _ _)
+  have hxh : dist p x < 1 / 2 := lt_of_lt_of_le hxp (min_le_right _ _)
+  have hsymm : dist p x = dist x p := dist_comm p x
+  by_cases hvin : v ∈ (V \ S) ∩ Metric.ball p (dist v0 p + 2)
+  · have hmem2 : (u, v) ∈ S ×ˢ ((V \ S) ∩ Metric.ball p (dist v0 p + 2)) :=
+      ⟨hu, hvin⟩
+    have hd' : d ≤ dist v p - dist u p := by
+      have h1 := hdmin2 ((fun z : V3 × V3 => dist z.2 p - dist z.1 p) (u, v))
+        (Finset.mem_image.mpr ⟨(u, v), Set.Finite.mem_toFinset _ |>.mpr hmem2, rfl⟩)
+      simpa using h1
+    have h1 : dist v p ≤ dist v x + dist x p := dist_triangle v x p
+    have h2 : dist u x ≤ dist u p + dist p x := dist_triangle u p x
+    linarith
+  · have hfar : dist v0 p + 2 ≤ dist v p := by
+      have h1' : ¬ dist v p < dist v0 p + 2 := fun h =>
+        hvin ⟨hv, Metric.mem_ball.mpr h⟩
+      exact le_of_not_gt h1'
+    have h2' : dist u p < dist v0 p := hR u hu
+    have h3 : dist v p - dist x p ≤ dist v x := by
+      linarith [dist_triangle v x p]
+    have h4' : dist u x ≤ dist u p + dist p x := dist_triangle u p x
+    linarith
+
+
+/-- HL `p2e_AFFINE_HULL_PROJECTION_DIST_LE` (Rogers.hl:6863). -/
+private theorem p2e_AFFINE_HULL_PROJECTION_DIST_LE (S : Set V3) (p v x n : V3)
+    (hv : v ∈ S) (hpxn : p = x + n) (hx : x ∈ (affineSpan ℝ S : Set V3))
+    (hn : ∀ u ∈ S, ∀ z ∈ S, (u - z) ⬝ᵥ n = 0) : dist x v ≤ dist p v := by
+  have horth := (p2e_ORTHOGONAL_TO_AFFINE_HULL_EQ S n).mp hn x hx v (mem_affineSpan ℝ hv)
+  have hdeq : (p - v : V3) = (x - v) + n := by rw [hpxn]; abel
+  have hsq : ‖x - v‖ ^ 2 ≤ ‖(x - v) + n‖ ^ 2 := by
+    rw [norm_add_sq_real, inner_eq_dot, horth]
+    linarith [sq_nonneg ‖x - v‖, sq_nonneg ‖n‖]
+  rw [dist_eq_norm, dist_eq_norm, hdeq]
+  have h0v : 0 ≤ ‖x - v‖ := norm_nonneg _
+  have hle := abs_le_of_sq_le_sq hsq (norm_nonneg _)
+  rw [abs_of_nonneg h0v] at hle
+  exact hle
+
+
+/-- HL `p2e_ORTHOGONAL_TO_AFFINE_HULL_EQ` (Rogers.hl:6799). -/
+private theorem p2e_ORTHOGONAL_TO_AFFINE_HULL_EQ (S : Set V3) (n : V3) :
+    (∀ v ∈ S, ∀ w ∈ S, (v - w) ⬝ᵥ n = 0) ↔
+      ∀ v ∈ (affineSpan ℝ S : Set V3), ∀ w ∈ (affineSpan ℝ S : Set V3),
+        (v - w) ⬝ᵥ n = 0 := by
+  constructor
+  · intro h v hv w hw
+    set U := (Submodule.span ℝ ({n} : Set V3)).orthogonal with hU
+    have hgen : ∀ a ∈ S, ∀ b ∈ S, (a - b : V3) ∈ U := by
+      intro a ha b hb
+      rw [hU, Submodule.mem_orthogonal']
+      intro y hy
+      simp only [Submodule.mem_span_singleton] at hy
+      obtain ⟨t, rfl⟩ := hy
+      rw [inner_smul_right, real_inner_comm, inner_eq_dot, dotProduct_comm,
+        h a ha b hb]
+      ring
+    have hsp : vectorSpan ℝ S ≤ U := by
+      rw [vectorSpan_def, Submodule.span_le]
+      rintro x ⟨a, ha, b, hb, rfl⟩
+      exact hgen a ha b hb
+    have h2 : (v - w : V3) ∈ vectorSpan ℝ S := by
+      rw [← direction_affineSpan]
+      exact AffineSubspace.vsub_mem_direction hv hw
+    have h3 := hsp h2
+    rw [hU, Submodule.mem_orthogonal'] at h3
+    have hy := h3 n (Submodule.subset_span (by simp))
+    rw [← inner_eq_dot]
+    exact hy
+  · intro h v hv w hw
+    exact h v (mem_affineSpan ℝ hv) w (mem_affineSpan ℝ hw)
+
+
+/-- HL `p2e_AFFINE_HULL_PROJECTION_DIST_EQ` (Rogers.hl:6776). -/
+private theorem p2e_AFFINE_HULL_PROJECTION_DIST_EQ (S : Set V3) (p v w x n : V3)
+    (hv : v ∈ S) (hw : w ∈ S) (hdist : dist p v = dist p w) (hpxn : p = x + n)
+    (hn : ∀ u ∈ S, ∀ z ∈ S, (u - z) ⬝ᵥ n = 0) : dist x v = dist x w := by
+  have hinn : inner ℝ (p - v) n = inner ℝ (p - w) n := by
+    have h1 : inner ℝ (w - v) n = 0 := by
+      have h0 := hn v hv w hw
+      rw [← inner_eq_dot] at h0
+      rw [show (w - v : V3) = -(v - w) from by abel, inner_neg_left]
+      linarith
+    have h3 : inner ℝ ((p - v) - (p - w)) n = 0 := by
+      rw [show ((p - v) - (p - w) : V3) = w - v from by abel]
+      exact h1
+    rw [inner_sub_left] at h3
+    linarith
+  have hxv : x - v = (p - v) - n := by rw [hpxn]; abel
+  have hxw : x - w = (p - w) - n := by rw [hpxn]; abel
+  have s2 : ‖x - v‖ ^ 2 = ‖x - w‖ ^ 2 := by
+    rw [hxv, hxw]
+    rw [norm_sub_sq_real (p - v) n, norm_sub_sq_real (p - w) n]
+    rw [hinn]
+    rw [show ‖p - v‖ = dist p v from (dist_eq_norm p v).symm,
+      show ‖p - w‖ = dist p w from (dist_eq_norm p w).symm, hdist]
+  rcases (sq_eq_sq_iff_eq_or_eq_neg (a := ‖x - v‖) (b := ‖x - w‖)).mp s2 with h5 | h5
+  · rw [dist_eq_norm, dist_eq_norm]; exact h5
+  · rw [dist_eq_norm, dist_eq_norm]
+    linarith [norm_nonneg (x - v), norm_nonneg (x - w)]
+
+
+/-- HL `p2e_AFFINE_HULL_PROJECTION_EXISTS` (Rogers.hl:6694). -/
+private theorem p2e_AFFINE_HULL_PROJECTION_EXISTS (S : Set V3) (p : V3) (hne : S ≠ ∅) :
+    ∃ x n : V3, p = x + n ∧ x ∈ (affineSpan ℝ S : Set V3) ∧
+      ∀ v ∈ S, ∀ w ∈ S, (v - w) ⬝ᵥ n = 0 := by
+  classical
+  obtain ⟨z, hz⟩ := Set.nonempty_iff_ne_empty.mpr hne
+  have hzK : (z:V3) ∈ (affineSpan ℝ S : Set V3) := mem_affineSpan ℝ hz
+  obtain ⟨d, hdD, n, hnD, hdec⟩ :=
+    Submodule.exists_add_mem_mem_orthogonal (K := (affineSpan ℝ S).direction) (p - z)
+  refine ⟨z + d, n, ?_, ?_, ?_⟩
+  · rw [add_assoc, hdec.symm]
+    abel
+  · have hvd : (z + d : V3) = d +ᵥ z := add_comm z d
+    rw [hvd]
+    exact AffineSubspace.vadd_mem_of_mem_direction hdD hzK
+  · intro v hv w hw
+    have hvK : (v:V3) ∈ (affineSpan ℝ S : Set V3) := mem_affineSpan ℝ hv
+    have hwK : (w:V3) ∈ (affineSpan ℝ S : Set V3) := mem_affineSpan ℝ hw
+    have hvwD : (v - w : V3) ∈ (affineSpan ℝ S).direction :=
+      AffineSubspace.vsub_mem_direction hvK hwK
+    have hinner : inner ℝ n (v - w) = 0 := by
+      rw [Submodule.mem_orthogonal'] at hnD
+      exact hnD _ hvwD
+    rw [← inner_eq_dot, real_inner_comm]
+    exact hinner
+
+
+/-- pack3.hl:2391 `p2e_AFF_DIM_VORONOI_LIST`. -/
+private theorem p2e_AFF_DIM_VORONOI_LIST (V : Set V3) (ul : List V3) (k : ℕ) (hbar : barV V k ul) :
+    affDim (voronoiList V ul) = 3 - k := by
+  have h1 := hbar.1
+  have h3 := (hbar.2 ul ⟨p2e_INITIAL_SUBLIST_REFL ul, by simp [hbar.1]⟩).2.2
+  omega
+
