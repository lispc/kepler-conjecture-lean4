+/-- Rogers.hl:3892 `p2e_OAPVION3`: the circumcenter is the unique equidistant
+point on the affine hull. -/
+private theorem p2e_OAPVION3 (S : Set V3) (h2 : ¬affineDependent S) :
+    ∀ p : V3, p ∈ (affineSpan ℝ S : Set V3) → (∃ c : ℝ, ∀ w ∈ S, dist p w = c) →
+      p = circumcenter S :=
+  OAPVION3_concl S h2
+
+
+/-- Rogers.hl:3851 `p2e_OAPVION2`: all points of `S` are at circumradius
+distance from the circumcenter. -/
+private theorem p2e_OAPVION2 (S : Set V3) (h2 : ¬affineDependent S) :
+    ∀ w ∈ S, radV S = dist (circumcenter S) w :=
+  OAPVION2_concl S h2
+
+
+/-- Rogers.hl:3843 `p2e_OAPVION1`: the circumcenter lies on the affine hull. -/
+private theorem p2e_OAPVION1 (S : Set V3) (h1 : S ≠ ∅) (h2 : ¬affineDependent S) :
+    circumcenter S ∈ (affineSpan ℝ S : Set V3) :=
+  OAPVION1_concl S h1 h2
+
