+private theorem p2e_p9_rogers_explicit (V : Set V3) (ul : List V3) (hb : barV V 3 ul) :
+    rogers V ul = convexHull ℝ {hdV ul, omegaListN V ul 1, omegaListN V ul 2,
+      omegaListN V ul 3} := by
+  have h4 : ul.length = 4 := by rw [hb.1]
