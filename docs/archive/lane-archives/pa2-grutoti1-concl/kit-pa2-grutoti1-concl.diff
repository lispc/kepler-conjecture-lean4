+  obtain ⟨u0, u1, u2, u3, hul⟩ := p2e_BARV_3_EXPLICIT V ul hb
+  have hu0 : u0 ∈ V := p2e_p9_barv_imp_u0_in_V V ul u0 u1 u2 u3 hs hp hb hul
