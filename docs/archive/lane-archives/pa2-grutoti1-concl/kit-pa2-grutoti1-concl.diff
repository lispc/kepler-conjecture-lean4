+    have e1 : Real.sqrt (‖x - u‖ ^ 2) = ‖x - u‖ := Real.sqrt_sq (norm_nonneg _)
+    have e2 : Real.sqrt (‖x - v‖ ^ 2) = ‖x - v‖ := Real.sqrt_sq (norm_nonneg _)
+    have h4 : Real.sqrt (‖x - u‖ ^ 2) = Real.sqrt (‖x - v‖ ^ 2) := by rw [h2]
