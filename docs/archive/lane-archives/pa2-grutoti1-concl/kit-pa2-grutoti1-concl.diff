+/-- pack3.hl:1245 `p2e_BUTLAST_INITIAL_SUBLIST`. -/
+private theorem p2e_BUTLAST_INITIAL_SUBLIST (ul : List V3) (h : 1 ≤ ul.length) :
+    initialSublist ul.dropLast ul := by
+  have hne : ul ≠ [] := by
+    rcases ul with _ | ⟨a, t⟩
+    · simp at h
+    · exact List.cons_ne_nil a t
+  exact ⟨[ul.getLast hne], (List.dropLast_append_getLast hne).symm⟩
