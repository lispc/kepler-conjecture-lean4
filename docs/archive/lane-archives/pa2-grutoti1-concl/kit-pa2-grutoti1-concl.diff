+private theorem p2e_p5_isClosed_voronoiList (V : Set V3) (ul : List V3) :
+    IsClosed (voronoiList V ul) := by
+  rw [voronoiList, voronoiSet]
+  refine isClosed_sInter ?_
+  rintro t ⟨w, -, rfl⟩
+  exact p2e_CLOSED_VORONOI_CLOSED V w
