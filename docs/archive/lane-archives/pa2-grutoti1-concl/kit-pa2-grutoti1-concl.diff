+/-- Bridge helper: dotProduct linearity in the left argument. -/
+private theorem p2e_dsub_dot (a b z : V3) : (a - b) ⬝ᵥ z = a ⬝ᵥ z - b ⬝ᵥ z := by
+  rw [← inner_eq_dot (a - b) z, inner_sub_left, inner_eq_dot a z, inner_eq_dot b z]
+
