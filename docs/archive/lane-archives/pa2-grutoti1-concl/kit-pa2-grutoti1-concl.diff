+/-- HL GRUTOTI.hl:1487-1488 analogue: the cap is inside the radius-`r`
+closed ball. -/
+private theorem grutoti_cap_subset_closedBall (u0 u1 : V3) (r d : ℝ) :
+    grutotiConicCap u0 u1 r d ⊆ Metric.closedBall u0 r := Set.inter_subset_left
