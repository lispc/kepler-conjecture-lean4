+  have hv : voronoiNondg V ul :=
+    hb.2 ul ⟨⟨[], by rw [List.append_nil]⟩, by rw [hul]; exact Nat.succ_pos 3⟩
+  have hsub : setOfList ul ⊆ V := hv.2.1
