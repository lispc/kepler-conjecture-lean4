+  have hneS : S.Nonempty := ⟨z1, hz1S⟩
+  have hSsub : S ⊆ p2e_bis u0 u1 := by
+    intro x hx
+    rw [hpair] at hx
+    rw [p2e_bis, Set.mem_setOf_eq]
