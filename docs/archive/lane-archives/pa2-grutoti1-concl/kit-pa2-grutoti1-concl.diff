+private theorem p2e_trunc_init_len (k : ℕ) (zl : List V3) (h : k + 1 ≤ zl.length) :
+    initialSublist (truncateSimplex k zl) zl ∧ (truncateSimplex k zl).length = k + 1 := by
+  have heps := @Classical.epsilon_spec _
+    (fun vl : List V3 => vl.length = k + 1 ∧ initialSublist vl zl)
+    ⟨zl.take (k + 1), List.length_take_of_le (by omega),
+      ⟨zl.drop (k + 1), (List.take_append_drop (k + 1) zl).symm⟩⟩
+  exact ⟨heps.2, heps.1⟩
+
+
+/-- pack3.hl:1856 `p2e_INITIAL_SUBLIST_IMP_TRUNCATE_SIMPLEX`. -/
+private theorem p2e_INITIAL_SUBLIST_IMP_TRUNCATE_SIMPLEX {xl yl : List V3} (h : initialSublist yl xl)
+    (hpos : 1 ≤ yl.length) : yl = truncateSimplex (yl.length - 1) xl ∧ yl.length ≤ xl.length := by
+  have hle := p2e_INITIAL_SUBLIST_LENGTH_LE h
+  have h1 := p2e_trunc_init_len (yl.length - 1) xl (by omega)
+  refine ⟨p2e_INITIAL_SUBLIST_UNIQUE h h1.1 (by omega) h1.2, p2e_INITIAL_SUBLIST_LENGTH_LE h⟩
+
+
+/-- pack3.hl:1831 `p2e_TRUNCATE_TRUNCATE_SIMPLEX`. -/
+private theorem p2e_TRUNCATE_TRUNCATE_SIMPLEX (ul : List V3) (i j : ℕ) (hij : i ≤ j)
+    (h : j + 1 ≤ ul.length) :
+    truncateSimplex i (truncateSimplex j ul) = truncateSimplex i ul := by
+  have hB := p2e_trunc_init_len j ul h
+  have hlen : i + 1 ≤ (truncateSimplex j ul).length := by omega
+  have hA := p2e_trunc_init_len i (truncateSimplex j ul) hlen
+  have hC := p2e_trunc_init_len i ul (by omega)
+  exact p2e_INITIAL_SUBLIST_UNIQUE (p2e_INITIAL_SUBLIST_TRANS hA.1 hB.1) hC.1 hA.2 hC.2
+
+
+/-- pack3.hl:1822 `p2e_HD_TRUNCATE_SIMPLEX`. -/
+private theorem p2e_HD_TRUNCATE_SIMPLEX (ul : List V3) (j : ℕ) (h : j + 1 ≤ ul.length) :
+    hdV (truncateSimplex j ul) = hdV ul := by
+  have h1 := p2e_trunc_init_len j ul h
+  obtain ⟨yl, hyl⟩ := h1.1
+  cases ul with
+  | nil => exact absurd h (by simp [List.length_nil])
+  | cons a t =>
+    cases hs : truncateSimplex j (a :: t) with
+    | nil =>
+      rw [hs] at h1
+      rw [List.length_nil] at h1
+      exact absurd h1.2 (by omega)
+    | cons b s =>
+      rw [hs] at hyl
+      injection hyl with e1 _
+      simp only [hdV]
+      exact e1.symm
+
+
+/-- pack3.hl:1814 `p2e_TRUNCATE_SIMPLEX_EQ_BUTLAST`. -/
+private theorem p2e_TRUNCATE_SIMPLEX_EQ_BUTLAST (ul : List V3) (h : 2 ≤ ul.length) :
+    truncateSimplex (ul.length - 2) ul = ul.dropLast := by
+  have h1 := p2e_trunc_init_len (ul.length - 2) ul (by omega)
+  have h2 : initialSublist ul.dropLast ul := p2e_BUTLAST_INITIAL_SUBLIST ul (by omega)
+  have h3 := p2e_LENGTH_BUTLAST ul (by omega)
+  have h3' : ul.dropLast.length = (ul.length - 2) + 1 := by omega
+  exact p2e_INITIAL_SUBLIST_UNIQUE h1.1 h2 h1.2 h3'
+
+
+/-- pack3.hl:1807 `p2e_LENGTH_TRUNCATE_SIMPLEX`. -/
+private theorem p2e_LENGTH_TRUNCATE_SIMPLEX (k : ℕ) (ul : List V3) (h : k + 1 ≤ ul.length) :
+    (truncateSimplex k ul).length = k + 1 := (p2e_trunc_init_len k ul h).2
+
+
+/-- pack3.hl:1799 `p2e_TRUNCATE_0_EQ_HEAD`. -/
+private theorem p2e_TRUNCATE_0_EQ_HEAD (ul : List V3) (h : 1 ≤ ul.length) :
+    truncateSimplex 0 ul = [hdV ul] := by
+  have hw : (truncateSimplex 0 ul).length = 0 + 1 ∧
+      initialSublist (truncateSimplex 0 ul) ul :=
+    Classical.epsilon_spec (p := fun vl : List V3 => vl.length = 0 + 1 ∧ initialSublist vl ul)
+      ⟨[hdV ul], rfl, p2e_INITIAL_SUBLIST_HD ul h⟩
+  have h1 := p2e_trunc_init_len 0 ul h
+  exact p2e_INITIAL_SUBLIST_UNIQUE h1.1 (p2e_INITIAL_SUBLIST_HD ul h) hw.1 rfl
+
+
+/-- pack3.hl:1792 `p2e_TRUNCATE_SIMPLEX_REFL`. -/
+private theorem p2e_TRUNCATE_SIMPLEX_REFL (k : ℕ) (ul : List V3) (h : ul.length = k + 1) :
+    truncateSimplex k ul = ul := by
+  have heps : (truncateSimplex k ul).length = k + 1 ∧ initialSublist (truncateSimplex k ul) ul :=
+    Classical.epsilon_spec (p := fun vl : List V3 => vl.length = k + 1 ∧ initialSublist vl ul)
+      ⟨ul, h, p2e_INITIAL_SUBLIST_REFL ul⟩
+  exact p2e_INITIAL_SUBLIST_UNIQUE heps.2 (p2e_INITIAL_SUBLIST_REFL ul) heps.1 h
+
+
+/-- pack3.hl:1777 `p2e_TRUNCATE_SIMPLEX_BARV`. -/
+private theorem p2e_TRUNCATE_SIMPLEX_BARV (V : Set V3) (r k : ℕ) (zl : List V3) (hbar : barV V k zl)
+    (hr : r ≤ k) : barV V r (truncateSimplex r zl) := by
+  have hbl := hbar.1
+  have h1 := p2e_trunc_init_len r zl (by omega)
+  have hb := p2e_BARV_INITIAL_SUBLIST V k zl (truncateSimplex r zl) hbar h1.1 (by omega)
+  rw [h1.2] at hb
+  simpa using hb
+
+
+/-- pack3.hl:1760 `p2e_TRUNCATE_SIMPLEX_INITIAL_SUBLIST`. -/
+private theorem p2e_TRUNCATE_SIMPLEX_INITIAL_SUBLIST (k : ℕ) (xl zl : List V3) :
+    (truncateSimplex k zl = xl ∧ k + 1 ≤ zl.length) ↔
+      initialSublist xl zl ∧ xl.length = k + 1 := by
+  constructor
+  · rintro ⟨heps, hle⟩
+    have hw : (truncateSimplex k zl).length = k + 1 ∧
+        initialSublist (truncateSimplex k zl) zl :=
+      Classical.epsilon_spec
+        (p := fun vl : List V3 => vl.length = k + 1 ∧ initialSublist vl zl)
+        ⟨zl.take (k + 1), List.length_take_of_le (by omega),
+          ⟨zl.drop (k + 1), (List.take_append_drop (k + 1) zl).symm⟩⟩
+    rw [heps] at hw
+    exact ⟨hw.2, hw.1⟩
+  · rintro ⟨hinit, hlen⟩
+    have hle2 := p2e_INITIAL_SUBLIST_LENGTH_LE hinit
+    have hw : (truncateSimplex k zl).length = k + 1 ∧
+        initialSublist (truncateSimplex k zl) zl :=
+      Classical.epsilon_spec
+        (p := fun vl : List V3 => vl.length = k + 1 ∧ initialSublist vl zl)
+        ⟨zl.take (k + 1), List.length_take_of_le (by omega),
+          ⟨zl.drop (k + 1), (List.take_append_drop (k + 1) zl).symm⟩⟩
+    refine ⟨(p2e_INITIAL_SUBLIST_UNIQUE hinit hw.2 hlen hw.1).symm, by omega⟩
+
+
+/-- HOL `p2e_TRUNCATE_SIMPLEX_GENERAL_1` (marchal1.hl:92):
+`ul = APPEND [a;b] vl ==> truncate_simplex 1 ul = [a;b]`. -/
+private theorem p2e_TRUNCATE_SIMPLEX_GENERAL_1 (ul vl : List V3) (a b : V3)
+    (h : ul = [a, b] ++ vl) : truncateSimplex 1 ul = [a, b] :=
+  ((p2e_TRUNCATE_SIMPLEX_INITIAL_SUBLIST 1 [a, b] ul).2
+    ⟨by rw [h]; exact p2e_INITIAL_SUBLIST_APPEND [a, b] vl, rfl⟩).1
