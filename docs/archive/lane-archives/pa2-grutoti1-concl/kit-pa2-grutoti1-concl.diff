+/-- the second entry of a family list is `u1` -/
+private theorem p23_hdTail_eq_u1 {V : Set V3} {u0 u1 : V3} {vl : List V3}
+    (hvl : vl ∈ p23Fam V u0 u1) : hdV vl.tail = u1 := by
+  obtain ⟨hb, htr⟩ := hvl
+  obtain ⟨v0, v1, v2, v3, hv⟩ := p2e_BARV_3_EXPLICIT V vl hb
