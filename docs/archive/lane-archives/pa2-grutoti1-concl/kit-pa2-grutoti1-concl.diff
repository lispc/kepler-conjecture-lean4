+private theorem p2e_p10la_norm_sq_dot (v : V3) :
+    ‖v‖ ^ 2 = (v : Fin 3 → ℝ) ⬝ᵥ (v : Fin 3 → ℝ) := by
+  have h := real_inner_self_eq_norm_sq v
+  rw [← h, EuclideanSpace.inner_eq_star_dotProduct]
+  simp
+
