+/-- pack3.hl:391 `p2e_BIS_LE_EQ_HALFSPACE`. -/
+private theorem p2e_BIS_LE_EQ_HALFSPACE (u v : V3) :
+    bisLe u v = {x : V3 | 2 * ((v - u) ⬝ᵥ x) ≤ v ⬝ᵥ v - u ⬝ᵥ u} :=
+  Set.ext (p2e_bis_mem_le u v)
