+private theorem p2e_p6_arcV_eq (u v w : V3) :
+    arcV u v w = Real.arccos (inner ℝ (v - u) (w - u) / (dist v u * dist w u)) := by
+  rw [arcV, ← inner_eq_dot]
+  rfl
