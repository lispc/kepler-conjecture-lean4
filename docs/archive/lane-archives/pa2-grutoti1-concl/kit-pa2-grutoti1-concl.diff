+private theorem p2e_p9_barv_imp_u0_in_V (V : Set V3) (ul : List V3) (u0 u1 u2 u3 : V3)
+    (hs : saturated V) (hp : Packing V) (hb : barV V 3 ul) (hul : ul = [u0, u1, u2, u3]) :
