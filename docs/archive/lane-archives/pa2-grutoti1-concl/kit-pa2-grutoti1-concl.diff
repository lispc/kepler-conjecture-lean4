+/-- HOL `p2e_TRUNCATE_SIMPLEX_EXPLICIT_1` (marchal1.hl:128). -/
+private theorem p2e_TRUNCATE_SIMPLEX_EXPLICIT_1 (a b c d : V3) :
+    truncateSimplex 1 [a, b] = [a, b] ∧
+    truncateSimplex 1 [a, b, c] = [a, b] ∧
+    truncateSimplex 1 [a, b, c, d] = [a, b] :=
+  ⟨p2e_TRUNCATE_SIMPLEX_GENERAL_1 _ [] a b rfl,
+   p2e_TRUNCATE_SIMPLEX_GENERAL_1 _ [c] a b rfl,
