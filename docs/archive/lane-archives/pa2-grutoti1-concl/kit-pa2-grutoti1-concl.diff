+/-- Pythagoras on the inner product. -/
+private theorem p2e_p12_pythI {u v : V3} (h : inner ℝ u v = 0) :
+    ‖u + v‖ ^ 2 = ‖u‖ ^ 2 + ‖v‖ ^ 2 := by
+  rw [norm_add_sq_real, h]
+  ring
