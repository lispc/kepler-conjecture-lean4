+/-- HL `p2e_HL_PROPERTIES` (Rogers.hl:7046). -/
+private theorem p2e_HL_PROPERTIES (V : Set V3) (ul : List V3) (k : ℕ) (hV : Packing V)
+    (hb : barV V k ul) :
+    ∀ w ∈ setOfList ul, dist (circumcenter (setOfList ul)) w = hl ul := by
+  intro w hw
+  exact p2e_circumcenter_lemma_p7 (setOfList ul) ⟨w, hw⟩
+    (p2e_BARV_AFFINE_INDEPENDENT V ul k hV hb) w hw
+
