+          (C * min (r ^ 2 - t ^ 2) ((1 - a ^ 2) / a ^ 2 * t ^ 2)))
+        (g := fun t => ENNReal.ofReal (C * ((1 - a ^ 2) / a ^ 2 * t ^ 2)))
