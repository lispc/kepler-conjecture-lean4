+    obtain ⟨t, ht, hX⟩ := hX
+    rw [Set.mem_setOf_eq] at ht
+    obtain ⟨vl, hmem, rfl⟩ := ht
+    rw [Set.mem_setOf_eq] at hmem
+    obtain ⟨hb, htr⟩ := hmem
