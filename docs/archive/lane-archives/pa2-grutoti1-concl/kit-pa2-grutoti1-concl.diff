+private noncomputable def p2e_p14_natEquiv (n : ℕ) : Fin n ⊕ ℕ ≃ ℕ :=
+  Equiv.ofBijective
+    (Sum.elim (fun i : Fin n => (i : ℕ)) (fun k : ℕ => n + k)) <| by
+    constructor
+    · intro a b h
+      cases a with
+      | inl i =>
+        cases b with
+        | inl j =>
+          simp only [Sum.elim_inl, Fin.val_eq_val] at h
+          exact congrArg Sum.inl h
+        | inr j =>
+          simp only [Sum.elim_inl, Sum.elim_inr] at h
+          have hi : (i : ℕ) < n := i.isLt
+          omega
+      | inr i =>
+        cases b with
+        | inl j =>
+          simp only [Sum.elim_inl, Sum.elim_inr] at h
+          have hj : (j : ℕ) < n := j.isLt
+          omega
+        | inr j =>
+          simp only [Sum.elim_inr] at h
+          exact congrArg Sum.inr (Nat.add_left_cancel h)
+    · intro m
+      by_cases hm : m < n
+      · exact ⟨Sum.inl ⟨m, hm⟩, by simp [Sum.elim]⟩
+      · exact ⟨Sum.inr (m - n), by simp [Sum.elim]; omega⟩
+
+
+private noncomputable def p2e_p14_natPerm {n : ℕ} (σ : Equiv.Perm (Fin n)) : Equiv.Perm ℕ :=
+  ((p2e_p14_natEquiv n).symm.trans (σ.sumCongr (Equiv.refl ℕ))).trans (p2e_p14_natEquiv n)
+
+
+private theorem p2e_p14_natEquiv_apply_inr (n : ℕ) (k : ℕ) :
+    p2e_p14_natEquiv n (Sum.inr k) = n + k := rfl
+
+
+private theorem p2e_p14_natEquiv_symm_apply_ge (n : ℕ) {j : ℕ} (hj : n ≤ j) :
+    (p2e_p14_natEquiv n).symm j = Sum.inr (j - n) := by
+  have h : p2e_p14_natEquiv n (Sum.inr (j - n)) = j := by
+    rw [p2e_p14_natEquiv_apply_inr, Nat.add_sub_cancel' hj]
+  calc (p2e_p14_natEquiv n).symm j
+      = (p2e_p14_natEquiv n).symm (p2e_p14_natEquiv n (Sum.inr (j - n))) := by rw [h]
+    _ = Sum.inr (j - n) := Equiv.symm_apply_apply _ _
+
+
+private theorem p2e_p14_natPerm_apply_ge {n : ℕ} (σ : Equiv.Perm (Fin n)) {j : ℕ}
+    (hj : n ≤ j) : p2e_p14_natPerm σ j = j := by
+  rw [p2e_p14_natPerm, Equiv.trans_apply, Equiv.trans_apply, p2e_p14_natEquiv_symm_apply_ge n hj,
+    Equiv.sumCongr_apply, Sum.map_inr, p2e_p14_natEquiv_apply_inr]
+  simp only [Equiv.refl_apply]
+  omega
+
+
+private theorem p2e_p14_natEquiv_apply_inl (n : ℕ) (i : Fin n) :
+    p2e_p14_natEquiv n (Sum.inl i) = (i : ℕ) := rfl
+
+
+private theorem p2e_p14_natEquiv_symm_apply_lt (n : ℕ) (i : Fin n) :
+    (p2e_p14_natEquiv n).symm (i : ℕ) = Sum.inl i := by
+  rw [← p2e_p14_natEquiv_apply_inl n i, Equiv.symm_apply_apply]
+
+
+private theorem p2e_p14_natPerm_apply_lt {n : ℕ} (σ : Equiv.Perm (Fin n)) (i : Fin n) :
+    p2e_p14_natPerm σ (i : ℕ) = (σ i : ℕ) := by
+  rw [p2e_p14_natPerm, Equiv.trans_apply, Equiv.trans_apply, p2e_p14_natEquiv_symm_apply_lt,
+    Equiv.sumCongr_apply, Sum.map_inl, p2e_p14_natEquiv_apply_inl]
+
+
+private theorem p2e_p14_natPerm_permutes {n : ℕ} (σ : Equiv.Perm (Fin n)) :
+    permutes (p2e_p14_natPerm σ) {j : ℕ | j < n} := by
+  intro j
+  constructor
+  · intro hj
+    have := p2e_p14_natPerm_apply_lt σ ⟨j, hj⟩
+    rw [this]
+    exact (σ ⟨j, hj⟩).isLt
+  · intro hj
+    by_contra hcon
+    have hge : n ≤ j := Nat.le_of_not_lt hcon
+    rw [p2e_p14_natPerm_apply_ge σ hge] at hj
+    exact absurd hj (Nat.not_lt.mpr hge)
+
+
+private theorem p2e_p14_natPerm_symm_lt {n : ℕ} (σ : Equiv.Perm (Fin n)) (i : Fin n) :
+    (p2e_p14_natPerm σ).symm (i : ℕ) = (σ.symm i : ℕ) := by
+  have h : p2e_p14_natPerm σ ((σ.symm i : Fin n) : ℕ) = (i : ℕ) := by
+    rw [p2e_p14_natPerm_apply_lt]
+    simp
+  rw [← h, Equiv.symm_apply_apply]
+
