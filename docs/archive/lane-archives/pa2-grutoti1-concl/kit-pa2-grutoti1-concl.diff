+/-! ## p2e_XYOFCGX (nearest-neighbor gap) .. p2e_XNHPWAB1 -/
+
+/-- HL `p2e_XYOFCGX_3_0` (Rogers.hl:6121): in a packing, no point of `V \ S`
+is nearer the circumcenter than any point of `S` (3-point case). -/
+private theorem p2e_XYOFCGX_3_0 (V S : Set V3) (hV : Packing V) (hSV : S ⊆ V)
+    (hind : ¬ affineDependent S) (hc : circumcenter S = 0)
+    (hr : radV S < Real.sqrt 2) (hcard : Nat.card S = 3) :
+    ∀ u v, u ∈ S → v ∈ V \ S → dist v 0 > dist u 0 := by
+  intro u v hu hv
+  have hfin : S.Finite :=
+    finite_set_of_fin_dim_affineIndependent (k := ℝ) (not_not.mp hind)
+  have hrad : ∀ z ∈ S, dist z 0 = radV S := fun z hz => by
+    have h := p2e_OAPVION2 S hind z hz
+    rw [hc, dist_comm] at h
+    exact h.symm
+  by_cases hcomp : dist v (0:V3) > dist u (0:V3)
+  · exact hcomp
+  · exfalso
+    push_neg at hcomp
+    have hdv : dist v 0 ≤ radV S := hcomp.trans (hrad u hu).le
+    obtain ⟨a, b, c, hSab, hab, hac, hbc⟩ := p2e_p7_card_3_imp_triple S hfin hcard
+    have hSne : S ≠ ∅ := by
+      intro hcon
+      rw [hcon] at hu
+      exact hu
+    have h0aff : (0:V3) ∈ (affineSpan ℝ ({a, b, c} : Set V3) : Set V3) := by
+      rw [← hc, hSab]
+      exact p2e_OAPVION1 _ (by rw [← hSab]; exact hSne) (by rw [← hSab]; exact hind)
+    obtain ⟨n, hn0, han, hbn, hcn⟩ := p2e_p7_exists_normal3 h0aff
+    have dotS : ∀ z ∈ S, z ⬝ᵥ n = 0 := by
+      intro z hz
+      rw [hSab] at hz
+      rcases Set.mem_insert_iff.mp hz with rfl | hz
+      · exact han
+      · rcases Set.mem_insert_iff.mp hz with rfl | hz
+        · exact hbn
+        · rw [Set.mem_singleton_iff.mp hz]; exact hcn
+    set w := p2e_projection v n with hwdef
+    have hwn : w ⬝ᵥ n = 0 := by
+      have hnn : inner ℝ n n ≠ 0 := by
+        rw [inner_eq_dot]
+        exact p2e_p7_dot_self_ne_zero n hn0
+      rw [hwdef, p2e_projection, ← inner_eq_dot, inner_sub_left, real_inner_smul_left]
+      rw [← inner_eq_dot v n]
+      rw [← inner_eq_dot n n]
+      rw [div_mul_cancel₀ _ hnn]
+      ring
+    have hwne : w ≠ 0 := by
+      intro h0
+      have h2le : (2:ℝ) ≤ dist u v :=
+        hV.dist_ge_two (hSV hu) hv.1 (fun hh => hv.2 (by rw [← hh]; exact hu))
+      have hpy := p2e_PYTHAGORAS_PROJECTION u v n (dotS u hu)
+      rw [← hwdef, h0, hrad u hu, dist_comm 0 v] at hpy
+      have hrad0 : 0 ≤ radV S := by rw [← hrad u hu]; exact dist_nonneg
+      have hb1 := p2e_p7_sq_lt_two hrad0 hr
+      have hb2 := p2e_p7_sq_lt_two dist_nonneg (lt_of_le_of_lt hdv hr)
+      have hge : (4:ℝ) ≤ dist u v ^ 2 := by
+        have hnn2 : (0:ℝ) ≤ dist u v := dist_nonneg
+        nlinarith [h2le, hnn2]
+      have hlt : dist u v ^ 2 < (2:ℝ) + 2 := by
+        calc dist u v ^ 2 = radV S ^ 2 + dist v 0 ^ 2 := hpy
+          _ < 2 + 2 := by linarith [hb1, hb2]
+      linarith [hge, hlt]
+    have hz0 : ∀ z ∈ S, z ≠ 0 := by
+      intro z hz
+      refine fun hzz => p2e_CIRCUMCENTER_NOT_EQ S hind (by omega) z hz ?_
+      rw [hzz]
+      exact hc
+    have hobtuse : ∀ z ∈ S, Real.pi / 2 < EuclideanGeometry.angle z 0 w := by
+      intro z hz
+      have hL := p2e_XYOFCGX_lemma0 V S 0 v hV hSV hind hc.symm hr hv (by rwa [dist_comm])
+        (by omega)
+      have hobs := hL.1 z hz
+      have hang : Real.pi / 2 < EuclideanGeometry.angle v 0 z := by
+        rwa [p2e_p7_arcV_eq_angle] at hobs
+      rw [EuclideanGeometry.angle_comm] at hang
+      exact p2e_OBTUSE_ANGLE_PROJECTION z v n hang (dotS z hz)
+    have hwnS : w ∉ S := by
+      intro hws
+      have h0w := hobtuse w hws
+      rw [EuclideanGeometry.angle, vsub_eq_sub, sub_zero,
+        InnerProductGeometry.angle_self hwne] at h0w
+      linarith [Real.pi_pos]
+    -- `insert w S` is a 4-point fan around the normal `n`, so the angle sum
+    -- around `n` would exceed `2π` — contradiction.
+    have hcardW : Nat.card ↑(insert w S) = 4 := by
+      haveI : Fintype ↥S := hfin.fintype
+      have h1 : Fintype.card ↥(insert w S) = Fintype.card ↥S + 1 := card_insert S hwnS
+      have h3 : Fintype.card ↥S = 3 := by
+        rw [← Nat.card_eq_fintype_card]
+        exact hcard
+      rw [Nat.card_eq_fintype_card, h1, h3]
+    have hazim : ∀ x y : V3, x ∈ insert w S → y ∈ insert w S → x ≠ y →
+        Real.pi / 2 < azim 0 n x y := by
+      intro x y hx hy hxy
+      have hx0 : x ≠ 0 := by
+        rcases Set.mem_insert_iff.mp hx with rfl | hxS
+        · exact hwne
+        · exact hz0 x hxS
+      have hy0 : y ≠ 0 := by
+        rcases Set.mem_insert_iff.mp hy with rfl | hyS
+        · exact hwne
+        · exact hz0 y hyS
+      have hxn : x ⬝ᵥ n = 0 := by
+        rcases Set.mem_insert_iff.mp hx with rfl | hxS
+        · exact hwn
+        · exact dotS x hxS
+      have hyn : y ⬝ᵥ n = 0 := by
+        rcases Set.mem_insert_iff.mp hy with rfl | hyS
+        · exact hwn
+        · exact dotS y hyS
+      have hncx : ¬ Collinear3 0 n x := by
+        refine p2e_IN_PLANE_NOT_COLLINEAR x n hx0 hn0 ?_
+        rw [dotProduct_comm]
+        exact hxn
+      have hncy : ¬ Collinear3 0 n y := by
+        refine p2e_IN_PLANE_NOT_COLLINEAR y n hy0 hn0 ?_
+        rw [dotProduct_comm]
+        exact hyn
+      have hang : Real.pi / 2 < EuclideanGeometry.angle x 0 y := by
+        rcases Set.mem_insert_iff.mp hx with rfl | hxS
+        · have hyS : y ∈ S := by
+            rcases Set.mem_insert_iff.mp hy with h | h
+            · exact absurd h.symm hxy
+            · exact h
+          have hyw := hobtuse y hyS
+          rw [EuclideanGeometry.angle_comm w 0 y]
+          exact hyw
+        rcases Set.mem_insert_iff.mp hy with rfl | hyS
+        · exact hobtuse x hxS
+        · have hL := p2e_XYOFCGX_lemma0 V S 0 v hV hSV hind hc.symm hr hv
+            (by rwa [dist_comm]) (by omega)
+          have hobs := hL.2 x hxS y hyS hxy
+          rwa [p2e_p7_arcV_eq_angle] at hobs
+      have hdeq : EuclideanGeometry.angle x 0 y = dihV 0 n x y :=
+        p2e_ANGLE_EQ_DIHV x y n hx0 hy0 hn0 (by rw [dotProduct_comm]; exact hxn)
+          (by rw [dotProduct_comm]; exact hyn)
+      rw [hdeq] at hang
+      exact lt_of_lt_of_le hang (p2e_DIHV_LE_AZIM 0 n x y hncx hncy)
+    have hWfin : (insert w S).Finite := hfin.insert w
+    have hbound := p2e_ANGLE_SUM_BOUND (insert w S) n (Real.pi / 2) (by positivity) hWfin
+      (by rw [hcardW]; norm_num) hazim
+    rw [hcardW] at hbound
+    have hpi : (0:ℝ) < Real.pi := Real.pi_pos
+    linarith
+
+
+/-- The translate of an affinely independent set is affinely independent
+(same proof as PA6's private `p2e_p6_not_affdep_image`; needed to transport
+`p2e_XYOFCGX_3_0`/`p2e_XYOFCGX_4_0` to general circumcenters). -/
+private theorem p2e_p7_not_affdep_image (s : Set V3) (a : V3) (h2 : ¬affineDependent s) :
+    ¬affineDependent ((fun x : V3 => a + x) '' s) := by
+  let hidx : ↥s ≃ (↥((fun x : V3 => a + x) '' s : Set V3)) :=
+    { toFun := fun x => ⟨a + (x : V3), ⟨x, x.2, rfl⟩⟩
+      invFun := fun y => ⟨(y : V3) - a, by
+        obtain ⟨z, hz, heq⟩ := y.2
+        rw [← heq]
+        simpa using hz⟩
+      left_inv := fun x => Subtype.ext (show a + (x : V3) - a = (x : V3) from by simp)
+      right_inv := fun y =>
+        Subtype.ext (show a + ((y : V3) - a) = (y : V3) from by simp) }
+  have hcoe : (fun y : ↥((fun x : V3 => a + x) '' s : Set V3) => (y : V3)) ∘ hidx =
+      (AffineEquiv.constVAdd ℝ V3 a) ∘ (fun x : ↥s => (x : V3)) := by
+    rfl
+  rw [affineDependent, not_not]
+  have hA : AffineIndependent ℝ
+      ((fun y : ↥((fun x : V3 => a + x) '' s : Set V3) => (y : V3)) ∘ hidx) := by
+    rw [hcoe, AffineEquiv.affineIndependent_iff]
+    exact not_not.mp h2
+  exact (affineIndependent_equiv hidx).mp hA
+
+
+/-- The packing property is translation invariant. -/
+private theorem p2e_p7_packing_image (V : Set V3) (a : V3) (hV : Packing V) :
+    Packing ((fun x : V3 => a + x) '' V) := by
+  intro w hw z hz hlt
+  obtain ⟨w', hw', rfl⟩ := hw
+  obtain ⟨z', hz', rfl⟩ := hz
+  have h2 : dist w' z' < 2 := by
+    rwa [← dist_add_left]
+  exact congrArg (fun t => a + t) (hV w' hw' z' hz' h2)
+
+
+/-- HL `p2e_XYOFCGX` (Rogers.hl:6559): the general circumcenter-gap statement. -/
+private theorem p2e_XYOFCGX (V S : Set V3) (p : V3) (hV : Packing V) (hSV : S ⊆ V)
+    (hind : ¬ affineDependent S) (hp : p = circumcenter S)
+    (hr : radV S < Real.sqrt 2) :
+    ∀ u v, u ∈ S → v ∈ V \ S → dist v p > dist u p := by
+  intro u v hu hv
+  have hfin : S.Finite :=
+    finite_set_of_fin_dim_affineIndependent (k := ℝ) (not_not.mp hind)
+  haveI := hfin.fintype
+  have hcardle : Nat.card S ≤ 4 := by
+    have h2 := (not_not.mp hind).card_le_finrank_succ (k := ℝ) (V := V3) (P := V3)
+    have h3 : Module.finrank ℝ ↥(vectorSpan ℝ (Set.range fun x : ↥S => (x : V3))) ≤ 3 := by
+      trans Module.finrank ℝ V3
+      · exact Submodule.finrank_le _
+      · rw [finrank_euclideanSpace_fin]
+    rw [Nat.card_eq_fintype_card]
+    omega
+  have hcardpos : 0 < Nat.card S := Nat.card_pos_iff.mpr ⟨⟨u, hu⟩, hfin⟩
+  by_cases h1 : Nat.card S = 1
+  · exact p2e_XYOFCGX_1 V S p hV hSV hind hp hr (by omega) u hu v hv
+  by_cases h2 : Nat.card S = 2
+  · exact p2e_XYOFCGX_2 V S p hV hSV hind hp hr h2 u hu v hv
+  -- translation to the circumcenter-0 setting for the 3- and 4-point cases
+  have hSne : S ≠ ∅ := fun hc0 => by
+    rw [hc0] at hu; exact hu
+  set K : Set V3 := (fun x : V3 => -p + x) '' S with hKdef
+  set W : Set V3 := (fun x : V3 => -p + x) '' V with hWdef
+  have hwV : Packing W := p2e_p7_packing_image V (-p) hV
+  have hKV : K ⊆ W := Set.image_mono hSV
+  have hindK : ¬ affineDependent K := p2e_p7_not_affdep_image S (-p) hind
+  have hcK : circumcenter K = 0 := by
+    rw [hKdef, p2e_CIRCUMCENTER_TRANSLATION S (-p) hSne hind, hp, neg_add_cancel]
+  have hrK : radV K < Real.sqrt 2 := by
+    rw [hKdef, p2e_RADV_TRANSLATION S (-p) hind]
+    exact hr
+  have hinj : Function.Injective (fun x : V3 => -p + x) := fun a b hab => add_left_cancel hab
+  have hcardK : Nat.card K = Nat.card S := Nat.card_image_of_injective hinj S
+  have huK : (-p + u) ∈ K := ⟨u, hu, rfl⟩
+  have hvW : (-p + v) ∈ W \ K := by
+    refine ⟨⟨v, hv.1, rfl⟩, ?_⟩
+    rintro ⟨z, hzS, hzeq⟩
+    refine hv.2 ?_
+    have hzv : z = v := add_left_cancel hzeq
+    rw [← hzv]; exact hzS
+  have hzp : ∀ z : V3, dist (-p + z) (0:V3) = dist z p := by
+    intro z
+    rw [show (0:V3) = -p + p from (neg_add_cancel p).symm, dist_add_left]
+  by_cases h3 : Nat.card S = 3
+  · have key := p2e_XYOFCGX_3_0 W K hwV hKV hindK hcK hrK (by rw [hcardK]; exact h3)
+      (-p + u) (-p + v) huK hvW
+    rwa [hzp, hzp] at key
+  by_cases h4 : Nat.card S = 4
+  · have key := p2e_XYOFCGX_4_0 W K hwV hKV hindK hcK hrK (by rw [hcardK]; exact h4)
+      (-p + u) (-p + v) huK hvW
+    rwa [hzp, hzp] at key
+  exact (by omega : False).elim
+
+
+/-- HL `p2e_CIRCUMCENTER_IN_VORONOI_SET` (Rogers.hl:8276). -/
+private theorem p2e_CIRCUMCENTER_IN_VORONOI_SET (V S : Set V3) (hV : Packing V)
+    (hSV : S ⊆ V) (hind : ¬ affineDependent S) (hr : radV S < Real.sqrt 2) :
+    circumcenter S ∈ voronoiSet V S := by
+  have hxy := p2e_XYOFCGX V S (circumcenter S) hV hSV hind rfl hr
+  show circumcenter S ∈ ⋂₀ {voronoiClosed V v | v ∈ S}
+  rw [Set.mem_sInter]
+  intro T hT
+  obtain ⟨w, hwS, rfl⟩ := by simpa using hT
+  intro w' hw'
+  by_cases hmem : w' ∈ S
+  · have h1 := OAPVION2_concl S hind w hwS
+    have h2 := OAPVION2_concl S hind w' hmem
+    rw [← h1, ← h2]
+  · have hw'V : w' ∈ V \ S := ⟨hw', hmem⟩
+    have hgap := hxy w w' hwS hw'V
+    rw [dist_comm w' (circumcenter S), dist_comm w (circumcenter S)] at hgap
+    exact le_of_lt hgap
+
+
+/-- pack3.hl:767 `p2e_VORONOI_BALL2`. -/
+private theorem p2e_VORONOI_BALL2 (V : Set V3) (v : V3) (hs : saturated V) :
+    voronoiClosed V v ⊆ Metric.ball v 2 := by
+  intro x hx
+  obtain ⟨y, hy, hxy⟩ := hs x
+  exact Metric.mem_ball.2 (lt_of_le_of_lt (hx y hy) hxy)
+
+
+/-- Bridge: a set containing an open ball has `affDim = 3` (full affine span,
+`affDim` reads off the `vectorSpan` finrank). -/
+private theorem p2e_affDim_of_mem_ball (s : Set V3) (x : V3) (r : ℝ) (hr : 0 < r)
+    (hsub : Metric.ball x r ⊆ s) : affDim s = 3 := by
+  have hne : s ≠ ∅ := fun hc => nonempty_iff_ne_empty.1
+    ⟨x, hsub (Metric.mem_ball_self hr)⟩ hc
+  have htop : affineSpan ℝ s = ⊤ := p2e_CONTAINS_BALL_AFFINE_HULL s x r hr hsub
+  have hd : vectorSpan ℝ s = ⊤ := by
+    rw [← direction_affineSpan, htop]
+    exact AffineSubspace.direction_top _ _ _
+  rw [affDim, if_neg hne, hd, finrank_top, finrank_euclideanSpace_fin]
+  norm_num
+
+
+/-- pack3.hl:753 `p2e_AFF_DIM_VORONOI_CLOSED`. The closed Voronoi cell of a
+packing point contains a ball around `v` (`p2e_VORONOI_CLOSED_CONTAINS_BALL`),
+hence is full-dimensional. -/
+private theorem p2e_AFF_DIM_VORONOI_CLOSED (V : Set V3) (v : V3) (hV : Packing V) :
+    affDim (voronoiClosed V v) = 3 := by
+  obtain ⟨r, hr, hball⟩ := p2e_VORONOI_CLOSED_CONTAINS_BALL V v hV
+  exact p2e_affDim_of_mem_ball _ v r hr hball
+
+/-- pack3.hl:1448 `p2e_CARD_SET_OF_LIST_EQ_LENGTH_IMP_ALL_DISTINCT`. A duplicate
+entry can be erased (`List.eraseIdx`), keeping the point set unchanged while
+shortening the list — contradicting the card/length equality. -/
+private theorem p2e_CARD_SET_OF_LIST_EQ_LENGTH_IMP_ALL_DISTINCT (ul : List V3)
+    (h : Nat.card (setOfList ul) = ul.length) (i j : ℕ) (hi : i < ul.length)
+    (hj : j < ul.length) (hij : i ≠ j) : elV ul i ≠ elV ul j := by
+  by_contra hcon
+  have key : ∀ k l : ℕ, k < l → l < ul.length → elV ul k = elV ul l → False := by
+    intro k l hkl hl heq
+    have hkl' : k < ul.length := by omega
+    have heq' : ul.getD k 0 = ul.getD l 0 := heq
+    rw [List.getD_eq_getElem _ _ hkl', List.getD_eq_getElem _ _ hl] at heq'
+    set ul2 := ul.eraseIdx l with hul2
+    have hlen2 : ul2.length = ul.length - 1 := by
+      rw [hul2, List.length_eraseIdx, if_pos hl]
+    have hset : setOfList ul2 = setOfList ul := by
+      ext x
+      constructor
+      · exact List.mem_of_mem_eraseIdx
+      · intro hx
+        obtain ⟨k', hk', rfl⟩ := List.mem_iff_getElem.1 hx
+        rcases eq_or_ne k' l with rfl | hne
+        · exact List.mem_eraseIdx_iff_getElem.2 ⟨k, hkl', by omega, heq'⟩
+        · exact List.mem_eraseIdx_iff_getElem.2 ⟨k', hk', hne, rfl⟩
+    have hseteq : ∀ l : List V3, setOfList l = ((l.toFinset : Set V3)) := by
+      intro l
+      ext a
+      simp [setOfList]
+    have hcard : Nat.card (setOfList ul) = ul.toFinset.card := by
+      rw [hseteq, Nat.card_eq_card_toFinset]
+      simp
+    have hcard2 : Nat.card (setOfList ul2) = ul2.toFinset.card := by
+      rw [hseteq, Nat.card_eq_card_toFinset]
+      simp
+    have hcardEq : ul.toFinset.card = ul2.toFinset.card := by
+      rw [← hcard, ← hcard2, hset]
+    have hle2 : ul2.toFinset.card ≤ ul2.length := List.toFinset_card_le ul2
+    rw [hlen2] at hle2
+    omega
+  rcases lt_or_gt_of_ne hij with hlt | hlt'
+  · exact key i j hlt hj hcon
+  · exact key j i hlt' hi hcon.symm
+
+/-- pack3.hl:1380 `p2e_LENGTH_LEFT_ACTION_LIST`. -/
+private theorem p2e_LENGTH_LEFT_ACTION_LIST (ul : List V3) (p : Equiv.Perm ℕ) :
+    (leftActionList p ul).length = ul.length := by
+  simp [leftActionList]
+
+/-- pack3.hl:1408 `p2e_MEM_LEFT_ACTION_LIST`. -/
+private theorem p2e_MEM_LEFT_ACTION_LIST (ul : List V3) (p : Equiv.Perm ℕ)
+    (hp : permutes p {i : ℕ | i < ul.length}) (x : V3) :
+    x ∈ leftActionList p ul ↔ x ∈ ul := by
+  rw [leftActionList, List.mem_map]
+  constructor
+  · rintro ⟨j, hj, rfl⟩
+    have hj' : p.symm j < ul.length :=
+      (hp (p.symm j)).2 (by simpa using hj)
+    rw [List.getD_eq_getElem _ _ hj']
+    exact List.getElem_mem hj'
+  · intro hx
+    obtain ⟨k, hk, rfl⟩ := List.mem_iff_getElem.1 hx
+    exact ⟨p k, List.mem_range.2 ((hp k).1 hk), by
+      rw [Equiv.symm_apply_apply, List.getD_eq_getElem _ _ hk]⟩
+
+/-- pack3.hl:1440 `p2e_SET_OF_LIST_LEFT_ACTION_LIST`. -/
+private theorem p2e_SET_OF_LIST_LEFT_ACTION_LIST (ul : List V3) (p : Equiv.Perm ℕ)
+    (hp : permutes p {i : ℕ | i < ul.length}) :
+    setOfList (leftActionList p ul) = setOfList ul := by
+  ext x
+  exact p2e_MEM_LEFT_ACTION_LIST ul p hp x
+
+
+/-- `affDim` of a nondegenerate bisector is `2`. -/
+private theorem p2e_p7_affDim_bis_pair {u0 u1 : V3} (hne : u0 ≠ u1) :
+    affDim (p2e_bis u0 u1) = 2 := by
+  have hsub : u1 - u0 ≠ 0 := sub_ne_zero.mpr (Ne.symm hne)
+  rw [p2e_BIS_EQ_HYPERPLANE]
+  have heq : {x : V3 | 2 * ((u1 - u0) ⬝ᵥ x) = u1 ⬝ᵥ u1 - u0 ⬝ᵥ u0} =
+      {x : V3 | (u1 - u0) ⬝ᵥ x = (u1 ⬝ᵥ u1 - u0 ⬝ᵥ u0) / 2} := by
+    ext x
+    simp only [Set.mem_setOf_eq]
+    constructor <;> intro h <;> linarith
+  rw [heq]
+  exact affDim_hyperplane hsub _
+
+
+/-- Two distinct points give a 2-element set. -/
+private theorem p2e_p7_card2_of_distinct {a b : V3} (h : a ≠ b) :
+    Nat.card ({a, b} : Set V3) = 2 := by
+  have e1 : ({a, b} : Set V3).ncard = ({b} : Set V3).ncard + 1 :=
+    Set.ncard_insert_of_notMem (by simp [h])
+  have e2 : ({b} : Set V3).ncard = 1 := Set.ncard_singleton b
+  have he : Nat.card ({a, b} : Set V3) = ({a, b} : Set V3).ncard := rfl
+  omega
+
+
+/-- The bisector family over a pair collapses to the one nontrivial
+bisector (`p2e_bis u u = univ`). -/
+private theorem p2e_p7_inters_bis_pair (u v : V3) :
+    ⋂₀ {p2e_bis u w | w ∈ ({u, v} : Set V3)} = p2e_bis u v := by
+  ext q
+  rw [Set.mem_sInter]
+  constructor
+  · intro h
+    exact h (p2e_bis u v) ⟨v, by simp, rfl⟩
+  · intro h T hT
+    rw [Set.mem_setOf_eq] at hT
+    obtain ⟨w, hw, rfl⟩ := hT
+    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hw
+    rcases hw with hwu | hwv
+    · rw [hwu]
+      show dist q u = dist q u
+      rfl
+    · rw [hwv]
+      exact h
+
+
+/-- The coe family on a set has the set as its range. -/
+private theorem p2e_p7_range_coe {S : Set V3} :
+    Set.range (fun x : ↥S => (x : V3)) = S := by
+  ext y
+  constructor
+  · rintro ⟨x, rfl⟩; exact x.2
+  · intro hy; exact ⟨⟨y, hy⟩, rfl⟩
+
+
+/-- `affDim (voronoiList V [a, b]) = 2` for a distinct pair below the
+`sqrt 2` margin. -/
+private theorem p2e_p7_affDim_voronoiList_pair (V : Set V3) (a b : V3)
+    (hp : Packing V) (ha : a ∈ V) (hb : b ∈ V) (hne : a ≠ b)
+    (hhl : hl [a, b] < Real.sqrt 2) :
+    affDim (voronoiList V [a, b]) = 2 := by
+  have hsub : setOfList [a, b] ⊆ V := by
+    intro x hx
+    rcases List.mem_cons.mp hx with rfl | hx
+    · exact ha
+    rcases List.mem_cons.mp hx with rfl | hx
+    · exact hb
+    exact absurd hx (by simp)
+  have hpair : setOfList [a, b] = ({a, b} : Set V3) := by
+    ext x; simp [setOfList]
+  have hind : ¬ affineDependent (setOfList [a, b]) := by
+    rw [affineDependent, not_not, hpair]
+    have hfin : ({a, b} : Set V3).Finite := Set.Finite.insert _ (Set.finite_singleton b)
+    haveI : Fintype ↥({a, b} : Set V3) := hfin.fintype
+    have hcard : Fintype.card ↥({a, b} : Set V3) = 0 + 2 := by
+      have hn : Nat.card ({a, b} : Set V3) = 2 := p2e_p7_card2_of_distinct hne
+      rw [Nat.card_eq_fintype_card] at hn
+      omega
+    rw [affineIndependent_iff_not_finrank_vectorSpan_le ℝ
+      (fun x : ↥({a, b} : Set V3) => (x : V3)) hcard, p2e_p7_range_coe,
+      vectorSpan_pair, finrank_span_singleton
+        (show (a -ᵥ b : V3) ≠ 0 from sub_ne_zero.mpr hne)]
+    norm_num
+  have hdim := p2e_YIFVQDV_lemma_aff_dim V [a, b] hp hsub hind hhl
+  rw [hdim]
+  have hhd : hdV [a, b] = a := rfl
+  have hinter : (⋂₀ {p2e_bis (hdV [a, b]) v | v ∈ setOfList [a, b]}) = p2e_bis a b := by
+    rw [hhd, hpair]
+    exact p2e_p7_inters_bis_pair a b
+  rw [hinter]
+  exact p2e_p7_affDim_bis_pair hne
+
+
+/-- The inner-product functional on `V3` (the `p2e_p15_dotR` pattern). -/
+private noncomputable def p2e_p7_dotR (a : V3) : V3 →ₗ[ℝ] ℝ where
+  toFun x := inner ℝ a x
+  map_add' x y := inner_add_right a x y
+  map_smul' r x := real_inner_smul_right a x r
+
+
+/-- A bisector is the carrier of the affine subspace through the midpoint
+with direction the kernel of the inner-product functional. -/
+private theorem p2e_p7_bis_mk' (a b : V3) :
+    (AffineSubspace.mk' ((2⁻¹ : ℝ) • (a + b))
+        (LinearMap.ker (p2e_p7_dotR (b - a))) : Set V3) = p2e_bis a b := by
+  ext x
+  rw [SetLike.mem_coe, AffineSubspace.mem_mk', LinearMap.mem_ker]
+  show inner ℝ (b - a) (x - (2⁻¹ : ℝ) • (a + b)) = 0 ↔ dist x a = dist x b
+  have hsqinj : ‖x - a‖ = ‖x - b‖ ↔ ‖x - a‖ ^ 2 = ‖x - b‖ ^ 2 := by
+    constructor
+    · intro hh; rw [hh]
+    · intro hh
+      have hA : 0 ≤ ‖x - a‖ := norm_nonneg _
+      have hB : 0 ≤ ‖x - b‖ := norm_nonneg _
+      have hmul : (‖x - a‖ + ‖x - b‖) * (‖x - a‖ - ‖x - b‖) = 0 := by
+        have key : ‖x - a‖ * ‖x - a‖ - ‖x - b‖ * ‖x - b‖ = 0 := by
+          rw [← pow_two, ← pow_two, hh, sub_self]
+        nlinarith [key]
+      rcases mul_eq_zero.1 hmul with h | h
+      · linarith
+      · linarith
+  rw [inner_sub_right, real_inner_smul_right, dist_eq_norm, dist_eq_norm, hsqinj,
+    norm_sub_sq_real x a, norm_sub_sq_real x b]
+  have hL : inner ℝ (b - a) x = inner ℝ b x - inner ℝ a x := inner_sub_left b a x
+  have hE : inner ℝ (b - a) (a + b) = ‖b‖ ^ 2 - ‖a‖ ^ 2 := by
+    rw [inner_add_right, inner_sub_left, inner_sub_left, real_inner_comm b a,
+      real_inner_self_eq_norm_sq a, real_inner_self_eq_norm_sq b]
+    ring
+  rw [hL, hE]
+  constructor <;> intro h
+  · linarith [real_inner_comm x a, real_inner_comm x b]
+  · linarith [real_inner_comm x a, real_inner_comm x b]
+
+
+/-- Three pairwise-distinct points give a 3-element set. -/
+private theorem p2e_p7_card3_of_distinct {a b c : V3} (h1 : a ≠ b) (h2 : a ≠ c)
+    (h3 : b ≠ c) : Nat.card ({a, b, c} : Set V3) = 3 := by
+  have e1 : ({a, b, c} : Set V3).ncard = ({b, c} : Set V3).ncard + 1 :=
+    Set.ncard_insert_of_notMem (by simp; tauto)
+  have e2 : ({b, c} : Set V3).ncard = ({c} : Set V3).ncard + 1 :=
+    Set.ncard_insert_of_notMem (by simp; tauto)
+  have e3 : ({c} : Set V3).ncard = 1 := Set.ncard_singleton c
+  have he : Nat.card ({a, b, c} : Set V3) = ({a, b, c} : Set V3).ncard := rfl
+  omega
+
+
+/-- For `a ≠ 0` the kernel of the inner-product functional has finrank `2`. -/
+private theorem p2e_p7_finrank_ker_dot {a : V3} (ha : a ≠ 0) :
+    Module.finrank ℝ (LinearMap.ker (p2e_p7_dotR a)) = 2 := by
+  have hDpos : (0:ℝ) < p2e_p7_dotR a a := by
+    show 0 < inner ℝ a a
+    rw [real_inner_self_eq_norm_sq]
+    exact pow_pos (norm_pos_iff.mpr ha) 2
+  have hrange_ne : LinearMap.range (p2e_p7_dotR a) ≠ ⊥ := by
+    intro hbot
+    have hx : p2e_p7_dotR a a ∈ LinearMap.range (p2e_p7_dotR a) := ⟨a, rfl⟩
+    rw [hbot] at hx
+    exact hDpos.ne' (Submodule.mem_bot (R := ℝ) |>.mp hx)
+  have hnk := LinearMap.finrank_range_add_finrank_ker (p2e_p7_dotR a)
+  have h3 : Module.finrank ℝ V3 = 3 := finrank_euclideanSpace_fin
+  rw [h3] at hnk
+  have hfrle : Module.finrank ℝ (LinearMap.range (p2e_p7_dotR a)) ≤ 1 := by
+    refine le_trans (Submodule.finrank_mono (le_top : LinearMap.range (p2e_p7_dotR a) ≤ _)) ?_
+    simp
+  have hfrne : Module.finrank ℝ (LinearMap.range (p2e_p7_dotR a)) ≠ 0 := by
+    intro h
+    apply hrange_ne
+    exact (Submodule.finrank_eq_zero).mp h
+  omega
+
+
+/-- The vector span of a three-point set is the span of the two differences
+off the first point. -/
+private theorem p2e_p7_vectorSpan_triple (x y z : V3) :
+    vectorSpan ℝ ({x, y, z} : Set V3) = Submodule.span ℝ ({y - x, z - x} : Set V3) := by
+  rw [vectorSpan_eq_span_vsub_set_right ℝ (show x ∈ ({x, y, z} : Set V3) from by simp)]
+  apply le_antisymm
+  · rw [Submodule.span_le]
+    rintro q ⟨p, hp, rfl⟩
+    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hp
+    rcases hp with rfl | rfl | rfl
+    · simp
+    · exact Submodule.subset_span (by simp)
+    · exact Submodule.subset_span (by simp)
+  · rw [Submodule.span_le]
+    rintro q (rfl | rfl)
+    · exact Submodule.subset_span ⟨y, by simp, rfl⟩
+    · exact Submodule.subset_span ⟨z, by simp, rfl⟩
+
+
+/-- Three pairwise distinct, non-collinear points: the two bisectors `p2e_bis u v`
+and `p2e_bis u w` meet in a line, `affDim = 1`. -/
+private theorem p2e_p7_affDim_bis2 {u v w : V3} (huv : u ≠ v) (huw : u ≠ w)
+    (hvw : v ≠ w) (hnc : Module.finrank ℝ (vectorSpan ℝ ({u, v, w} : Set V3)) = 2) :
+    affDim (p2e_bis u v ∩ p2e_bis u w) = 1 := by
+  classical
+  have hcard3 : Nat.card ({u, v, w} : Set V3) = 3 :=
+    p2e_p7_card3_of_distinct huv huw hvw
+  have hind3 : ¬ affineDependent ({u, v, w} : Set V3) := by
+    rw [affineDependent, not_not]
+    have hfin : ({u, v, w} : Set V3).Finite :=
+      Set.Finite.insert _ (Set.Finite.insert _ (Set.finite_singleton w))
+    haveI : Fintype ↥({u, v, w} : Set V3) := hfin.fintype
+    have hcf : Fintype.card ↥({u, v, w} : Set V3) = 1 + 2 := by
+      rw [← Nat.card_eq_fintype_card]
+      exact hcard3
+    rw [affineIndependent_iff_not_finrank_vectorSpan_le ℝ
+      (fun x : ↥({u, v, w} : Set V3) => (x : V3)) hcf, p2e_p7_range_coe, hnc]
+    norm_num
+  -- nonempty: the triple circumcenter is equidistant from all three points
+  have d0 := OAPVION2_concl ({u, v, w} : Set V3) hind3 u (by simp)
+  have d1 := OAPVION2_concl ({u, v, w} : Set V3) hind3 v (by simp)
+  have d2 := OAPVION2_concl ({u, v, w} : Set V3) hind3 w (by simp)
+  have hc0 : circumcenter ({u, v, w} : Set V3) ∈ p2e_bis u v ∩ p2e_bis u w := by
+    constructor
+    · show dist (circumcenter ({u, v, w} : Set V3)) u =
+        dist (circumcenter ({u, v, w} : Set V3)) v
+      linarith
+    · show dist (circumcenter ({u, v, w} : Set V3)) u =
+        dist (circumcenter ({u, v, w} : Set V3)) w
+      linarith
+  have hne2 : (p2e_bis u v ∩ p2e_bis u w : Set V3).Nonempty := ⟨_, hc0⟩
+  have hK1 : (AffineSubspace.mk' ((2⁻¹ : ℝ) • (u + v))
+      (LinearMap.ker (p2e_p7_dotR (v - u))) : Set V3) = p2e_bis u v := p2e_p7_bis_mk' u v
+  have hK2 : (AffineSubspace.mk' ((2⁻¹ : ℝ) • (u + w))
+      (LinearMap.ker (p2e_p7_dotR (w - u))) : Set V3) = p2e_bis u w := p2e_p7_bis_mk' u w
+  have hdir1 : (AffineSubspace.mk' ((2⁻¹ : ℝ) • (u + v))
+      (LinearMap.ker (p2e_p7_dotR (v - u)))).direction =
+      LinearMap.ker (p2e_p7_dotR (v - u)) := AffineSubspace.direction_mk' _ _
+  have hdir2 : (AffineSubspace.mk' ((2⁻¹ : ℝ) • (u + w))
+      (LinearMap.ker (p2e_p7_dotR (w - u)))).direction =
+      LinearMap.ker (p2e_p7_dotR (w - u)) := AffineSubspace.direction_mk' _ _
+  have hc0mem : circumcenter ({u, v, w} : Set V3) ∈
+      ↑(AffineSubspace.mk' ((2⁻¹ : ℝ) • (u + v)) (LinearMap.ker (p2e_p7_dotR (v - u))) ⊓
+        AffineSubspace.mk' ((2⁻¹ : ℝ) • (u + w)) (LinearMap.ker (p2e_p7_dotR (w - u)))) := by
+    rw [AffineSubspace.mem_inf_iff]
+    refine ⟨?_, ?_⟩
+    · have h' : circumcenter ({u, v, w} : Set V3) ∈ p2e_bis u v := hc0.1
+      rwa [← hK1] at h'
+    · have h' : circumcenter ({u, v, w} : Set V3) ∈ p2e_bis u w := hc0.2
+      rwa [← hK2] at h'
+  have hcarrier : (p2e_bis u v ∩ p2e_bis u w : Set V3) =
+      ↑(AffineSubspace.mk' ((2⁻¹ : ℝ) • (u + v)) (LinearMap.ker (p2e_p7_dotR (v - u))) ⊓
+        AffineSubspace.mk' ((2⁻¹ : ℝ) • (u + w)) (LinearMap.ker (p2e_p7_dotR (w - u)))) := by
+    rw [← hK1, ← hK2, ← AffineSubspace.coe_inf]
+    rfl
+  have hdirEq : (AffineSubspace.mk' ((2⁻¹ : ℝ) • (u + v))
+      (LinearMap.ker (p2e_p7_dotR (v - u))) ⊓
+      AffineSubspace.mk' ((2⁻¹ : ℝ) • (u + w))
+      (LinearMap.ker (p2e_p7_dotR (w - u)))).direction =
+      LinearMap.ker (p2e_p7_dotR (v - u)) ⊓ LinearMap.ker (p2e_p7_dotR (w - u)) := by
+    rw [AffineSubspace.direction_inf_of_mem_inf hc0mem, hdir1, hdir2]
+  rw [affDim, if_neg (Set.nonempty_iff_ne_empty.mp hne2), hcarrier,
+    ← AffineSubspace.direction_eq_vectorSpan, hdirEq]
+  have h2K : Module.finrank ℝ (LinearMap.ker (p2e_p7_dotR (v - u))) = 2 :=
+    p2e_p7_finrank_ker_dot (a := v - u) (sub_ne_zero.mpr (Ne.symm huv))
+  have h2K' : Module.finrank ℝ (LinearMap.ker (p2e_p7_dotR (w - u))) = 2 :=
+    p2e_p7_finrank_ker_dot (a := w - u) (sub_ne_zero.mpr (Ne.symm huw))
+  have hspanspan : Submodule.span ℝ ({v - u, w - u} : Set V3) =
+      vectorSpan ℝ ({u, v, w} : Set V3) := (p2e_p7_vectorSpan_triple u v w).symm
+  -- upper bound: the kernel intersection sits in the orthogonal complement
+  have hle : LinearMap.ker (p2e_p7_dotR (v - u)) ⊓
+      LinearMap.ker (p2e_p7_dotR (w - u)) ≤
+      (Submodule.span ℝ ({v - u, w - u} : Set V3))ᗮ := by
+    intro q hq
+    rw [Submodule.mem_orthogonal]
+    intro y hy
+    rw [Submodule.mem_span_pair] at hy
+    obtain ⟨a, b, hb⟩ := hy
+    have hq1 : inner ℝ (v - u) q = 0 := LinearMap.mem_ker.mp (Submodule.mem_inf.mp hq).1
+    have hq2 : inner ℝ (w - u) q = 0 := LinearMap.mem_ker.mp (Submodule.mem_inf.mp hq).2
+    rw [← hb, inner_add_left, real_inner_smul_left, real_inner_smul_left, hq1, hq2]
+    ring
+  have hleFr : Module.finrank ℝ ↥(LinearMap.ker (p2e_p7_dotR (v - u)) ⊓
+      LinearMap.ker (p2e_p7_dotR (w - u))) ≤
+      Module.finrank ℝ ↥((Submodule.span ℝ ({v - u, w - u} : Set V3))ᗮ) :=
+    Submodule.finrank_mono hle
+  have horthrank : Module.finrank ℝ
+      ((Submodule.span ℝ ({v - u, w - u} : Set V3))ᗮ) = 1 := by
+    have h := Submodule.finrank_add_finrank_orthogonal
+      (Submodule.span ℝ ({v - u, w - u} : Set V3))
+    have h3 : Module.finrank ℝ V3 = 3 := finrank_euclideanSpace_fin
+    rw [hspanspan, hnc] at h
+    rw [hspanspan]
+    omega
+  -- lower bound: submodularity of finrank
+  have hsubmod := Submodule.finrank_sup_add_finrank_inf_eq
+    (LinearMap.ker (p2e_p7_dotR (v - u))) (LinearMap.ker (p2e_p7_dotR (w - u)))
+  have htop : Module.finrank ℝ ↥(LinearMap.ker (p2e_p7_dotR (v - u)) ⊔
+      LinearMap.ker (p2e_p7_dotR (w - u))) ≤ 3 := by
+    refine le_trans (Submodule.finrank_mono (le_top : _ ≤ ⊤)) ?_
+    rw [finrank_top]
+    exact (finrank_euclideanSpace_fin).le
+  rw [h2K, h2K'] at hsubmod
+  rw [horthrank] at hleFr
+  omega
+
