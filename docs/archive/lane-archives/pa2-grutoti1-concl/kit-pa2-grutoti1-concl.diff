+/-- pack3.hl:2423 `p2e_OMEGA_LIST_N_LEMMA`. `omega_list_n` only reads the first
+`k + 1` entries of the list: induction on `k`, using the truncation algebra
+`p2e_TRUNCATE_TRUNCATE_SIMPLEX` and `p2e_HD_TRUNCATE_SIMPLEX`. -/
+private theorem p2e_OMEGA_LIST_N_LEMMA (V : Set V3) (ul : List V3) (k i : ℕ)
+    (h : k + i + 1 ≤ ul.length) :
+    omegaListN V ul k = omegaListN V (truncateSimplex (k + i) ul) k := by
+  induction k generalizing i with
+  | zero =>
+    simp only [Nat.zero_add]
+    exact (p2e_HD_TRUNCATE_SIMPLEX ul i (by omega)).symm
+  | succ k ih =>
+    have h' : k + (i + 1) + 1 ≤ ul.length := by omega
+    have h2 := ih (i + 1) h'
+    have hshift : k + (i + 1) = k + 1 + i := by omega
+    rw [hshift] at h2
+    have htt := p2e_TRUNCATE_TRUNCATE_SIMPLEX ul (k + 1) (k + 1 + i) (by omega) (by omega)
+    show closestPoint (voronoiList V (truncateSimplex (k + 1) ul)) (omegaListN V ul k) =
+      closestPoint (voronoiList V (truncateSimplex (k + 1) (truncateSimplex (k + 1 + i) ul)))
+        (omegaListN V (truncateSimplex (k + 1 + i) ul) k)
+    rw [htt, h2]
+
+/-- pack3.hl:2441 `p2e_OMEGA_LIST_LEMMA`. -/
+private theorem p2e_OMEGA_LIST_LEMMA (V : Set V3) (ul : List V3) (k : ℕ) (h : k + 1 ≤ ul.length) :
+    omegaList V (truncateSimplex k ul) = omegaListN V ul k := by
+  have hlen : (truncateSimplex k ul).length = k + 1 := p2e_LENGTH_TRUNCATE_SIMPLEX k ul h
+  have h1 : omegaList V (truncateSimplex k ul)
+      = omegaListN V (truncateSimplex k ul) ((truncateSimplex k ul).length - 1) := rfl
+  rw [h1, hlen]
+  have h2 := p2e_OMEGA_LIST_N_LEMMA V ul k 0 (by omega)
+  simpa using h2.symm
+
+
+/-- Rogers.hl:1551 `p2e_SET_OF_LIST_TRUNCATE_SIMPLEX_SUBSET`. (V3-typed kit.) -/
+private theorem p2e_SET_OF_LIST_TRUNCATE_SIMPLEX_SUBSET (ul : List V3) (k : ℕ)
+    (h : k + 1 ≤ ul.length) : setOfList (truncateSimplex k ul) ⊆ setOfList ul :=
+  p2e_SET_OF_LIST_INITIAL_SUBLIST_SUBSET
+    ((p2e_TRUNCATE_SIMPLEX_INITIAL_SUBLIST k (truncateSimplex k ul) ul).mp ⟨rfl, h⟩).1
