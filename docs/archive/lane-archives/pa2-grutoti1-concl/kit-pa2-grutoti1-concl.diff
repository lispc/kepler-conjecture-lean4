+/-- HOL `p2e_RCONE_GT_SUBSET_RCONE_GE` (marchal2.hl:255). -/
+private theorem p2e_RCONE_GT_SUBSET_RCONE_GE (z w : V3) (h : ℝ) :
+    rconeGt z w h ⊆ rconeGe z w h := by
+  intro x hx
+  simp only [rconeGt, Set.mem_setOf_eq] at hx
+  simp only [rconeGe, Set.mem_setOf_eq]
+  exact le_of_lt hx
