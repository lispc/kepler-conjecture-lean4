+/-- HL `p2e_OMEGA_LIST_N_IN_CONVEX_HULL` (Rogers.hl:7869). -/
+private theorem p2e_OMEGA_LIST_N_IN_CONVEX_HULL (V : Set V3) (ul : List V3) (k i : ℕ)
+    (hV : Packing V) (hb : barV V k ul) (hik : i ≤ k)
+    (hl2 : hl ul < Real.sqrt 2) :
+    omegaListN V ul i ∈ convexHull ℝ (setOfList ul) := by
+  have hblen : ul.length = k + 1 := hb.1
+  have hbvl : barV V i (truncateSimplex i ul) := p2e_TRUNCATE_SIMPLEX_BARV V i k ul hb hik
+  have heq : omegaListN V ul i = omegaList V (truncateSimplex i ul) :=
+    (p2e_OMEGA_LIST_LEMMA V ul i (by rw [hblen]; omega)).symm
+  rw [heq]
+  have hl2i : hl (truncateSimplex i ul) < Real.sqrt 2 :=
+    lt_of_le_of_lt (p2e_HL_DECREASE V ul k i hV hb hik) hl2
+  have hsub : setOfList (truncateSimplex i ul) ⊆ setOfList ul :=
+    p2e_SET_OF_LIST_TRUNCATE_SIMPLEX_SUBSET ul i (by rw [hblen]; omega)
+  exact convexHull_mono hsub (p2e_XNHPWAB2 V (truncateSimplex i ul) i hV hbvl hl2i)
