+      Submodule.subset_span (Set.mem_vsub.2 ⟨z1, hz1S, z2, hz2S, by
+        show z1 -ᵥ z2 = w1 - w2
+        rw [vsub_eq_sub, hz1def, hz2def]
+        abel⟩)
