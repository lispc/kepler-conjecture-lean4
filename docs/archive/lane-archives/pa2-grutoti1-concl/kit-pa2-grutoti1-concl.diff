+private theorem p2e_p14_omega1_mid {V : Set V3} {a b c d : V3} (hp : Packing V)
+    (hb : barV V 3 [a, b, c, d]) (hhl : hl [a, b] < Real.sqrt 2) :
+    omegaListN V [a, b, c, d] 1 = midpoint ℝ a b := by
+  have hb1 : barV V 1 [a, b] := by
+    simpa using p2e_BARV_INITIAL_SUBLIST V 3 [a, b, c, d] [a, b] hb
+      (p2e_INITIAL_SUBLIST_APPEND [a, b] [c, d]) (by simp)
+  rw [p2e_OMEGA_LIST_TRUNCATE_1, p2e_XNHPWAB1 V [a, b] 1 hp hb1 hhl,
+    show setOfList [a, b] = ({a, b} : Set V3) from by ext x; simp [setOfList],
+    p2e_CIRCUMCENTER_2]
+
+
+private theorem p2e_p14_omega2_cc {V : Set V3} {a b c d : V3} (hp : Packing V)
+    (hb : barV V 3 [a, b, c, d]) (hhl : hl [a, b, c] < Real.sqrt 2) :
+    omegaListN V [a, b, c, d] 2 = circumcenter ({a, b, c} : Set V3) := by
+  have hb2 : barV V 2 [a, b, c] := by
+    simpa using p2e_BARV_INITIAL_SUBLIST V 3 [a, b, c, d] [a, b, c] hb
+      (p2e_INITIAL_SUBLIST_APPEND [a, b, c] [d]) (by simp)
+  rw [p2e_OMEGA_LIST_TRUNCATE_2, p2e_XNHPWAB1 V [a, b, c] 2 hp hb2 hhl,
+    show setOfList [a, b, c] = ({a, b, c} : Set V3) from by ext x; simp [setOfList]]
+
+-- range of a vector
+example (u0 u1 u2 : V3) : Set.range ![u0, u1, u2] = ({u0, u1, u2} : Set V3) := by
+  ext x; simp; tauto
+
+example (u0 u1 u2 u3 : V3) :
+    Set.range ![u0, u1, u2, u3] = ({u0, u1, u2, u3} : Set V3) := by
+  ext x; simp; tauto
