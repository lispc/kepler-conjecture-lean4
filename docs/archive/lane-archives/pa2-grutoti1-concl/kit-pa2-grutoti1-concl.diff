+/-- HOL `VOLUME_CONIC_CAP`（flyspeck_multivariate.ml:5057，GT-1 交付件 1）：
+锥帽可测 + 体积公式。使用点锚：GRUTOTI.hl:3356-3358/7983-7985（§I 正性）、
+PA24:422-433（REUHADY）、TSKAJXY3.hl:1959（STRONG 版另配 bounded/convex）。
+集合常数为 `p2e_ccvConicCap` 私拷（文件头桥接说明；与 PA15/PA24/PA23 各 p2e_conicCap
+同体，消费 lane 一行 `rfl` 转移）。 -/
+private theorem p2e_volumeConicCap (v0 v1 : V3) (r a : ℝ) (ha : 0 < a) :
+    MeasurableSet (p2e_ccvConicCap v0 v1 r a) ∧
+      volume.real (p2e_ccvConicCap v0 v1 r a) =
+        if v1 = v0 ∨ 1 ≤ a ∨ r < 0 then 0
+        else 2 / 3 * Real.pi * (1 - a) * r ^ 3 := by
+  refine ⟨p2e_measurableConicCap v0 v1 r a, ?_⟩
+  rcases eq_or_ne v1 v0 with heq | hne
+  · rw [heq, p2e_ccv_conicCap_empty]
+    rw [Measure.real_def, measure_empty, ENNReal.toReal_zero]
+    rw [if_pos (by simp)]
+  · by_cases hage : 1 ≤ a
+    · have hE : p2e_ccvConicCap 0 (v1 - v0) r a = ∅ := by
+        rw [p2e_ccvConicCap, p2e_ccv_cone_empty_of_ge 0 (v1 - v0) a hage, Set.inter_empty]
+      rw [p2e_ccv_conicCap_add_left, hE, Set.image_empty]
+      rw [Measure.real_def, measure_empty, ENNReal.toReal_zero]
+      rw [if_pos (by exact Or.inr (Or.inl hage))]
+    · by_cases hrneg : r < 0
+      · have hempty : p2e_ccvConicCap v0 v1 r a = ∅ := by
+          ext x
+          simp only [p2e_ccvConicCap, Metric.mem_closedBall, Set.mem_inter_iff,
+            Set.mem_empty_iff_false, iff_false]
+          intro h
+          have hd := dist_nonneg (x := x) (y := v0)
+          linarith
+        rw [hempty, Measure.real_def, measure_empty, ENNReal.toReal_zero]
+        rw [if_pos (by exact Or.inr (Or.inr hrneg))]
+      · have hnc : ¬(v1 = v0 ∨ 1 ≤ a ∨ r < 0) := by
+          rintro (h | h | h)
+          · exact hne h
+          · exact hage h
+          · exact hrneg h
+        have ha1 : a < 1 := lt_of_not_ge hage
+        have hr0 : 0 ≤ r := not_lt.mp hrneg
+        rw [if_neg hnc]
+        rcases eq_or_lt_of_le hr0 with hreq | hrpos
+        · have hempty : p2e_ccvConicCap v0 v1 r a = ∅ := by
+            subst hreq
+            ext x
+            simp only [p2e_ccvConicCap, Metric.mem_closedBall, p2e_ccv_mem_cone,
+              Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false]
+            rintro ⟨hball, hcone⟩
+            have hx0 : x = v0 := by
+              have h2 : dist x v0 ≤ 0 := hball
+              have h3 : 0 ≤ dist x v0 := dist_nonneg
+              have h4 : dist x v0 = 0 := by linarith
+              exact dist_eq_zero.mp h4
+            rw [hx0] at hcone
+            simp only [sub_self, WithLp.ofLp_zero, zero_dotProduct, dist_self,
+              zero_mul] at hcone
+            linarith
+          rw [hempty, ← hreq, Measure.real_def, measure_empty, ENNReal.toReal_zero]
+          ring
+        · rw [p2e_ccv_conicCap_add_left, volume_real_add_left]
+          have hvol := p2e_ccv_volume_conicCap_zero r a ha ha1 hrpos
+            (sub_ne_zero.mpr hne)
+          rw [Measure.real_def, hvol, ENNReal.toReal_ofReal (by positivity)]
+
+
+/-- GT-1 交付件 1 之正性（GRUTOTI §I 锚：GRUTOTI.hl:7983-7985；
+PA23:315 `grutoti_volD_pos` 的共享版，按 PA23:307-314 诚实注记补 `hne`）。 -/
+private theorem p2e_volumeConicCapPos {v0 v1 : V3} {r d : ℝ} (hr : 0 < r) (hd : 0 < d) (hd1 : d < 1)
+    (hne : v0 ≠ v1) : 0 < volume.real (p2e_ccvConicCap v0 v1 r d) := by
+  have h := p2e_volumeConicCap v0 v1 r d hd
+  have hnc : ¬(v1 = v0 ∨ 1 ≤ d ∨ r < 0) := by
+    rintro (h0 | h0 | h0)
+    · exact hne h0.symm
+    · exact absurd h0 (by linarith)
+    · exact absurd h0 (by linarith)
+  rw [h.2, if_neg hnc]
+  positivity
+
