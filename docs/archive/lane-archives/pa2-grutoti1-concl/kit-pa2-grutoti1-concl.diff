+/-- HL GRUTOTI.hl:7322-7324 analogue: the cap is inside the radius-1 open
+ball once `r < 1`. -/
+private theorem grutoti_cap_subset_ball (u0 u1 : V3) (r d : ℝ) (hr : r < 1) :
+    grutotiConicCap u0 u1 r d ⊆ Metric.ball u0 1 :=
