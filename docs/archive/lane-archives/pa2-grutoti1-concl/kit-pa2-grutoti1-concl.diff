+/-- pack3.hl:2355 `p2e_POLYTOPE_VORONOI_LIST_BARV`. -/
+private theorem p2e_POLYTOPE_VORONOI_LIST_BARV (V : Set V3) (ul : List V3) (k : ℕ) (hV : Packing V)
+    (hs : saturated V) (hbar : barV V k ul) : polytope (voronoiList V ul) := by
+  have hbl := hbar.1
+  exact p2e_POLYTOPE_VORONOI_LIST V ul hV hs (p2e_BARV_SUBSET V k ul hbar) (by
+    intro h0
+    simp [h0] at hbl)
