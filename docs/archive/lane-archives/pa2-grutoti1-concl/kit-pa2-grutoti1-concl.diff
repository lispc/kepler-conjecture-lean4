+/-- An affine span of three points is null. -/
+private theorem p2e_p13_nullset_affineSpan_triple (a b c : V3) :
+    nullSet (affineSpan ℝ ({a, b, c} : Set V3)) :=
+  p2e_p13_coplanar_null ⟨a, b, c, subset_rfl⟩ subset_rfl
