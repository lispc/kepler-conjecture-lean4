+      simp only [Set.sdiff_empty]
+      rw [hrogers, hHD]
+  · -- ===================== k = 2 =====================
+    obtain ⟨u0, u1, u2, u3, rfl⟩ := p2e_BARV_3_EXPLICIT V ul hb1
+    obtain ⟨v0, v1, v2, v3, rfl⟩ := p2e_BARV_3_EXPLICIT V vl hb2
+    have hcond : hl (truncateSimplex 1 [u0, u1, u2, u3]) < Real.sqrt 2 ∧
+        Real.sqrt 2 ≤ hl [u0, u1, u2, u3] := by
+      by_contra h
+      have hempty : mcell2 V [u0, u1, u2, u3] = ∅ := by rw [mcell2, if_neg h]
+      rw [(p2e_MCELL_EXPLICIT 2 V [u0, u1, u2, u3]).2.2.1, hempty] at hne
