+/-- the head of a family list is `u0` -/
+private theorem p23_hdV_eq_u0 {V : Set V3} {u0 u1 : V3} {vl : List V3}
+    (hvl : vl ∈ p23Fam V u0 u1) : hdV vl = u0 := by
