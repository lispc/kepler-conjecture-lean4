+    constructor
+    · rintro ⟨j, hj, rfl⟩
+      rw [h4] at hj
+      interval_cases j
+      · simp [hdV, omegaListN]
+      · simp
+      · simp
+      · simp
+    · rintro (rfl | rfl | rfl | rfl)
+      · exact ⟨0, by omega, rfl⟩
+      · exact ⟨1, by omega, rfl⟩
+      · exact ⟨2, by omega, rfl⟩
+      · exact ⟨3, by omega, rfl⟩
+  rw [rogers, hset]
