+    have hm : mcell 2 V ul = mcell2 V ul := (p2e_MCELL_EXPLICIT 2 V ul).2.2.1
+    rw [hm, mcell2] at hne
+    have hcond : hl (truncateSimplex 1 ul) < Real.sqrt 2 ∧
+        Real.sqrt 2 ≤ hl ul := by
+      by_contra hc
+      rw [if_neg hc] at hne
+      exact hne rfl
+    have hperm' : permutes p ({0, 1} : Set ℕ) := by
+      intro x
+      have hx := hperm x
+      simp only [Set.mem_Icc, Set.mem_insert_iff, Set.mem_singleton_iff] at hx ⊢
+      omega
+    have hfix' : ∀ j : ℕ, 2 ≤ j → p j = j := fun j hj => hfix j (by omega)
+    exact (p2e_LEFT_ACTION_LIST_1_PROPERTIES_ALT V ul (leftActionList p ul) p hpack hsat
+      hbar hperm' hfix' hcond.1 hcond.2 rfl).1
+  · -- k = 3: the S₃ left-action kit
+    have hm : mcell 3 V ul = mcell3 V ul := (p2e_MCELL_EXPLICIT 3 V ul).2.2.2.1
+    rw [hm, mcell3] at hne
+    have hcond : hl (truncateSimplex 2 ul) < Real.sqrt 2 ∧
+        Real.sqrt 2 ≤ hl ul := by
+      by_contra hc
+      rw [if_neg hc] at hne
+      exact hne rfl
+    have hperm' : permutes p (Set.Icc 0 2) := by simpa using hperm
+    have hfix' : ∀ j : ℕ, 3 ≤ j → p j = j := fun j hj => hfix j (by omega)
+    exact (p2e_LEFT_ACTION_LIST_PROPERTIES hpack hsat hbar hcond.1 hcond.2
+      hperm' hfix' rfl).1
+  · -- k = 4: nonemptiness of `mcell4` gives `hl ul < sqrt 2`; `p2e_YIFVQDV_1`
+    have hm : mcell 4 V ul = mcell4 V ul :=
+      (p2e_MCELL_EXPLICIT 4 V ul).2.2.2.2 (by norm_num)
+    rw [hm, mcell4] at hne
+    have hhl : hl ul < Real.sqrt 2 := by
+      by_contra hc
+      rw [if_neg hc] at hne
+      exact hne rfl
+    have hperm' : permutes p (Set.Icc 0 3) := by simpa using hperm
+    exact p2e_YIFVQDV_1 V ul 3 p hpack hbar hhl hperm'
+
