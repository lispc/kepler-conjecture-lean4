+/-- HL `p2e_HL_EQ_DIST0` (Rogers.hl:7081). -/
+private theorem p2e_HL_EQ_DIST0 (V : Set V3) (k : ℕ) (ul : List V3) (hV : Packing V)
+    (hb : barV V k ul) : hl ul = dist (circumcenter (setOfList ul)) (hdV ul) := by
+  have hlen : 1 ≤ ul.length := by rw [hb.1]; omega
+  cases ul with
+  | nil =>
+    have h0 := hb.1
+    simp at h0
+  | cons a t =>
+    have hhd : hdV (a :: t) = a := rfl
+    have hmem : a ∈ setOfList (a :: t) := by simp [setOfList]
+    rw [hhd]
+    exact (p2e_HL_PROPERTIES V (a :: t) k hV hb a hmem).symm
