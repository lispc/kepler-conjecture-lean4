+/-- HL GRUTOTI.hl:7227: `s = {X | mcell_set V X /\ edgeX V X e}` — the index
+set of the final sums (identical to the GRUTOTI1_concl set by definition). -/
+private def grutotiEdgeCells (V : Set V3) (e : Set V3) : Set (Set V3) :=
