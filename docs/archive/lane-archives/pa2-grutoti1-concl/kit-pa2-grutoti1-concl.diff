+/-- HOL `p2e_TRUNCATE_SIMPLEX_GENERAL_2` (marchal1.hl:146):
+`ul = APPEND [a;b;c] vl ==> truncate_simplex 2 ul = [a;b;c]`. -/
+private theorem p2e_TRUNCATE_SIMPLEX_GENERAL_2 (ul vl : List V3) (a b c : V3)
+    (h : ul = [a, b, c] ++ vl) : truncateSimplex 2 ul = [a, b, c] :=
+  ((p2e_TRUNCATE_SIMPLEX_INITIAL_SUBLIST 2 [a, b, c] ul).2
+    ⟨by rw [h]; exact p2e_INITIAL_SUBLIST_APPEND [a, b, c] vl, rfl⟩).1
