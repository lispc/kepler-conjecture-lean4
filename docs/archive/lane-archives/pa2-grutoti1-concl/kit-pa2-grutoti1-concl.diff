+/-- `arcV` is symmetric in its last two arguments. -/
+private theorem p2e_p6_arcV_comm (p u v : V3) : arcV p u v = arcV p v u := by
+  unfold arcV
+  simp only [WithLp.ofLp_sub]
+  rw [dotProduct_comm, mul_comm]
+
