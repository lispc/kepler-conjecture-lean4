+    ∃ hd : V3, ∃ tl : List V3, ul = hd :: tl ∧ hd = hdV ul := by
+  cases ul with
+  | nil => exact absurd hbar.1 (by simp)
+  | cons a t => exact ⟨a, t, rfl, rfl⟩
