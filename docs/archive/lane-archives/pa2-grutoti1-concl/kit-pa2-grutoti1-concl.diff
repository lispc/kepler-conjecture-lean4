+/-- pack3.hl:2341 `p2e_POLYTOPE_VORONOI_LIST`. Bounded (cell inside the head's
+compact Voronoi ball) + polyhedron (`p2e_POLYHEDRON_VORONOI_LIST`) gives a
+polytope. -/
+private theorem p2e_POLYTOPE_VORONOI_LIST (V : Set V3) (ul : List V3) (hV : Packing V)
+    (hs : saturated V) (hsub : setOfList ul ⊆ V) (hne : ul ≠ []) :
+    polytope (voronoiList V ul) := by
+  obtain ⟨h, t, hcons⟩ := p2e_LENGTH_IMP_CONS ul (by
+    cases ul with
+    | nil => exact absurd rfl hne
+    | cons a t => simp)
+  subst hcons
+  have hVh : h ∈ V := hsub (by simp [setOfList])
+  have hsp : polyhedron (voronoiList V (h :: t)) :=
+    p2e_POLYHEDRON_VORONOI_LIST V (h :: t) hV hs hsub
+  have hcl : IsClosed (voronoiList V (h :: t)) := p2e_p5_isClosed_voronoiList V (h :: t)
+  have hbdd : Bornology.IsBounded (voronoiList V (h :: t)) :=
+    p2e_p5_bounded_voronoiList_of_len V (h :: t) hs (by simp)
+  have hcomp : _root_.IsCompact (voronoiList V (h :: t)) :=
+    Metric.isCompact_of_isClosed_isBounded hcl hbdd
+  exact p2e_p5_polytope_of_compact_polyhedron hsp hcomp
