+          intro i hi1 hi2
+          have h5 := p2e_OMEGA_LIST_N_LEMMA V v i (k - i) (by omega)
+          rw [show i + (k - i) = k from by omega] at h5
+          rw [htk] at h5
+          exact h5
+        have himg : {omegaListN V v i | i ∈ Finset.Icc j (k - 1)} =
+            {omegaListN V wl i | i ∈ Finset.Icc j (k - 1)} := by
+          ext z
+          simp only [Set.mem_setOf_eq, Finset.mem_Icc]
+          constructor
+          · rintro ⟨i, hi, rfl⟩
+            refine ⟨i, hi, ?_⟩
+            rw [hom i hi.1 hi.2]
+          · rintro ⟨i, hi, rfl⟩
+            refine ⟨i, hi, ?_⟩
+            rw [hom i hi.1 hi.2]
