+/-- `V3` affine-hull transfer for a facet contained in a hyperplane: every point
+of the hyperplane lies in the affine hull of the facet. -/
+private theorem p22w7_mem_affineSpan_of_mem_hyperplane {P c : Set V3} {v : V3} {b : ℝ}
+    (hp : polyhedron P) (hi : (0 : V3) ∈ interior P) (hf : FacetOf c P)
+    (hcA : c ⊆ {p : V3 | p ⬝ᵥ v = b}) (hv : v ≠ 0) {u0 : V3}
+    (hu0 : u0 ∈ {p : V3 | p ⬝ᵥ v = b}) : u0 ∈ (affineSpan ℝ c : Set V3) := by
+  classical
+  have hHne : ({p : V3 | p ⬝ᵥ v = b} : Set V3) ≠ ∅ :=
+    Set.nonempty_iff_ne_empty.mp ⟨u0, hu0⟩
+  have hdimc : Module.finrank ℝ (vectorSpan ℝ c) = 2 := by
+    have h := FACET_AFF_DIM_2 P c hp hi hf
+    rw [affDim, if_neg hf.2.1] at h
+    exact_mod_cast h
+  have hdimH : Module.finrank ℝ (vectorSpan ℝ ({p : V3 | p ⬝ᵥ v = b})) = 2 := by
+    have hset : ({p : V3 | p ⬝ᵥ v = b} : Set V3) = {x : V3 | v ⬝ᵥ x = b} := by
+      ext p
+      rw [Set.mem_setOf_eq, Set.mem_setOf_eq, dotProduct_comm]
+    have hne : ({x : V3 | v ⬝ᵥ x = b} : Set V3) ≠ ∅ := by
+      rw [← hset]
+      exact hHne
+    have h := affDim_hyperplane hv b
+    rw [affDim, if_neg hne] at h
+    rw [hset]
+    exact_mod_cast h
+  have hdir : (affineSpan ℝ c).direction
+      = (affineSpan ℝ ({p : V3 | p ⬝ᵥ v = b})).direction := by
+    rw [direction_affineSpan, direction_affineSpan]
+    exact Submodule.eq_of_le_of_finrank_eq (vectorSpan_mono ℝ hcA) (by rw [hdimc, hdimH])
+  have hST : (affineSpan ℝ c : AffineSubspace ℝ V3) ≤
+      affineSpan ℝ ({p : V3 | p ⬝ᵥ v = b}) :=
+    affineSpan_mono ℝ hcA
+  have hsub : (affineSpan ℝ ({p : V3 | p ⬝ᵥ v = b}) : Set V3) ⊆
+      (affineSpan ℝ c : Set V3) := by
+    intro t ht
+    obtain ⟨c0, hc0⟩ := Set.nonempty_iff_ne_empty.mpr hf.2.1
+    have hc0S : c0 ∈ (affineSpan ℝ c : AffineSubspace ℝ V3) := subset_affineSpan ℝ c hc0
+    have hd : t -ᵥ c0 ∈ (affineSpan ℝ c).direction := by
+      rw [hdir]
+      exact AffineSubspace.vsub_mem_direction ht (hST hc0S)
+    have hvadd := AffineSubspace.vadd_mem_of_mem_direction hd hc0S
+    simpa using hvadd
+  exact hsub (subset_affineSpan ℝ _ hu0)
