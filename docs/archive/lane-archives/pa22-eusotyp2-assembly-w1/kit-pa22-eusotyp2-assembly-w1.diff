+/-- `AzimSpec` is unchanged by shifting the first measured point along the axis
+(`h1` absorbs the shift). -/
+private theorem p22w7_azimSpec_base_shift {a p q : V3} {θ : ℝ} (s : ℝ) :
+    AzimSpec 0 a (p + s • a) q θ ↔ AzimSpec 0 a p q θ := by
+  unfold AzimSpec
+  constructor
+  · rintro ⟨hθ0, hθ1, hA, hB, hsp⟩
+    refine ⟨hθ0, hθ1, hA - s, hB, ?_⟩
+    intro e1 e2 e3 hON hax hne
+    obtain ⟨psi, r1, r2, hp, hq, hr1, hr2⟩ := hsp e1 e2 e3 hON hax hne
+    refine ⟨psi, r1, r2, ?_, hq, hr1, hr2⟩
+    simp only [sub_zero] at hp hq ⊢
+    calc p = (p + s • a) - s • a := by abel
+      _ = ((r1 * Real.cos psi) • e1 + (r1 * Real.sin psi) • e2 + hA • a) - s • a := by
+            rw [hp]
+      _ = (r1 * Real.cos psi) • e1 + (r1 * Real.sin psi) • e2 + (hA - s) • a := by
+            rw [sub_smul]; abel
+  · rintro ⟨hθ0, hθ1, hA, hB, hsp⟩
+    refine ⟨hθ0, hθ1, hA + s, hB, ?_⟩
+    intro e1 e2 e3 hON hax hne
+    obtain ⟨psi, r1, r2, hp, hq, hr1, hr2⟩ := hsp e1 e2 e3 hON hax hne
+    refine ⟨psi, r1, r2, ?_, hq, hr1, hr2⟩
+    simp only [sub_zero] at hp hq ⊢
+    calc p + s • a
+        = ((r1 * Real.cos psi) • e1 + (r1 * Real.sin psi) • e2 + hA • a) + s • a := by
+            rw [hp]
+      _ = (r1 * Real.cos psi) • e1 + (r1 * Real.sin psi) • e2 + (hA + s) • a := by
+            rw [add_smul]; abel
+
+set_option maxHeartbeats 12000000 in
+/-- `azim` is unchanged by shifting the first measured point along the axis. -/
+private theorem p22w7_azim_base_shift (a p q : V3) (s : ℝ) :
+    azim 0 a (p + s • a) q = azim 0 a p q := by
+  have hc : (Collinear3 0 a (p + s • a) ∨ Collinear3 0 a q) ↔
+      (Collinear3 0 a p ∨ Collinear3 0 a q) :=
+    or_congr (p22_collinear3_axis_shift s).symm Iff.rfl
+  have hpred : AzimSpec 0 a (p + s • a) q = AzimSpec 0 a p q :=
+    funext fun θ => propext (p22w7_azimSpec_base_shift (a := a) (p := p) (q := q) (θ := θ) s)
+  by_cases hdeg : Collinear3 0 a (p + s • a) ∨ Collinear3 0 a q
+  · unfold azim
+    rw [if_pos hdeg, if_pos (hc.mp hdeg)]
+  · unfold azim
+    rw [if_neg hdeg, if_neg (hc.not.mp hdeg), hpred]
