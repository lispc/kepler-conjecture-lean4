+/-! ### YSSKQOY_VECTOR 支撑件（ACS + MVT 直接证法）
+
+`YSSKQOY_VECTOR` 的核心是两变量三角不等式
+`acs(a/4) + acs(b/4) - π/3 ≤ arccos((a²+b²-4)/(2ab))`（`2 ≤ a,b ≤ 2.52`）。
+证法：固定 `b`，令 `F(a,b) = acs(a/4) + acs(b/4) - π/3 - arccos((a²+b²-4)/(2ab))`；
+证明 `F` 对 `a` 单调不增（`antitoneOn_of_deriv_nonpos`），且 `F(2,b) = 0`。
+导数非正的代数核：`(a²-b²+4)√(16-a²) ≤ a√(4a²b²-(a²+b²-4)²)`，平方后即
+`16(b-2)(b+2)(2a²-b²+4) ≥ 0`（在盒上三因子皆非负）。 -/
+
+private noncomputable def yssF (x b : ℝ) : ℝ :=
+  acs (x / 4) + (acs (b / 4) - Real.pi / 3) - Real.arccos ((x ^ 2 + b ^ 2 - 4) / (2 * x * b))
+
+private lemma yssF_two {b : ℝ} (hb : 2 ≤ b) : yssF 2 b = 0 := by
+  unfold yssF
+  have hd : ((2 : ℝ) ^ 2 + b ^ 2 - 4) / (2 * 2 * b) = b / 4 := by
+    field_simp
+    ring
+  have h1 : acs ((2 : ℝ) / 4) = Real.pi / 3 := by
+    rw [show (2 : ℝ) / 4 = 1 / 2 from by norm_num, acs, ← Real.cos_pi_div_three]
+    exact Real.arccos_cos (by linarith [Real.pi_pos]) (by linarith [Real.pi_pos])
+  rw [hd, h1, acs]
+  ring
+
+private lemma yssF_hasDerivAt {b x : ℝ} (hb : 2 ≤ b) (hb' : b ≤ 2.52) (hx : 2 ≤ x) (hx' : x ≤ 2.52) :
+    HasDerivAt (fun x => yssF x b)
+      (-(1 / Real.sqrt (16 - x ^ 2)) +
+        (x ^ 2 - b ^ 2 + 4) / (2 * x ^ 2 * b) *
+          (1 / Real.sqrt (1 - ((x ^ 2 + b ^ 2 - 4) / (2 * x * b)) ^ 2))) x := by
+  have hx0 : (0:ℝ) < x := by linarith
+  have hb0 : (0:ℝ) < b := by linarith
+  have hxa : HasDerivAt (fun y : ℝ => y / 4) (1/4) x := by
+    simpa using (hasDerivAt_id x).div_const 4
+  have hne1 : x/4 ≠ -1 := by intro h; nlinarith
+  have hne2 : x/4 ≠ 1 := by intro h; nlinarith
+  have hacs1 : HasDerivAt (fun y : ℝ => acs (y/4)) (-(1/Real.sqrt (16 - x^2))) x := by
+    have hbase : HasDerivAt Real.arccos (-(1/Real.sqrt (1 - (x/4)^2))) (x/4) :=
+      Real.hasDerivAt_arccos hne1 hne2
+    have hcomp := HasDerivAt.comp x (h := fun y : ℝ => y/4) (h₂ := Real.arccos) hbase hxa
+    have hval : -(1 / Real.sqrt (1 - (x/4)^2)) * (1/4) = -(1/Real.sqrt (16 - x^2)) := by
+      have hs : Real.sqrt (1 - (x/4)^2) = Real.sqrt (16 - x^2)/4 := by
+        rw [show (1:ℝ) - (x/4)^2 = (16 - x^2)/16 by ring]
+        rw [Real.sqrt_div (by nlinarith : (0:ℝ) ≤ 16 - x^2) 16]
+        norm_num
+      rw [hs]
+      field_simp
+    rw [← hval]
+    exact hcomp
+  have hden0 : (2 * x * b) ≠ 0 := by positivity
+  have hd : HasDerivAt (fun y : ℝ => (y ^ 2 + b ^ 2 - 4) / (2 * y * b))
+      ((x ^ 2 - b ^ 2 + 4) / (2 * x ^ 2 * b)) x := by
+    have hnum : HasDerivAt (fun y : ℝ => y ^ 2 + b ^ 2 - 4) (2 * x) x := by
+      have h := (hasDerivAt_pow 2 x).const_add (b^2 - 4)
+      simpa [mul_comm, mul_left_comm, mul_assoc] using h
+    have hden : HasDerivAt (fun y : ℝ => 2 * y * b) (2 * b) x := by
+      have h := ((hasDerivAt_id x).const_mul (2:ℝ)).mul_const b
+      simpa [mul_comm, mul_left_comm, mul_assoc] using h
+    have hdiv := hnum.div hden hden0
+    have hval : (2 * x * (2 * x * b) - (x ^ 2 + b ^ 2 - 4) * (2 * b)) / (2 * x * b)^2
+        = (x ^ 2 - b ^ 2 + 4) / (2 * x ^ 2 * b) := by
+      field_simp
+      ring
+    rw [← hval]
+    exact hdiv
+  have hd1 : ((x ^ 2 + b ^ 2 - 4) / (2 * x * b)) ≠ 1 := by
+    intro h
+    rw [div_eq_one_iff_eq hden0] at h
+    nlinarith [sq_nonneg (x - b)]
+  have hd1' : ((x ^ 2 + b ^ 2 - 4) / (2 * x * b)) ≠ -1 := by
+    intro h
+    rw [div_eq_iff hden0] at h
+    nlinarith [sq_nonneg (x + b)]
+  have hcompd : HasDerivAt (fun y : ℝ => Real.arccos ((y ^ 2 + b ^ 2 - 4) / (2 * y * b)))
+      (-(1 / Real.sqrt (1 - ((x ^ 2 + b ^ 2 - 4) / (2 * x * b)) ^ 2)) *
+        ((x ^ 2 - b ^ 2 + 4) / (2 * x ^ 2 * b))) x := by
+    have hbase : HasDerivAt Real.arccos
+        (-(1 / Real.sqrt (1 - ((x ^ 2 + b ^ 2 - 4) / (2 * x * b)) ^ 2)))
+        ((x ^ 2 + b ^ 2 - 4) / (2 * x * b)) := Real.hasDerivAt_arccos hd1' hd1
+    exact HasDerivAt.comp (x := x) (h := fun y : ℝ => (y ^ 2 + b ^ 2 - 4) / (2 * y * b))
+      (h₂ := Real.arccos) hbase hd
+  have hconst : HasDerivAt (fun _ : ℝ => acs (b/4) - Real.pi/3) 0 x := hasDerivAt_const _ _
+  have hcomb := (hacs1.add hconst).sub hcompd
+  have hval2 : (-(1/Real.sqrt (16 - x^2)) + 0) - (-(1/Real.sqrt (1 - ((x^2+b^2-4)/(2*x*b))^2)) *
+      ((x^2-b^2+4)/(2*x^2*b)))
+      = -(1/Real.sqrt (16 - x^2)) + (x^2-b^2+4)/(2*x^2*b) *
+          (1/Real.sqrt (1 - ((x^2+b^2-4)/(2*x*b))^2)) := by ring
+  rw [hval2] at hcomb
+  exact hcomb
+
+private lemma yssF_deriv_nonpos {b x : ℝ} (hb : 2 ≤ b) (hb' : b ≤ 2.52) (hx : 2 < x) (hx' : x < 2.52) :
+    -(1 / Real.sqrt (16 - x ^ 2)) +
+      (x ^ 2 - b ^ 2 + 4) / (2 * x ^ 2 * b) *
+        (1 / Real.sqrt (1 - ((x ^ 2 + b ^ 2 - 4) / (2 * x * b)) ^ 2)) ≤ 0 := by
+  have hx0 : (0:ℝ) < x := by linarith
+  have hb0 : (0:ℝ) < b := by linarith
