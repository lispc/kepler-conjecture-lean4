+private theorem collinear3_coplanar4 {z w w1 w2 : V3} (hc : Collinear3 z w w1) :
+    Coplanar ({z, w, w1, w2} : Set V3) := by
+  by_cases hzw : z = w
+  · subst hzw
+    have hset : ({z, z, w1, w2} : Set V3) = {z, w1, w2} := by
+      ext p; simp only [Set.mem_insert_iff, Set.mem_singleton_iff]; tauto
+    rw [hset]
