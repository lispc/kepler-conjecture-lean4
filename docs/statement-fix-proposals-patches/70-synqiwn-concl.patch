+theorem SYNQIWN_concl : main_nonlinear_terminal_v11 →
+    ∀ (s : ScsV39) (v : ℕ → V3) (i k : ℕ), isScsV39 s → BBsV39 s v →
+    s.k = k → 3 < k →
