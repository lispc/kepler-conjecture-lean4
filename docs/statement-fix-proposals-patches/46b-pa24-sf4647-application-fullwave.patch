+    (1 - x - y - z) • u0 + x • u1 + y • w1 + z • w2 ∈
+      affGt ({u0, u1} : Set V3) ({w1, w2} : Set V3) := by
+  have hfin : (({u0, u1} : Set V3) ∪ {w1, w2}).Finite :=
