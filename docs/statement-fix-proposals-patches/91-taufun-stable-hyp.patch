+/-- SF-91 feed: `isScsV39`'s off-diagonal lower bound (the `i < s.k ∧ j < s.k
+∧ i ≠ j → 2 ≤ s.a i j` conjunct of LA1 `isScsV39`, HOL stable_system clause 2,
+dih2k.hl:64) shifted onto the `((i + 1) % k)`-indexing that the CASE_4/5/6
+tables `aRk`/`bRk` use — this is exactly the repaired `h2` premise of
+`continuousOn_tauFun_p23` at `m = k`, since `aRk s i j = s.a ((i + 1) % k)
+((j + 1) % k)` definitionally. Same shape as the SF-89 bridge
+`stabAdj_of_isScsV39` above: the bridge needs the `s.k = k` pin (the
+representative mod is against `s.k`, not the Fin bound). -/
+private theorem age2_of_isScsV39 {k : ℕ} (s : ScsV39) (hs : isScsV39 s)
+    (hk : s.k = k) (hk3 : 3 < s.k) (i j : Fin k) (hij : i ≠ j) :
+    2 ≤ s.a (((i : ℕ) + 1) % k) (((j : ℕ) + 1) % k) := by
+  unfold isScsV39 at hs
+  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, -, -, -, hage2, -, -, -, -, -⟩ := hs
+  subst hk
+  have hilt : (i : ℕ) < s.k := i.isLt
+  have hjlt : (j : ℕ) < s.k := j.isLt
+  have hik : ((i : ℕ) + 1) % s.k < s.k := Nat.mod_lt _ (by omega)
+  have hjk : ((j : ℕ) + 1) % s.k < s.k := Nat.mod_lt _ (by omega)
+  refine hage2 _ _ ⟨hik, hjk, ?_⟩
+  intro he
+  refine hij (Fin.val_injective ?_)
+  rcases Nat.lt_or_ge ((i : ℕ) + 1) s.k with hi1 | hi1
+  · rcases Nat.lt_or_ge ((j : ℕ) + 1) s.k with hj1 | hj1
+    · rw [Nat.mod_eq_of_lt hi1, Nat.mod_eq_of_lt hj1] at he
+      omega
+    · have hje : (j : ℕ) + 1 = s.k := by omega
+      rw [Nat.mod_eq_of_lt hi1, hje, Nat.mod_self] at he
+      omega
+  · have hie : (i : ℕ) + 1 = s.k := by omega
+    rcases Nat.lt_or_ge ((j : ℕ) + 1) s.k with hj1 | hj1
+    · rw [hie, Nat.mod_self, Nat.mod_eq_of_lt hj1] at he
+      omega
+    · have hje : (j : ℕ) + 1 = s.k := by omega
+      exact by omega
+
