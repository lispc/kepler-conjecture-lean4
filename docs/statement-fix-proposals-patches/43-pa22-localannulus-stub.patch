+    (hasum : ∑ v ∈ hsize.1.toFinset,
+        max 0 (regularSphericalPolygonAreaP22 (Real.cos (theta v)) (k v)) ≤ 4 * Real.pi)
+    (hloc : ¬ localAnnulusInequalityP22 V) : n < 16 := by
+  have hncard : (V.ncard : ℝ) = n := hsize.2
