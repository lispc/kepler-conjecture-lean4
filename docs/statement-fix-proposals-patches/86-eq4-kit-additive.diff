+    (hsl : isScsSliceV39 s s' s'' p q) (hk'3 : s'.k = 3)
+    (hp : vv (p % s.k) = u) (hq : vv (q % s.k) = w)
+    (hV : Set.range vv = V)
+    (hE : Set.range (fun i => {vv i, vv (i + 1)}) = E)
+    (hFF : Set.range (fun i => (vv i, vv (i + 1))) = FF)
