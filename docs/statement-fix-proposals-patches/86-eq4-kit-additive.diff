+    have hR : (q + (1 + (s.k - p % s.k))) % s.k
+        = (q % s.k + (1 + (s.k - p % s.k)) % s.k) % s.k := Nat.add_mod _ _ _
+    rw [Nat.add_assoc, Nat.add_assoc, hL, hR, Nat.mod_mod]
+  have hsk'q : s'.k = (q % s.k + 1 + (s.k - p % s.k)) % s.k := by rw [hsk', ← e1']
+  have hpq2 : (p % s.k + 2) % s.k = q % s.k := by
