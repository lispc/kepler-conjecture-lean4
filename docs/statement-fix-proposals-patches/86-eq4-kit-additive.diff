+    rw [show ((1:ℕ) + 3 - 1) % 3 = 0 from rfl, Nat.zero_add]
+  have vwt6 : vv ((2 + 3 - 1) % 3 + p % s.k) = vv (p % s.k + 1) := by
+    rw [show ((2:ℕ) + 3 - 1) % 3 = 1 from rfl, Nat.add_comm]
