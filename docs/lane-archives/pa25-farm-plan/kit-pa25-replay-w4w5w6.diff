+private theorem p25w6_wtcount3_core (B : Set (Set V3)) (u0 u1 v1 : V3) (hB : B.Finite)
+    (hE0 : ({u0, u1} : Set V3) ∈ B ↔ criticalEdgeY (dist u0 u1))
+    (hE1 : ({u0, v1} : Set V3) ∈ B ↔ criticalEdgeY (dist u0 v1))
+    (hE2 : ({u1, v1} : Set V3) ∈ B ↔ criticalEdgeY (dist u1 v1))
+    (h01 : u0 ≠ u1) (h02 : u0 ≠ v1) (h12 : u1 ≠ v1) :
+    Set.ncard (insert ({u0, u1} : Set V3) (insert ({u0, v1} : Set V3)
