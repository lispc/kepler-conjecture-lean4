+private theorem p21w_norm_split (e1 e2 e3 : V3) (he : Orthonormal3 e1 e2 e3) (x : V3) :
+    ‖x‖ ^ 2 = (x ⬝ᵥ e3) ^ 2 + ‖zOf e1 e2 x‖ ^ 2 := by
+  rw [p21w_on3_norm_sq e1 e2 e3 he x, p21w_zOf_norm_sq e1 e2 x]
+  ring
