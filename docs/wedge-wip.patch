+private theorem p21w_zOf_add (e1 e2 x y : V3) :
+    zOf e1 e2 (x + y) = zOf e1 e2 x + zOf e1 e2 y := by
+  unfold zOf
+  simp only [WithLp.ofLp_add, add_dotProduct, dotProduct_add]
+  rw [mul_add, add_mul]
+  ring
+
+private theorem p21w_zOf_smul (e1 e2 : V3) (c : ℝ) (x : V3) :
+    zOf e1 e2 (c • x) = c * zOf e1 e2 x := by
+  unfold zOf
+  simp only [WithLp.ofLp_smul, smul_dotProduct, dotProduct_smul, smul_eq_mul]
+  ring
+
+private theorem p21w_zOf_sub (e1 e2 x y : V3) :
+    zOf e1 e2 (x - y) = zOf e1 e2 x - zOf e1 e2 y := by
+  have h := p21w_zOf_add e1 e2 (x - y) y
+  rw [add_sub_cancel] at h
+  exact eq_sub_of_add_eq h
+
+private theorem p21w_mem_axis_of_zOf {e1 e2 e3 : V3} (he : Orthonormal3 e1 e2 e3)
+    {x : V3} (h : zOf e1 e2 x = 0) : x = (x ⬝ᵥ e3) • e3 := by
+  have hz : (x ⬝ᵥ e1) = 0 ∧ (x ⬝ᵥ e2) = 0 := by
+    have h2 := Complex.ext_iff.mp h
+    constructor
+    · have h3 := h2.1
+      simp only [zOf, Complex.add_re, Complex.mul_re, Complex.I_re, mul_zero,
+        add_zero] at h3
+      exact h3
+    · have h3 := h2.2
+      simp only [zOf, Complex.add_im, Complex.mul_im, Complex.I_im, Complex.ofReal_re,
+        Complex.ofReal_im, mul_one] at h3
+      linarith [h3]
+  have hzero : ‖x - (x ⬝ᵥ e3) • e3‖ = 0 := by
+    have hns := p21w_on3_norm_sq e1 e2 e3 he (x - (x ⬝ᵥ e3) • e3)
+    rw [hns]
+    have hd1 : ((x - (x ⬝ᵥ e3) • e3 : V3) ⬝ᵥ e1) = 0 := by
+      rw [sub_dotProduct, smul_dotProduct]
+      rw [hz.1, he.2.2.2.2.1]
+      simp
+    have hd2 : ((x - (x ⬝ᵥ e3) • e3 : V3) ⬝ᵥ e2) = 0 := by
+      rw [sub_dotProduct, smul_dotProduct]
+      rw [hz.2, he.2.2.2.2.2.1]
+      simp
+    have hd3 : ((x - (x ⬝ᵥ e3) • e3 : V3) ⬝ᵥ e3) = 0 := by
+      rw [sub_dotProduct, smul_dotProduct]
+      rw [show e3 ⬝ᵥ e3 = (1:ℝ) from he.2.2.1]
+      simp
+    rw [hd1, hd2, hd3]
+    simp
+  exact sub_eq_zero.mp (norm_eq_zero.mpr hzero)
