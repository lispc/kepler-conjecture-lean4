/-- 注册表 id 列。**由 rfl 与 `IdLists.lpIneqsIds` 逐字相等**（见下）。 -/
def lpIneqIds : List String := lpIneqTable.map Prod.fst

set_option maxRecDepth 2048 in
theorem lpIneqTable_length : lpIneqTable.length = 127 := rfl

set_option maxRecDepth 2048 in
theorem lpIneqIds_eq : lpIneqIds = lpIneqsIds := rfl


/-- 查表（结构递归，显式 `some`/`none`——不需要对 `String` 做内核归约）。 -/
def lpIneqLookupAux : List (String × Prop) → String → Option Prop
  | [], _ => none
  | (k, v) :: rest, id => if k = id then some v else lpIneqLookupAux rest id

/-- 按 HOL id 查 LP 注册表。 -/
def lpIneqLookup (id : String) : Option Prop := lpIneqLookupAux lpIneqTable id

/-- **注册表谓词**（`CertifiedIneqHolds := lpIneqProp`）。

- `id ∈ lpIneqIds`（= `lpIneqsIds`，rfl 相等）→ 查表所得的字面不等式命题
  （127 条真实但未证债务）；查表在 LP 清单上必命中（下证），故这里的
  `getD False` 对 LP 域不可达；
- LP 清单外的历史试点键 `"3397113841"` → 已证的 `ineqProp_3397113841`
  （它不在 HOL `lp_ineqs`——`ineq.hl` 里是 `skip` 记录——故不属于 127 条；
  保留它只为让既有会师点定理 `certifiedIneqHoldsPilotCase` 继续成立）；
- 其余 `certLookupDomain`（六清单并集）内的 id → 旧占位 `True`
  （五个兄弟分量的既有债务，本轮不动：改成 `False` 会把它们的
  `nli*Ids : AllCertified …` 从真空真变成假命题，见 DELIVERY.md）；
- 域外 → `False`。 -/
def lpIneqProp (id : String) : Prop :=
  if id ∈ lpIneqIds then (lpIneqLookup id).getD False
  else if id = "3397113841" then ineqProp_3397113841
  else if id ∈ certLookupDomain then True
  else False

/-- **定义域覆盖（LP 片段）**：`lpIneqsIds` 中每个 id 都命中注册表。
证明与字符串内容无关：清单逐字等于 `lpIneqIds`，而查表对 `lpIneqIds`
的每个成员必返回 `some`。 -/
theorem lpIneqLookupAux_isSome_of_mem (l : List (String × Prop)) :
    ∀ (id : String), id ∈ l.map Prod.fst → (lpIneqLookupAux l id).isSome := by
  induction l with
  | nil =>
      intro id h
      simp at h
  | cons kv rest ih =>
      obtain ⟨k, v⟩ := kv
      intro id h
      rw [List.map_cons, List.mem_cons] at h
      by_cases hk : k = id
      · rw [hk]
        simp [lpIneqLookupAux]
      · rw [lpIneqLookupAux, if_neg hk]
        rcases h with h | h
        · exact absurd h.symm hk
        · exact ih id h

/-- 查表返回的表内元素（`some p` 时可由表内某对给出 `q.1 = id`、`q.2 = p`）。 -/
theorem lpIneqLookupAux_some_mem (l : List (String × Prop)) :
    ∀ (id : String) (p : Prop), lpIneqLookupAux l id = some p →
      ∃ q ∈ l, q.1 = id ∧ q.2 = p := by
  induction l with
  | nil =>
      intro id p h
      simp [lpIneqLookupAux] at h
  | cons kv rest ih =>
      obtain ⟨k, v⟩ := kv
      intro id p h
      simp only [lpIneqLookupAux] at h
      by_cases hk : k = id
      · rw [if_pos hk] at h
        simp only [Option.some.injEq] at h
        exact ⟨(k, v), by simp, hk, h⟩
      · rw [if_neg hk] at h
        obtain ⟨q, hm, hq1, hq2⟩ := ih id p h
        exact ⟨q, List.mem_cons_of_mem (k, v) hm, hq1, hq2⟩

/-- **LP 回落分支不可达**：`id ∈ lpIneqsIds ⟹ 查表必命中`。 -/
theorem lpIneqLookup_isSome_of_mem_lpIneqsIds {id : String}
    (h : id ∈ lpIneqsIds) : (lpIneqLookup id).isSome := by
  have h' : id ∈ lpIneqIds := by
    rw [lpIneqIds_eq]
    exact h
  exact lpIneqLookupAux_isSome_of_mem lpIneqTable id h'

/-- LP 清单上的 `lpIneqProp` 就是查表结果（`if` 的 LP 分支）。 -/
theorem lpIneqProp_eq_getD_of_mem {id : String} (h : id ∈ lpIneqsIds) :
    lpIneqProp id = (lpIneqLookup id).getD False := by
  have h' : id ∈ lpIneqIds := by
    rw [lpIneqIds_eq]
    exact h
  simp [lpIneqProp, h']

/-- 命中即得该 id 的字面命题：LP 清单上的 `lpIneqProp` 不是占位。 -/
theorem lpIneqProp_eq_of_mem {id : String} (h : id ∈ lpIneqsIds) :
    ∃ q ∈ lpIneqTable, q.1 = id ∧ lpIneqProp id = q.2 := by
  have hs : (lpIneqLookup id).isSome := lpIneqLookup_isSome_of_mem_lpIneqsIds h
  obtain ⟨p, hp⟩ : ∃ p, lpIneqLookup id = some p := by
    cases hh : lpIneqLookup id with
    | none => simp [hh] at hs
    | some p => exact ⟨p, rfl⟩
  obtain ⟨q, hm, hq1, hq2⟩ := lpIneqLookupAux_some_mem lpIneqTable id p hp
  refine ⟨q, hm, hq1, ?_⟩
  rw [lpIneqProp_eq_getD_of_mem h, hp]
  simp [hq2]

#print axioms lpIneqLookup_isSome_of_mem_lpIneqsIds
#print axioms lpIneqProp_eq_getD_of_mem
#print axioms lpIneqProp_eq_of_mem
#print axioms lpIneqTable_length
#print axioms lpIneqIds_eq

