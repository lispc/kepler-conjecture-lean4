/-- The family cover: every split is the exact dyadic bisection
(one kernel `decide` over `coversB`). -/
theorem iysL1Covers : iysL1Tree.covers :=
  PosTree.coversB_sound _ (by decide +kernel)

/-- The family positivity: `TskXLLIPLSAtan1Expr > 0` on the whole family box. -/
theorem iysL1_pos (ρ : Fin 6 → ℝ) (hρ : boxMem iysL1Box ρ) :
    0 < IExpr.evalReal TskXLLIPLSAtan1Expr ρ :=
  iysL1Tree.sound iysL1Box iysL1Covers
    (by intro i; fin_cases i <;> exact
      ⟨by decide +kernel, by decide +kernel⟩) ρ hρ

#print axioms iysL1_pos

