/-- mono 折叠组合（叶 119975，两叶引用零重算）. -/

theorem Fold119975 :
    checkPosFaceLo E549 (derivIExpr E549 2)
    B119975 2 PF119975 DP119975 = true := by
  have h1 : checkPosTMHull (derivIExpr E549 2) B119975 DP119975 = true := Der119975
  have h2 : checkPosTMHull E549 (faceBoxLo B119975 2) PF119975 = true := Face119975
  show (checkPosTMHull (derivIExpr E549 2) B119975 DP119975
      && checkPosTMHull E549 (faceBoxLo B119975 2) PF119975) = true
  rw [h1, h2, Bool.and_true]

