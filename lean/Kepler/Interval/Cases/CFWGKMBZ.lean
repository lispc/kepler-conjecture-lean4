private theorem evalReal_eq_yOfX (ρ : Fin 7 → ℝ) :
    (CFWGKMBZExpr).evalReal ρ =
      yOfX deltaX (ρ 1) (ρ 2) (ρ 3) (ρ 4) (ρ 5) (ρ 6) := by
  simp only [Kepler.Interval.Cases.CFWGKMBZExpr, Kepler.Interval.IExpr.evalReal,
    deltaX, yOfX, Kepler.Interval.Dyadic.toReal_int, Int.cast_zero, sub_zero]

private theorem dyadic_toReal_pos (m : ℤ) (e : ℤ) (hm : (0:ℤ) < m) :
    (0:ℝ) < Dyadic.toReal ⟨m, e⟩ := by
  rw [Dyadic.toReal_def]
  exact mul_pos (Int.cast_pos.mpr hm) (zpow_pos (by norm_num) e)

