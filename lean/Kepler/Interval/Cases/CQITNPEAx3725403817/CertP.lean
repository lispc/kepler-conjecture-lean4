/-- Univariate degree-2 Bernstein peel on [A, B], undivided x-space
form: `(B - A)^2 * q(t) = (B - t)^2 * q(A) + (t - A)(B - t) * M +
(t - A)^2 * q(B)` with `M = 2 * (middle Bernstein coefficient)`.
Algebra verified by hand and by the Python pipeline. -/
theorem peel2 (A B t u0 u1 u2 c0 c2 : ℝ)
    (hc0 : c0 = u0 + A * u1 + A ^ 2 * u2)
    (hc2 : c2 = u0 + B * u1 + B ^ 2 * u2) :
    (B - A) ^ 2 * (u0 + t * u1 + t ^ 2 * u2)
      = (B - t) ^ 2 * c0
        + (t - A) * (B - t) * (c0 + c2 - (B - A) ^ 2 * u2)
        + (t - A) ^ 2 * c2 := by
  subst hc0; subst hc2; ring

/-- Univariate degree-4 Bernstein peel on [A, B], undivided form with
`M1 = 4 b1`, `M2 = 6 b2`, `M3 = 4 b3`.  Verified symbolically
(work/verify_peel_n.py, exact rational dicts). -/
theorem peel4 (A B t u0 u1 u2 u3 u4 c0 c2 : ℝ)
    (hc0 : c0 = u0 + A * u1 + A ^ 2 * u2 + A ^ 3 * u3 + A ^ 4 * u4)
    (hc2 : c2 = u0 + B * u1 + B ^ 2 * u2 + B ^ 3 * u3 + B ^ 4 * u4) :
    (B - A) ^ 4 * (u0 + t * u1 + t ^ 2 * u2 + t ^ 3 * u3 + t ^ 4 * u4)
      = (B - t) ^ 4 * c0
        + (t - A) * (B - t) ^ 3 * ((B - A) * (u1 + 2 * A * u2 + 3 * A ^ 2 * u3 + 4 * A ^ 3 * u4) + 4 * c0)
        + (t - A) ^ 2 * (B - t) ^ 2 * ((B - A) ^ 2 * (u2 + 3 * A * u3 + 6 * A ^ 2 * u4) + 3 * (B - A) * (u1 + 2 * A * u2 + 3 * A ^ 2 * u3 + 4 * A ^ 3 * u4) + 6 * c0)
        + (t - A) ^ 3 * (B - t) * ((B - A) ^ 3 * (u3 + 4 * A * u4) + 2 * (B - A) ^ 2 * (u2 + 3 * A * u3 + 6 * A ^ 2 * u4) + 3 * (B - A) * (u1 + 2 * A * u2 + 3 * A ^ 2 * u3 + 4 * A ^ 3 * u4) + 4 * c0)
        + (t - A) ^ 4 * c2 := by
  subst hc0; subst hc2; ring

theorem pos_of_pos_mul {c t : ℝ} (hc : (0:ℝ) < c)
    (h : (0:ℝ) < c * t) : (0:ℝ) < t := by
  rcases lt_trichotomy t 0 with h1 | h1 | h1
  · have hct : c * t < 0 := mul_neg_of_pos_of_neg hc h1
    linarith
  · rw [h1, mul_zero] at h
    exact absurd h (lt_irrefl 0)
  · exact h1

