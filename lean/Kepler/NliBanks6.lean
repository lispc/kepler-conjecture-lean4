import Kepler.NliBanks5

/-!
Kepler.NliBanks6 — W3 lane `nli-unknown-w3`, task 3 (GCKBQEA), part 1.

The 32 vertex-line certificates for the quartic form

`gckbP = 4·x1·deltaX − (0.6936)²·(deltaX4)²`

on `x1 ∈ [6.06883225, 7.02674064]`, `x2 … x6 ∈ {4, 8}`.  Each line is proved
by a Bernstein certificate: `gckbP = P(end) + d·Q(d)` with `d = x1 − lo`
(or `hi − x1`), the cubic `Q` having positive Bernstein control points on
`[0, 0.95790839]` (so `Q ≥ 0` closes by `nlinarith`), and `P(end)` a positive
rational.  No certificates, no `sorry`/`axiom`/`native_decide`.
-/

set_option maxHeartbeats 4000000

namespace Kepler.NliBanks6
open Kepler.Text

noncomputable def gckbP (x1 x2 x3 x4 x5 x6 : ℝ) : ℝ :=
  4 * x1 * deltaX x1 x2 x3 x4 x5 x6 - (0.6936:ℝ)^2 * (deltaX4 x1 x2 x3 x4 x5 x6)^2

/-- Vertex line `(4,4,4,4,4)` (min end = lo). -/
theorem line_44444 (x1 : ℝ) (h1 : (6.06883225:ℝ) ≤ x1) (h2 : x1 ≤ 7.02674064) :
    (0:ℝ) < gckbP x1 4 4 4 4 4 := by
  have key : gckbP x1 4 4 4 4 4 = (1371643025988116813953272455467467191/400000000000000000000000000000000) + (x1 - 6.06883225) * ((15230376332715994177869357879/25000000000000000000000000) + (-1203296367213027357147/12500000000000000000) * (x1 - 6.06883225)^1 + (-31220473780681/1562500000000) * (x1 - 6.06883225)^2 + (-751689/1562500) * (x1 - 6.06883225)^3) := by
    unfold gckbP deltaX deltaX4; ring
  have hd : (0:ℝ) ≤ (x1 - 6.06883225) := by linarith
  have hQ : (0:ℝ) ≤ (15230376332715994177869357879/25000000000000000000000000) + (-1203296367213027357147/12500000000000000000) * (x1 - 6.06883225)^1 + (-31220473780681/1562500000000) * (x1 - 6.06883225)^2 + (-751689/1562500) * (x1 - 6.06883225)^3 := by
    nlinarith [h1, h2]
  have hp : (0:ℝ) < (1371643025988116813953272455467467191/400000000000000000000000000000000) := by norm_num
  nlinarith [key, hd, hQ, hp]

