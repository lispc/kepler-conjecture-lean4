theorem G1_eq : G 1 = Box.JTop.part 1 := by
  rw [show G 1 = ⟨(204 : ℤ), (154437690690454971556654091172969065570145581297571599246523 : ℤ), (1119326618816331538027242340626229166768751387403434894874596 : ℤ)⟩ from rfl]
