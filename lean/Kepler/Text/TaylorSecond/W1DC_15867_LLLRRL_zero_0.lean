  | 2 => ⟨(204 : ℤ), (-234834180023704253103271570416288438598109457971910326836219 : ℤ), (1067815883257289005794726588347981383746540056736989884375334 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
