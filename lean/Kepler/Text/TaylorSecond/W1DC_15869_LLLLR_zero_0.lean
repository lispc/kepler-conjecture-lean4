theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(205 : ℤ), (195650302412214713594279057587077465254510310941503107450189 : ℤ), (1150527114321178203556410470004176480975237724451805366502145 : ℤ)⟩ from rfl]
