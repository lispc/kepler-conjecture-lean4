theorem G1_eq : G 1 = Box.JTop.part 1 := by
  rw [show G 1 = ⟨(206 : ℤ), (331389009184898289763355847430047172894504479723073431288144 : ℤ), (1076694014898384840788436262572591117101714807690421553880322 : ℤ)⟩ from rfl]
  exact Box.p1_Top.symm

