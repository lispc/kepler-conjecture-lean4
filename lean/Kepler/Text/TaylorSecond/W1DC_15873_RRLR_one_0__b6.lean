/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(206 : ℤ), (1490107359258894106305580974904167398597633633582679676061267 : ℤ), (1490108290379147673857415002219796109605816723809802470190055 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(207 : ℤ), (-357248204818568419537857588272428754268775925858176115501375 : ℤ), (1102929115069123507842214040449816444637698201744664263972887 : ℤ)⟩
  | 1 => ⟨(206 : ℤ), (331389009184898289763355847430047172894504479723073431288144 : ℤ), (1076694014898384840788436262572591117101714807690421553880322 : ℤ)⟩
  | 2 => ⟨(205 : ℤ), (463353815674920228212574587593188375134031126901250433355932 : ℤ), (822375276114411406406585428574332952523235128867336436565436 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(207 : ℤ), (-357248204818568419537857588272428754268775925858176115501375 : ℤ), (1102929115069123507842214040449816444637698201744664263972887 : ℤ)⟩ from rfl]
