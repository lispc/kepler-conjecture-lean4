/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(206 : ℤ), (1111009026336206709596845942429370850263586462798471060542232 : ℤ), (1111060078101808652672558434830359279751861380186772857261188 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(204 : ℤ), (126776114676517780420510084907382289993462238765607122585074 : ℤ), (816225894454901913315867337128027702675503551428069722667783 : ℤ)⟩
  | 1 => ⟨(205 : ℤ), (-203460025935929521435411774015501111298872687482150614155683 : ℤ), (1573508071258625225242406595414794788280651312243451711613460 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (33203402253292693688340214154614379054416557389561427030084 : ℤ), (944153583336803257640237208951696991502826749375786332976640 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(204 : ℤ), (126776114676517780420510084907382289993462238765607122585074 : ℤ), (816225894454901913315867337128027702675503551428069722667783 : ℤ)⟩ from rfl]
