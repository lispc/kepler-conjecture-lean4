theorem G1_eq : G 1 = Box.JTop.part 1 := by
  rw [show G 1 = ⟨(205 : ℤ), (-203460025935929521435411774015501111298872687482150614155683 : ℤ), (1573508071258625225242406595414794788280651312243451711613460 : ℤ)⟩ from rfl]
  exact Box.p1_Top.symm

