/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(206 : ℤ), (1154403321437982385963028880025657550038236212893677217654667 : ℤ), (1154410325791315196051761906568386088791101184672276320563093 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(205 : ℤ), (70332229122795329982040419003002674716800619858196114370562 : ℤ), (1345169779475181406469626954570428638676105843056293673475783 : ℤ)⟩
  | 1 => ⟨(205 : ℤ), (-236016204026082860153283013640534638818617022614363859454598 : ℤ), (1275750559123330013847898815469834790059623698127106808907202 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (186328539502493351661992802266830859573218831611167093952890 : ℤ), (925424937911728667194851572560370123799187921970782917196130 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(205 : ℤ), (70332229122795329982040419003002674716800619858196114370562 : ℤ), (1345169779475181406469626954570428638676105843056293673475783 : ℤ)⟩ from rfl]
