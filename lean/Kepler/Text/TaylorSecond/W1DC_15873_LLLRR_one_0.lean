/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(207 : ℤ), (1593388083543114824566029629537209043010518554560322447032687 : ℤ), (1593406289053418188129420551947452289677304260468070757607672 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(204 : ℤ), (-877146240335756259802953760026843477674544513603804975542894 : ℤ), (658275748734340921331893679788591720905577418077773373022837 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (-244782347239211792573446969935781304697595541443803081319013 : ℤ), (1112648740765497373243123890421024928563828383212218867653172 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (-84016534938671310784882232431044868134491804618654132727647 : ℤ), (1219943646024938670523242945417517066821249535897941691203005 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(204 : ℤ), (-877146240335756259802953760026843477674544513603804975542894 : ℤ), (658275748734340921331893679788591720905577418077773373022837 : ℤ)⟩ from rfl]
