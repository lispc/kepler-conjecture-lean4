/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(206 : ℤ), (1518994993484702065128979150264940742314649835182397924021883 : ℤ), (1518995937806791657664663251898406677159323413464061802482113 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(204 : ℤ), (-283704674122855241648264530090711105114145481315577143409889 : ℤ), (1004031783456769832978947962194129509439855533332185066481353 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (-543724387405827294652463028311099027145438367057720336871273 : ℤ), (1003460610134261017847802295652374912116455849578122135926236 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (-407637129523284117753857510021488371757476591896338336114261 : ℤ), (1112443973456562641580882432489206863849452399038019824155731 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(204 : ℤ), (-283704674122855241648264530090711105114145481315577143409889 : ℤ), (1004031783456769832978947962194129509439855533332185066481353 : ℤ)⟩ from rfl]
  exact Box.p0_Top.symm

theorem G1_eq : G 1 = Box.JTop.part 1 := by
  rw [show G 1 = ⟨(204 : ℤ), (-543724387405827294652463028311099027145438367057720336871273 : ℤ), (1003460610134261017847802295652374912116455849578122135926236 : ℤ)⟩ from rfl]
  exact Box.p1_Top.symm

