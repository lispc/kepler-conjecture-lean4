  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(204 : ℤ), (-264164637501502915763881376531840416626774584664494107834992 : ℤ), (1104941150486008501413783307296232942304664199424954758850346 : ℤ)⟩ from rfl]
