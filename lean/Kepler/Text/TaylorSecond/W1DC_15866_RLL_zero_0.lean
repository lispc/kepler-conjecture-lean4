  | 1 => ⟨(204 : ℤ), (-471493617962810916471547101933523010188907804019868358442343 : ℤ), (1119157130114767798125888465075660930192090869781567427085412 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (-471493617963149931235539489495543719974925034092657634568806 : ℤ), (1119157130113914942196105775668464599085308356219921275975953 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
