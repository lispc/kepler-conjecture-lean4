needs at the hull endpoints (they may be negative — the Dlt-crossing boxes).  It
generalises the landed `contDiffAt_matan_of_pos` (`t > 0` only) to the whole
domain, including the removable singularity at `0` (`matanD 0 = -1/3`).
Nothing about `matan` is re-proved here. -/

/-! ### 2c. The hull jet (`dMatanMono` value, `dMatanDHull·∂f` partial) -/

/-- The M9 `matan` jet: value from the endpoint-monotone hull `dMatanMono`
(K1), partial from the monotone derivative hull `dMatanDHull` (K4) — the DC
counterpart of `DCJetKit.matanWith`, with no `1/(2r)` interval formula. -/
def matanHull (J : DCJet) (MvLo MvHi GHull : DC) : DCJet :=
  ⟨dMatanMono J.value MvLo MvHi, fun i => dMul GHull (J.part i)⟩

theorem matanHull_mem {J : DCJet} {f : (Fin 3 → ℝ) → ℝ} {D : Set (Fin 3 → ℝ)}
    {MvLo MvHi GHull : DC} (hJ : JetMem J f D)
    (hlo1 : dLoGt J.value (dInt (-1)) = true)
    (hMvLo : MvLo.mem (matan ((J.value.lo : ℝ) * (2:ℝ)^(-(J.value.k:ℤ)))))
    (hMvHi : MvHi.mem (matan ((J.value.hi : ℝ) * (2:ℝ)^(-(J.value.k:ℤ)))))
    (hG : ∀ r, J.value.mem r → GHull.mem (deriv matan r)) :
    JetMem (matanHull J MvLo MvHi GHull) (fun x => matan (f x)) D := by
  obtain ⟨h1, h2, h3⟩ := hJ
  have hlo1R : -1 < (J.value.lo : ℝ) * (2:ℝ)^(-(J.value.k:ℤ)) := by
    simpa [dInt] using dLoGt_sound hlo1
  have hmat : ∀ x ∈ D, ContDiffAt ℝ 1 matan (f x) := fun x hx =>
    contDiffAt_matan_gt (lt_of_lt_of_le hlo1R (h2 x hx).1)
  refine ⟨fun x hx => (hmat x hx).comp x (h1 x hx), fun x hx => ?_, fun x hx i => ?_⟩
  · exact dMatanMono_mem (h2 x hx) hlo1R hMvLo hMvHi
  · have hcomp : partial1 i (matan ∘ f) x = deriv matan (f x) * partial1 i f x :=
      partial1_comp (hmat x hx) (h1 x hx) i
    have htarget : partial1 i (fun y => matan (f y)) x
        = deriv matan (f x) * partial1 i f x := by
      have hfun : (fun y => matan (f y)) = matan ∘ f := rfl
      rw [hfun, hcomp]
    rw [htarget]
    exact dMul_mem (hG (f x) (h2 x hx)) (h3 x hx i)

#print axioms matanHull_mem


