theorem delta_mono_y5_wide {y4 y5 y5' y6 : ℝ}
    (hy4 : 2.4618 ≤ y4) (hy5 : 2 ≤ y5) (hy5' : 2 ≤ y5') (hy5le : y5' ≤ y5)
    (hy6 : 2 ≤ y6) :
