theorem G1_eq : G 1 = Box.JTop.part 1 := by
  rw [show G 1 = ⟨(204 : ℤ), (475496649421532014031099346058086933197641984999507598200830 : ℤ), (952969946115318014159791188800596866259924912553673404825374 : ℤ)⟩ from rfl]
