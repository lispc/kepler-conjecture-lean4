theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(205 : ℤ), (124480329847745442985479263690634943063879712386864585683110 : ℤ), (1023132507086289928126980731757244993492210732807457355939831 : ℤ)⟩ from rfl]
