  | 2 => ⟨(204 : ℤ), (470553202926648512953542700404446555440277928604624472930083 : ℤ), (937070318490153985305534224683937054749986250465097797790519 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
