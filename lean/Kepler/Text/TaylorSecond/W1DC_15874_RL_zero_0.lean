theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(204 : ℤ), (72454701198619926401925700148231983237009345359337025670641 : ℤ), (833558042215399060992659183051572928900716366874535431187835 : ℤ)⟩ from rfl]
