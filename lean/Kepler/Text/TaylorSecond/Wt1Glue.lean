/-
Kepler.Text.TaylorSecond.Wt1Glue — lane `wt1-glue-w1` (2026-11-25).

Pure-geometry cover of the wt1 hcore region

  `2*hminus <= y4 <= 2*hplus`, `2 <= y5 <= 2*hminus`, `2 <= y6 <= 2*hminus`

by the four emission layers

  9 root boxes -> 597 x=y^2 split-tree leaves -> 173 merge boxes
               -> 221 certificate boxes (137 merged + 84 refine leaves).

Every covering step is a `by_cases` on one coordinate against a rational
endpoint (`le_total`), followed by endpoint transport inside the `Box3.Mem`
structure; the only arithmetic is `norm_num` on closed rational literals.
Sibling split-tree leaves overlap by exactly 1e-18 (outward y rounding), which
is the comparison discharged at each internal node (`R.ylo <= L.yhi`); no
square root is ever computed.

ROOT COVER.  The 9 root boxes were emitted against the *18-digit* pinning

  `2.46350884418000923 <= 2*hminus <= 2.463508844180643489`

(true value `2*hminus = 2.46350884418060878...`, margins 6.0e-13 / 3.5e-14),
which is exactly `two_hminus_bounds_tight18` (HminusTight18, commit e8163547).
The earlier 16-digit `two_hminus_bounds_tight` pair
`[2.463508844180009, 2.4635088441806436]` is 2.3e-16 / 1.11e-16 coarser on the
two sides and leaves two 1e-16 slivers uncovered (exact-rational sweep: 229
grid cells); the 18-digit form is therefore the one consumed here.  No box
endpoint is changed anywhere.

No `axiom` / `sorry` / `admit` / `native_decide`; audited at the tail.
-/
import Kepler.Text.PackingAuto2
import Kepler.Text.TaylorSecond.HminusTight18
import Mathlib.Tactic.NormNum

set_option maxHeartbeats 16000000
set_option maxRecDepth 100000
set_option linter.unusedVariables false

namespace Kepler.Text.TaylorSecond

open Kepler.Text

/-! ## 1. Rational-endpoint boxes and membership -/

/-- Axis-aligned box in `(y4, y5, y6)` space with exact rational endpoints. -/
structure Box3 where
  x4lo : ℚ
  x4hi : ℚ
  x5lo : ℚ
  x5hi : ℚ
  x6lo : ℚ
  x6hi : ℚ

namespace Box3

/-- Pure real-inequality membership in a rational box. -/
structure Mem (b : Box3) (y4 y5 y6 : ℝ) : Prop where
  h4lo : ((b.x4lo : ℚ) : ℝ) ≤ y4
  h4hi : y4 ≤ ((b.x4hi : ℚ) : ℝ)
  h5lo : ((b.x5lo : ℚ) : ℝ) ≤ y5
  h5hi : y5 ≤ ((b.x5hi : ℚ) : ℝ)
  h6lo : ((b.x6lo : ℚ) : ℝ) ≤ y6
  h6hi : y6 ≤ ((b.x6hi : ℚ) : ℝ)

/-- Monotonicity: shrinking the endpoints preserves membership. -/
theorem mem_mono {b b' : Box3} {y4 y5 y6 : ℝ} (h : b.Mem y4 y5 y6)
    (h4l : b'.x4lo ≤ b.x4lo) (h4h : b.x4hi ≤ b'.x4hi)
    (h5l : b'.x5lo ≤ b.x5lo) (h5h : b.x5hi ≤ b'.x5hi)
    (h6l : b'.x6lo ≤ b.x6lo) (h6h : b.x6hi ≤ b'.x6hi) : b'.Mem y4 y5 y6 :=
  ⟨le_trans (by exact_mod_cast h4l) h.h4lo, le_trans h.h4hi (by exact_mod_cast h4h),
   le_trans (by exact_mod_cast h5l) h.h5lo, le_trans h.h5hi (by exact_mod_cast h5h),
   le_trans (by exact_mod_cast h6l) h.h6lo, le_trans h.h6hi (by exact_mod_cast h6h)⟩

/-! ### Split transfer (one lemma per axis and side) -/

theorem mem_split_hi_4 {b : Box3} {q : ℚ} {y4 y5 y6 : ℝ}
    (h : b.Mem y4 y5 y6) (hq : y4 ≤ ((q : ℚ) : ℝ)) :
    (⟨b.x4lo, q, b.x5lo, b.x5hi, b.x6lo, b.x6hi⟩ : Box3).Mem y4 y5 y6 :=
  ⟨h.h4lo, hq, h.h5lo, h.h5hi, h.h6lo, h.h6hi⟩

theorem mem_split_lo_4 {b : Box3} {q : ℚ} {y4 y5 y6 : ℝ}
    (h : b.Mem y4 y5 y6) (hq : ((q : ℚ) : ℝ) ≤ y4) :
    (⟨q, b.x4hi, b.x5lo, b.x5hi, b.x6lo, b.x6hi⟩ : Box3).Mem y4 y5 y6 :=
  ⟨hq, h.h4hi, h.h5lo, h.h5hi, h.h6lo, h.h6hi⟩

theorem mem_split_hi_5 {b : Box3} {q : ℚ} {y4 y5 y6 : ℝ}
    (h : b.Mem y4 y5 y6) (hq : y5 ≤ ((q : ℚ) : ℝ)) :
    (⟨b.x4lo, b.x4hi, b.x5lo, q, b.x6lo, b.x6hi⟩ : Box3).Mem y4 y5 y6 :=
  ⟨h.h4lo, h.h4hi, h.h5lo, hq, h.h6lo, h.h6hi⟩

theorem mem_split_lo_5 {b : Box3} {q : ℚ} {y4 y5 y6 : ℝ}
    (h : b.Mem y4 y5 y6) (hq : ((q : ℚ) : ℝ) ≤ y5) :
    (⟨b.x4lo, b.x4hi, q, b.x5hi, b.x6lo, b.x6hi⟩ : Box3).Mem y4 y5 y6 :=
  ⟨h.h4lo, h.h4hi, hq, h.h5hi, h.h6lo, h.h6hi⟩

theorem mem_split_hi_6 {b : Box3} {q : ℚ} {y4 y5 y6 : ℝ}
    (h : b.Mem y4 y5 y6) (hq : y6 ≤ ((q : ℚ) : ℝ)) :
    (⟨b.x4lo, b.x4hi, b.x5lo, b.x5hi, b.x6lo, q⟩ : Box3).Mem y4 y5 y6 :=
  ⟨h.h4lo, h.h4hi, h.h5lo, h.h5hi, h.h6lo, hq⟩

theorem mem_split_lo_6 {b : Box3} {q : ℚ} {y4 y5 y6 : ℝ}
    (h : b.Mem y4 y5 y6) (hq : ((q : ℚ) : ℝ) ≤ y6) :
    (⟨b.x4lo, b.x4hi, b.x5lo, b.x5hi, q, b.x6hi⟩ : Box3).Mem y4 y5 y6 :=
  ⟨h.h4lo, h.h4hi, h.h5lo, h.h5hi, hq, h.h6hi⟩

/-! ### Covering combinator: `mem parent -> mem left ∨ mem right`

The two children share every endpoint with the parent except the split axis,
where the left child ends at `ql` and the right child starts at `qr`; the
sibling overlap hypothesis is exactly `qr <= ql`. -/

theorem split_cover_4 {b : Box3} {ql qr : ℚ}
    (hcov : ((qr : ℚ) : ℝ) ≤ ((ql : ℚ) : ℝ)) {y4 y5 y6 : ℝ}
    (hm : b.Mem y4 y5 y6) :
    (⟨b.x4lo, ql, b.x5lo, b.x5hi, b.x6lo, b.x6hi⟩ : Box3).Mem y4 y5 y6 ∨
    (⟨qr, b.x4hi, b.x5lo, b.x5hi, b.x6lo, b.x6hi⟩ : Box3).Mem y4 y5 y6 := by
  by_cases hb : y4 ≤ ((qr : ℚ) : ℝ)
  · left
    exact ⟨hm.h4lo, le_trans hb hcov, hm.h5lo, hm.h5hi, hm.h6lo, hm.h6hi⟩
  · right
    exact ⟨le_of_lt (lt_of_not_ge hb), hm.h4hi, hm.h5lo, hm.h5hi, hm.h6lo, hm.h6hi⟩

theorem split_cover_5 {b : Box3} {ql qr : ℚ}
    (hcov : ((qr : ℚ) : ℝ) ≤ ((ql : ℚ) : ℝ)) {y4 y5 y6 : ℝ}
    (hm : b.Mem y4 y5 y6) :
    (⟨b.x4lo, b.x4hi, b.x5lo, ql, b.x6lo, b.x6hi⟩ : Box3).Mem y4 y5 y6 ∨
    (⟨b.x4lo, b.x4hi, qr, b.x5hi, b.x6lo, b.x6hi⟩ : Box3).Mem y4 y5 y6 := by
  by_cases hb : y5 ≤ ((qr : ℚ) : ℝ)
  · left
    exact ⟨hm.h4lo, hm.h4hi, hm.h5lo, le_trans hb hcov, hm.h6lo, hm.h6hi⟩
  · right
    exact ⟨hm.h4lo, hm.h4hi, le_of_lt (lt_of_not_ge hb), hm.h5hi, hm.h6lo, hm.h6hi⟩

theorem split_cover_6 {b : Box3} {ql qr : ℚ}
    (hcov : ((qr : ℚ) : ℝ) ≤ ((ql : ℚ) : ℝ)) {y4 y5 y6 : ℝ}
    (hm : b.Mem y4 y5 y6) :
    (⟨b.x4lo, b.x4hi, b.x5lo, b.x5hi, b.x6lo, ql⟩ : Box3).Mem y4 y5 y6 ∨
    (⟨b.x4lo, b.x4hi, b.x5lo, b.x5hi, qr, b.x6hi⟩ : Box3).Mem y4 y5 y6 := by
  by_cases hb : y6 ≤ ((qr : ℚ) : ℝ)
  · left
    exact ⟨hm.h4lo, hm.h4hi, hm.h5lo, hm.h5hi, hm.h6lo, le_trans hb hcov⟩
  · right
    exact ⟨hm.h4lo, hm.h4hi, hm.h5lo, hm.h5hi, le_of_lt (lt_of_not_ge hb), hm.h6hi⟩

end Box3

