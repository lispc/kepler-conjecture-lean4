/-! ## 5. Whole-region certificate cover -/

/-- Composed four-layer cover: hcore region -> one of the 221 certificate boxes. -/
theorem cover_all :
    ∀ y4 y5 y6, 2 * hminus ≤ y4 → y4 ≤ 2 * hplus →
      2 ≤ y5 → y5 ≤ 2 * hminus → 2 ≤ y6 → y6 ≤ 2 * hminus →
      ∃ c : Wt1Case, ∃ b ∈ certsOf c, b.Mem y4 y5 y6 := by
  intro y4 y5 y6 h4lo h4hi h5lo h5hi h6lo h6hi
  obtain ⟨c, hc⟩ := root_cover y4 y5 y6 h4lo h4hi h5lo h5hi h6lo h6hi
  cases c
  · exact ⟨.c15866, cover15866 y4 y5 y6 hc⟩
  · exact ⟨.c15867, cover15867 y4 y5 y6 hc⟩
  · exact ⟨.c15868, cover15868 y4 y5 y6 hc⟩
  · exact ⟨.c15869, cover15869 y4 y5 y6 hc⟩
  · exact ⟨.c15870, cover15870 y4 y5 y6 hc⟩
  · exact ⟨.c15871, cover15871 y4 y5 y6 hc⟩
  · exact ⟨.c15872, cover15872 y4 y5 y6 hc⟩
  · exact ⟨.c15873, cover15873 y4 y5 y6 hc⟩
  · exact ⟨.c15874, cover15874 y4 y5 y6 hc⟩

/-- All 221 certificate boxes in one right-nested list. -/
def allCerts : List Box3 :=
  certs15866 ++ (certs15867 ++ (certs15868 ++ (certs15869 ++ (certs15870 ++ (certs15871 ++ (certs15872 ++ (certs15873 ++ (certs15874))))))))

/-- The flattened certificate list has exactly 221 entries. -/
theorem allCerts_length : allCerts.length = 221 := by
  rfl

/-- Flattened form: the hcore region is covered by `allCerts`. -/
theorem cover_all_flat :
    ∀ y4 y5 y6, 2 * hminus ≤ y4 → y4 ≤ 2 * hplus →
      2 ≤ y5 → y5 ≤ 2 * hminus → 2 ≤ y6 → y6 ≤ 2 * hminus →
      ∃ b ∈ allCerts, b.Mem y4 y5 y6 := by
  intro y4 y5 y6 h4lo h4hi h5lo h5hi h6lo h6hi
  obtain ⟨c, b, hb, hm⟩ := cover_all y4 y5 y6 h4lo h4hi h5lo h5hi h6lo h6hi
  cases c
  · exact ⟨b, List.mem_append_left (certs15867 ++ (certs15868 ++ (certs15869 ++ (certs15870 ++ (certs15871 ++ (certs15872 ++ (certs15873 ++ (certs15874)))))))) hb, hm⟩
  · exact ⟨b, List.mem_append_right (certs15866) (List.mem_append_left (certs15868 ++ (certs15869 ++ (certs15870 ++ (certs15871 ++ (certs15872 ++ (certs15873 ++ (certs15874))))))) (show b ∈ certs15867 from hb)), hm⟩
  · exact ⟨b, List.mem_append_right (certs15866) (List.mem_append_right (certs15867) (List.mem_append_left (certs15869 ++ (certs15870 ++ (certs15871 ++ (certs15872 ++ (certs15873 ++ (certs15874)))))) (show b ∈ certs15868 from hb))), hm⟩
  · exact ⟨b, List.mem_append_right (certs15866) (List.mem_append_right (certs15867) (List.mem_append_right (certs15868) (List.mem_append_left (certs15870 ++ (certs15871 ++ (certs15872 ++ (certs15873 ++ (certs15874))))) (show b ∈ certs15869 from hb)))), hm⟩
  · exact ⟨b, List.mem_append_right (certs15866) (List.mem_append_right (certs15867) (List.mem_append_right (certs15868) (List.mem_append_right (certs15869) (List.mem_append_left (certs15871 ++ (certs15872 ++ (certs15873 ++ (certs15874)))) (show b ∈ certs15870 from hb))))), hm⟩
