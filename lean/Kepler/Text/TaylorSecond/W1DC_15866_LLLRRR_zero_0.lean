/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(206 : ℤ), (1086093101755304941275336005535601986292122092542923546626231 : ℤ), (1086112170525986749643055882408076953874417445412420625068127 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(205 : ℤ), (-55907389458408438940034859059209077823380593538466442891522 : ℤ), (1412311544931259025906453373532097970098727359104640634437767 : ℤ)⟩
  | 1 => ⟨(205 : ℤ), (-201829433320453826084205998626522458921943797491634195475916 : ℤ), (1461070598471442588435892381609254396691193004585808779900490 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (133981015125170753619952345330061595375953887978406549476958 : ℤ), (959014864760958964289030890043506538123462443020865465551919 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(205 : ℤ), (-55907389458408438940034859059209077823380593538466442891522 : ℤ), (1412311544931259025906453373532097970098727359104640634437767 : ℤ)⟩ from rfl]
  exact Box.p0_Top.symm

theorem G1_eq : G 1 = Box.JTop.part 1 := by
  rw [show G 1 = ⟨(205 : ℤ), (-201829433320453826084205998626522458921943797491634195475916 : ℤ), (1461070598471442588435892381609254396691193004585808779900490 : ℤ)⟩ from rfl]
  exact Box.p1_Top.symm

theorem G2_eq : G 2 = Box.JTop.part 2 := by
