/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(208 : ℤ), (283993750984469089056172645012737264364912796581968235360089 : ℤ), (284025082001974551856590843245377448235943175245390673814203 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(205 : ℤ), (220060023857102534142559576745373586258616442820682978307086 : ℤ), (954705511231750260465958524818086258078822120807517909371935 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (540234962144862735799343975436859640391484423304397059520071 : ℤ), (914384135140148509044047909825254794236230361404700771879325 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (535449522047076435714826322269066012348487704830549142780479 : ℤ), (915523171627629622768512663409033472386917429451000926441453 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(205 : ℤ), (220060023857102534142559576745373586258616442820682978307086 : ℤ), (954705511231750260465958524818086258078822120807517909371935 : ℤ)⟩ from rfl]
