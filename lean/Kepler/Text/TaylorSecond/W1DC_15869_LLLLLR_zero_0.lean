theorem G2_eq : G 2 = Box.JTop.part 2 := by
  rw [show G 2 = ⟨(204 : ℤ), (535449522047076435714826322269066012348487704830549142780479 : ℤ), (915523171627629622768512663409033472386917429451000926441453 : ℤ)⟩ from rfl]
