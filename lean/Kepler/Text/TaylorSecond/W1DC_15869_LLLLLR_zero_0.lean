theorem G1_eq : G 1 = Box.JTop.part 1 := by
  rw [show G 1 = ⟨(204 : ℤ), (540234962144862735799343975436859640391484423304397059520071 : ℤ), (914384135140148509044047909825254794236230361404700771879325 : ℤ)⟩ from rfl]
