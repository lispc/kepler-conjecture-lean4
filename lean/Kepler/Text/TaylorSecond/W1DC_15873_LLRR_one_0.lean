  | 2 => ⟨(204 : ℤ), (-68105452600445075912033316401676552296844755094339828945150 : ℤ), (1077258703722650607481424847283771035630413946887052955820571 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(205 : ℤ), (-1505011924467131238155207460560651347553945716954096845018407 : ℤ), (1176744015510396079808566649567187006576272317115634947254194 : ℤ)⟩ from rfl]
