  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(204 : ℤ), (-6013827073701340978040541121864298176325255155010517428316 : ℤ), (855664848117464366148833781760343426309045816832304137967876 : ℤ)⟩ from rfl]
