theorem op_Top : dAdd ⟨(206 : ℤ), (624116611954334938379676979936899869641896438555775546973611 : ℤ), (624226901760777776541632301135123036146341478127194753889079 : ℤ)⟩ (dNeg ⟨(208 : ℤ), (960877852921430277978227187607410691039609437740230936468181 : ℤ), (960914096730588165937436680074961855123719994581298412502771 : ℤ)⟩) = ⟨(208 : ℤ), (1535552351086751587581271239672637623443865759641803775391673 : ℤ), (1536029754121680828188302016933081453545756474768548079088135 : ℤ)⟩ := by
