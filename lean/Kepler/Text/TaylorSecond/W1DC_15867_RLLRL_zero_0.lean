  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(204 : ℤ), (-164171341830690351439584402927940162191828048863134922130158 : ℤ), (862229614605345365779707358863685067535491846344710531682701 : ℤ)⟩ from rfl]
