theorem op_Top : dAdd ⟨(206 : ℤ), (1131303507370012572570155908503153261292763380923891821172393 : ℤ), (1131349662839710318759374097777345005619697423013750790318812 : ℤ)⟩ (dNeg ⟨(209 : ℤ), (1486212218999408636044421005668008569452514980382521904102060 : ℤ), (1486212219075521237060280537136721217892588543828864877006048 : ℤ)⟩) = ⟨(206 : ℤ), (945526979985572417937620841361063109056189812945283711546637 : ℤ), (945573135464784239253821472068843934438133050465935552306055 : ℤ)⟩ := by
