  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(205 : ℤ), (213350344344755995854734153479110316039638643930556464710564 : ℤ), (1511960898165964007288188022447837997163960762365959775902162 : ℤ)⟩ from rfl]
