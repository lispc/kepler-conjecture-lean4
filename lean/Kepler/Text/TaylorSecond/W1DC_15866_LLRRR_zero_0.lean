theorem G1_eq : G 1 = Box.JTop.part 1 := by
  rw [show G 1 = ⟨(205 : ℤ), (-81478391876380462414860650672992462148933516669800771775335 : ℤ), (1377879187766504602716894276969466471764909181166371413298703 : ℤ)⟩ from rfl]
