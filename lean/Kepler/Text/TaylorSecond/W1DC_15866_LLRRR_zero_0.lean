/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(206 : ℤ), (1218636579900100075077067383384369112888683471479206291654268 : ℤ), (1218643116132456889610537211201285237528557602427044385669866 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(205 : ℤ), (57717990720416742650044225241840993277498971368103858103315 : ℤ), (1323435276060990205923519110589484234713220169390872645576089 : ℤ)⟩
  | 1 => ⟨(205 : ℤ), (-81478391876380462414860650672992462148933516669800771775335 : ℤ), (1377879187766504602716894276969466471764909181166371413298703 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (136240288909571395438728022258443020333889358389803963729490 : ℤ), (858865718538158231932202633241280214158673137441801090409139 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(205 : ℤ), (57717990720416742650044225241840993277498971368103858103315 : ℤ), (1323435276060990205923519110589484234713220169390872645576089 : ℤ)⟩ from rfl]
