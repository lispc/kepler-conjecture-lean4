/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(207 : ℤ), (858735814196048543570800746348431392722082542814677144488966 : ℤ), (858776238205752263422758048044441904357467020484951430058391 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(204 : ℤ), (-112637930087070091025250961884475250706292633594858198373902 : ℤ), (812490061364899373175584342572739022203683478107426362132472 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (49370254425437821294817838810316522662683426195046325183541 : ℤ), (1028192296849085826719484847320152480591720522646176178685769 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (110694819153675503801323390831326991013893688232804609605234 : ℤ), (1115569580292900392961230052230473670527548599250133766623771 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(204 : ℤ), (-112637930087070091025250961884475250706292633594858198373902 : ℤ), (812490061364899373175584342572739022203683478107426362132472 : ℤ)⟩ from rfl]
