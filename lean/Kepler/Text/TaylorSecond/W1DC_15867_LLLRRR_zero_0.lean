/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(206 : ℤ), (832005538530438810485121780107964226138845915081244086386655 : ℤ), (832107652254063323227852565177662268262031953116719040132355 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(204 : ℤ), (-212218889589795653100270475372324540311027187757805488791937 : ℤ), (858585434976812247343805469013943152589153016869059399015952 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (-59346463885539031149699335167967540973826199548988438239543 : ℤ), (1059850710315748286106294082183909886474807580982507472751506 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (-136037013150088530294055051701379354945059251593466979106004 : ℤ), (965056142820582340108162289990594031479654053859845411714179 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(204 : ℤ), (-212218889589795653100270475372324540311027187757805488791937 : ℤ), (858585434976812247343805469013943152589153016869059399015952 : ℤ)⟩ from rfl]
