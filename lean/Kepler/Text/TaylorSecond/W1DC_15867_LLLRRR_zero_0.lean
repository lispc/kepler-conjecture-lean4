theorem G1_eq : G 1 = Box.JTop.part 1 := by
  rw [show G 1 = ⟨(204 : ℤ), (-59346463885539031149699335167967540973826199548988438239543 : ℤ), (1059850710315748286106294082183909886474807580982507472751506 : ℤ)⟩ from rfl]
