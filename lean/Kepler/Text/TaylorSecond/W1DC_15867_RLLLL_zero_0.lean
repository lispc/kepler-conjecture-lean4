/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(206 : ℤ), (848368943416240829583653560313078645895436051338482584805901 : ℤ), (848416826161095757473728817768603769266469424853936467065009 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(204 : ℤ), (-22158060531786656471558695604156878727030513342064900346832 : ℤ), (902654732214893328494563998421912689701552091183736957427376 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (82243610635995291905251848763141847557196576699400917361405 : ℤ), (1134222704968795380401433468733049854227056683114706031186693 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (-254937066244248017972254226999228391675363605232465252583629 : ℤ), (835831412802111207585450252051641122841745865296789998413051 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(204 : ℤ), (-22158060531786656471558695604156878727030513342064900346832 : ℤ), (902654732214893328494563998421912689701552091183736957427376 : ℤ)⟩ from rfl]
  exact Box.p0_Top.symm

theorem G1_eq : G 1 = Box.JTop.part 1 := by
  rw [show G 1 = ⟨(204 : ℤ), (82243610635995291905251848763141847557196576699400917361405 : ℤ), (1134222704968795380401433468733049854227056683114706031186693 : ℤ)⟩ from rfl]
  exact Box.p1_Top.symm

theorem G2_eq : G 2 = Box.JTop.part 2 := by
