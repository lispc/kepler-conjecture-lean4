/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(206 : ℤ), (1490732515993254711514520136850123629084157605030671541943034 : ℤ), (1490733427440392109142971853343432778165078815099324727174877 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(204 : ℤ), (126655652456089739286338745643167313045712002814293909003051 : ℤ), (890711611190122642399683827365237403040919771647788458175847 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (-205532777109242281722991369552528763408284205661052448785568 : ℤ), (890700433619362996202643262723304824904594189946626976065401 : ℤ)⟩
  | 2 => ⟨(205 : ℤ), (-474091602194066647846314557249866386329510272366197526129466 : ℤ), (1580746138823096080682006138429008625703448945213368271236922 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(204 : ℤ), (126655652456089739286338745643167313045712002814293909003051 : ℤ), (890711611190122642399683827365237403040919771647788458175847 : ℤ)⟩ from rfl]
