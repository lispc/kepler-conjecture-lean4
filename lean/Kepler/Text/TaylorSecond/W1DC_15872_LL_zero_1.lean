theorem JTop_mem : JetMem JTop fTop Dpt :=
  DCJetKit.sub_mem (JFirstPos_mem) (JNeg2_mem)

theorem op_Top : dAdd ⟨(205 : ℤ), (205506131304751949317406590908273210681145793255069666456399 : ℤ), (205526192551853360048099071833105268085429076508905330863609 : ℤ)⟩ (dNeg ⟨(208 : ℤ), (962451828522807326639289951173732715008149765652091456200229 : ℤ), (962456941277015590065180975421790853373869701514308451479360 : ℤ)⟩) = ⟨(208 : ℤ), (681592109161000004474071751844394832075296644526248880171832 : ℤ), (681757711892019553745502623491109429675282846419151190708643 : ℤ)⟩ := by
