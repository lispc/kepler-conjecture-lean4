  have hk1 : 0 ≤ KZ - 201 - (G 0).k := by linarith [val_facts.1.2.1]
  have hk2 : 0 ≤ KZ - 201 - (G 1).k := by linarith [val_facts.1.2.2.1]
  have hk3 : 0 ≤ KZ - 201 - (G 2).k := by linarith [val_facts.1.2.2.2]
