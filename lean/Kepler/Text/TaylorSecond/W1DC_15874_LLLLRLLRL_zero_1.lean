      zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
  have f1 : (2 : ℝ) ^ (KZ - 201 - (G 1).k) =
      (2 : ℝ) ^ KZ * ((2 : ℝ) ^ (-(201 : ℤ)) * (2 : ℝ) ^ (-((G 1).k))) := by
    rw [show KZ - 201 - (G 1).k = KZ + (-(201 : ℤ) + -((G 1).k)) by ring,
