/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(207 : ℤ), (1462584956937436582077032561720417606116522279151281229138458 : ℤ), (1462615802033017247783195727480909988021302791826754617885275 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(205 : ℤ), (-1527895244780249987326743251603933152709623748604404529669918 : ℤ), (1048513111172553684660705660101445433822477633617622006831591 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (64634875250912091300732754302250292806107174727620576546560 : ℤ), (1174417356983914829959722103872572260417640158932547115638097 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (-172679561781674954896661258011948936001780578559059022657160 : ℤ), (918287430787335632166837992356467555023105049005889152936497 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(205 : ℤ), (-1527895244780249987326743251603933152709623748604404529669918 : ℤ), (1048513111172553684660705660101445433822477633617622006831591 : ℤ)⟩ from rfl]
