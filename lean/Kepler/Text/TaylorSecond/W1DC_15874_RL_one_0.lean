theorem G1_eq : G 1 = Box.JTop.part 1 := by
  rw [show G 1 = ⟨(204 : ℤ), (64634875250912091300732754302250292806107174727620576546560 : ℤ), (1174417356983914829959722103872572260417640158932547115638097 : ℤ)⟩ from rfl]
