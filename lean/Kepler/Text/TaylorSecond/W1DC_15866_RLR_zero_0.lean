/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(206 : ℤ), (1518994993484101021785896251704316702674278099940000223507295 : ℤ), (1518995937806190614768363157424607011344230315651008273394423 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(204 : ℤ), (-283704674122720682715594355757144029981189076340015080924392 : ℤ), (1004031783457023138033349137327464081602310875504200866884151 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (-407637129523050840143849226249270357252365887258034708836939 : ℤ), (1112443973457308728094178013970283595083974390435690092485621 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (-543724387406107365659880048234253850916495496882533336595208 : ℤ), (1003460610133777618926044544471801711413996024564852625108051 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(204 : ℤ), (-283704674122720682715594355757144029981189076340015080924392 : ℤ), (1004031783457023138033349137327464081602310875504200866884151 : ℤ)⟩ from rfl]
