  | 0 => ⟨(204 : ℤ), (-267531894914622325411010625851293035788151780428715201476249 : ℤ), (813337380460222248141507705283723691260811146878321040719376 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (-74937817226094338561162100272870489542615466954869058335118 : ℤ), (1020962021398710142321897422358713440077830314971513992635704 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (29688600294707115498329925544405947772221038602194265067519 : ℤ), (1139036244677344380536918329796526653952627116230889393766031 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(204 : ℤ), (-267531894914622325411010625851293035788151780428715201476249 : ℤ), (813337380460222248141507705283723691260811146878321040719376 : ℤ)⟩ from rfl]
