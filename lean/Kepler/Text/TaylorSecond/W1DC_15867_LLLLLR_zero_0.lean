/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(207 : ℤ), (1182263308884993282093968519499832024520454781582740517980068 : ℤ), (1182309233409000429190259106354222914256243763489260766025228 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(204 : ℤ), (-120780191371559126086439544998052715032608726802563122320648 : ℤ), (938921236617759653220691460937729525463086263338879573370475 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (5437925110582616857803943725892008638279200318899834506563 : ℤ), (1150013345867056265210397848786976138413184686379982715752181 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (-131514051174794291357889740459988392037943166307646119060746 : ℤ), (981008614133425409411033131079237112539922239794352283591181 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(204 : ℤ), (-120780191371559126086439544998052715032608726802563122320648 : ℤ), (938921236617759653220691460937729525463086263338879573370475 : ℤ)⟩ from rfl]
