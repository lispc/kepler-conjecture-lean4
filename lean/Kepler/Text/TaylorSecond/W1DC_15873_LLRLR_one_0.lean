/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(206 : ℤ), (840224632180260894344802038803847172627448569105034849558083 : ℤ), (840233297513694225806089013011806122595419223399129899814069 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(204 : ℤ), (-842031361380784425606512090501877244648094465708281436016448 : ℤ), (636187279870505138376483154938849060004135620672327379739576 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (-125883618335875633931560241650350696158579462700664003928826 : ℤ), (1202044868842233965605812510905367541869668789008961276079928 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (-182188473002351610884042375534318322006886247899508587810186 : ℤ), (1069807437703815355855242138551659479914639525217028068812741 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(204 : ℤ), (-842031361380784425606512090501877244648094465708281436016448 : ℤ), (636187279870505138376483154938849060004135620672327379739576 : ℤ)⟩ from rfl]
