theorem G1_eq : G 1 = Box.JTop.part 1 := by
  rw [show G 1 = ⟨(204 : ℤ), (-125883618335875633931560241650350696158579462700664003928826 : ℤ), (1202044868842233965605812510905367541869668789008961276079928 : ℤ)⟩ from rfl]
  exact Box.p1_Top.symm

