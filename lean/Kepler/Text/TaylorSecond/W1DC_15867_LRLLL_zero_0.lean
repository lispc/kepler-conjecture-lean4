/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(206 : ℤ), (832917023570368115908241505709902828171774418042736020071498 : ℤ), (832950110021672520550649178217122162649830054052963337653944 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(204 : ℤ), (-113785824255178433410065565115332260138929258308520308303951 : ℤ), (960983429693098767141091613668688539654290090900308606972027 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (-123524560615497643149175395051947544091597593933689147879633 : ℤ), (1050860429579598738541518549673893377294857507161367493842014 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (-150760706312344414657788682312142085820502184960516166341525 : ℤ), (1071459503061910503510478742388811773891925128612359756517777 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(204 : ℤ), (-113785824255178433410065565115332260138929258308520308303951 : ℤ), (960983429693098767141091613668688539654290090900308606972027 : ℤ)⟩ from rfl]
