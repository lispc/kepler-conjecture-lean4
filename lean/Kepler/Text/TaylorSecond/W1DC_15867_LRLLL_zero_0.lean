  rw [show G 1 = ⟨(204 : ℤ), (-123524560615497643149175395051947544091597593933689147879633 : ℤ), (1050860429579598738541518549673893377294857507161367493842014 : ℤ)⟩ from rfl]
  exact Box.p1_Top.symm

