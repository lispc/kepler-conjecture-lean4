  | 2 => ⟨(204 : ℤ), (23842317508117304944443581027641911382193281500249101347679 : ℤ), (1242914065392194352691783921990440464104096851508895972081712 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
