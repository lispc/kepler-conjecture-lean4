theorem G1_eq : G 1 = Box.JTop.part 1 := by
  rw [show G 1 = ⟨(204 : ℤ), (-322300487531345338763808715792461067322757879315828695174283 : ℤ), (965124957941551222318161675414102512812982796332878163072532 : ℤ)⟩ from rfl]
