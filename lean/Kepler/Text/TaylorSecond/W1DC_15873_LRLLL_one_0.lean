/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(207 : ℤ), (1583125079808054657323160920658597603369133175967922617497349 : ℤ), (1583192201814136563490741174472017161245589733818543998389512 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(205 : ℤ), (-1559696791692281032214455836486147068633830941741409251607828 : ℤ), (1261607737942083065041783965692252802999070580918993499812895 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (-322300487531345338763808715792461067322757879315828695174283 : ℤ), (965124957941551222318161675414102512812982796332878163072532 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (23842317508117304944443581027641911382193281500249101347679 : ℤ), (1242914065392194352691783921990440464104096851508895972081712 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(205 : ℤ), (-1559696791692281032214455836486147068633830941741409251607828 : ℤ), (1261607737942083065041783965692252802999070580918993499812895 : ℤ)⟩ from rfl]
