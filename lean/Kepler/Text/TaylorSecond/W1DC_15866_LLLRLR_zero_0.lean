/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(206 : ℤ), (999926556735955128431153469052078641284037367120612809567600 : ℤ), (999971280154103149669773400280316212957643891515623084948923 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(205 : ℤ), (-206733610549974193109433424617757751729429615317511578337321 : ℤ), (1520429468898033491979646707479760671871869880022631674430712 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (-112000081885643315209065251324847378733663420268304684623094 : ℤ), (830704740787236178064197679103836326163930865737829329364989 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (61128218537938604319684134060201576580802107437973590961873 : ℤ), (1003032981448131168956609545408645988823200540345118147574092 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(205 : ℤ), (-206733610549974193109433424617757751729429615317511578337321 : ℤ), (1520429468898033491979646707479760671871869880022631674430712 : ℤ)⟩ from rfl]
  exact Box.p0_Top.symm

theorem G1_eq : G 1 = Box.JTop.part 1 := by
  rw [show G 1 = ⟨(204 : ℤ), (-112000081885643315209065251324847378733663420268304684623094 : ℤ), (830704740787236178064197679103836326163930865737829329364989 : ℤ)⟩ from rfl]
  exact Box.p1_Top.symm

theorem G2_eq : G 2 = Box.JTop.part 2 := by
