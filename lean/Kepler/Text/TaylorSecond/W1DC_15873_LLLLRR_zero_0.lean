theorem G2_eq : G 2 = Box.JTop.part 2 := by
  rw [show G 2 = ⟨(204 : ℤ), (261649701633917101033759265835552603657871323304455069044870 : ℤ), (889709971298949432904873292576579314840263685718963275130423 : ℤ)⟩ from rfl]
