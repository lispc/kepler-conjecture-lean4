  rw [show G 1 = ⟨(204 : ℤ), (201210170787530535332547228829444482792002574178961783718809 : ℤ), (1141900282418429350647758730578416766187303113745947138339581 : ℤ)⟩ from rfl]
  exact Box.p1_Top.symm

theorem G2_eq : G 2 = Box.JTop.part 2 := by
  rw [show G 2 = ⟨(204 : ℤ), (210587663623750093611114919182020775295315978081947059091611 : ℤ), (1139348558751823662579717976815953358916503655299216860738096 : ℤ)⟩ from rfl]
