  | 2 => ⟨(204 : ℤ), (-299123909315555553327934515457184498098638858542887726600827 : ℤ), (1006930342521147747362944725968910306340348404515179603514572 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
