theorem G1_eq : G 1 = Box.JTop.part 1 := by
  rw [show G 1 = ⟨(205 : ℤ), (-402776274823618676817111042960395938435165185018534811749111 : ℤ), (1149077909740933989373837448805686954916437967516970327189440 : ℤ)⟩ from rfl]
  exact Box.p1_Top.symm

