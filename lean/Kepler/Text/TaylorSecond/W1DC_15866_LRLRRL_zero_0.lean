/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(206 : ℤ), (1056201822399525319288656962112024524741619729748080551675731 : ℤ), (1056208929505713797639419848975421607594774382636383114826928 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(205 : ℤ), (108065265073935320507259673041020951902061487537984766264979 : ℤ), (1359191668059124014758531021513870918191204958448778219817167 : ℤ)⟩
  | 1 => ⟨(205 : ℤ), (-402776274823618676817111042960395938435165185018534811749111 : ℤ), (1149077909740933989373837448805686954916437967516970327189440 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (247674751155915999822243226976886087690277409797372920404648 : ℤ), (988500586866476958238650632980517038034807594118400031237231 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(205 : ℤ), (108065265073935320507259673041020951902061487537984766264979 : ℤ), (1359191668059124014758531021513870918191204958448778219817167 : ℤ)⟩ from rfl]
