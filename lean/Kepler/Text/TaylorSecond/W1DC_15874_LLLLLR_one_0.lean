  have e0 : (2 : ℝ) ^ (KZ - V.k) = (2 : ℝ) ^ KZ * (2 : ℝ) ^ (-(V.k)) := by
    rw [show KZ - V.k = KZ + (-(V.k)) by ring, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
