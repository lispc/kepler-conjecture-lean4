/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(207 : ℤ), (1337238781135103479746697029426859514912933571374657179632250 : ℤ), (1337421787119566436299198099130842470951405813940473742774864 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(204 : ℤ), (-291149457514120169305063202859755999049248911498754348051852 : ℤ), (967553081360495693505186365255278886058570078295408890153063 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (-251255136172555753577189788836996168356310171598218346063135 : ℤ), (1003737316108576513749123881185845271365283189456032045623267 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (-99108373723006968321043834340353070514260050484611986650927 : ℤ), (1163242286387069144146475005107889398957148477805512995570921 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(204 : ℤ), (-291149457514120169305063202859755999049248911498754348051852 : ℤ), (967553081360495693505186365255278886058570078295408890153063 : ℤ)⟩ from rfl]
