theorem G1_eq : G 1 = Box.JTop.part 1 := by
  rw [show G 1 = ⟨(204 : ℤ), (-251255136172555753577189788836996168356310171598218346063135 : ℤ), (1003737316108576513749123881185845271365283189456032045623267 : ℤ)⟩ from rfl]
  exact Box.p1_Top.symm

theorem G2_eq : G 2 = Box.JTop.part 2 := by
  rw [show G 2 = ⟨(204 : ℤ), (-99108373723006968321043834340353070514260050484611986650927 : ℤ), (1163242286387069144146475005107889398957148477805512995570921 : ℤ)⟩ from rfl]
