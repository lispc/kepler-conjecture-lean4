/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(206 : ℤ), (853454123556223187608537336971142920281989252600860246392992 : ℤ), (853543070442384108164728038867533291854810983891188818575034 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(204 : ℤ), (-274744873174846650381900315095685645055559088302805704751512 : ℤ), (954117706176578324885690629741188094472868812833652149903584 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (-286614516162207889758084103996511583505461751042246870458343 : ℤ), (1024236800194052906718040304878133955769348081471850142848601 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (-148333265924251147184322547991745821676658165379407071816509 : ℤ), (1120338456250719091908131983911731005325217377441290618685059 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(204 : ℤ), (-274744873174846650381900315095685645055559088302805704751512 : ℤ), (954117706176578324885690629741188094472868812833652149903584 : ℤ)⟩ from rfl]
  exact Box.p0_Top.symm

theorem G1_eq : G 1 = Box.JTop.part 1 := by
  rw [show G 1 = ⟨(204 : ℤ), (-286614516162207889758084103996511583505461751042246870458343 : ℤ), (1024236800194052906718040304878133955769348081471850142848601 : ℤ)⟩ from rfl]
  exact Box.p1_Top.symm

