theorem G1_eq : G 1 = Box.JTop.part 1 := by
  rw [show G 1 = ⟨(204 : ℤ), (-263673505377312831149667143090539627025038640291261622741676 : ℤ), (1038971500906069535983615140050318031165438969524756221532798 : ℤ)⟩ from rfl]
  exact Box.p1_Top.symm

