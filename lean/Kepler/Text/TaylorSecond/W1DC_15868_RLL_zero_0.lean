/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(207 : ℤ), (1252450790487650085915595390536677435846703478974794216532322 : ℤ), (1252508890441657723816513952881367753246625855762840347021156 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(204 : ℤ), (-168711477409953726631506875828199364939285075726000635799989 : ℤ), (1026776161656581432814549211459787593763180770981445016657342 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (-263673505377312831149667143090539627025038640291261622741676 : ℤ), (1038971500906069535983615140050318031165438969524756221532798 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (-70800018034258964041726056233905230855238754685143548618444 : ℤ), (1206857283688350822945532822350803985002040075897591624465197 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(204 : ℤ), (-168711477409953726631506875828199364939285075726000635799989 : ℤ), (1026776161656581432814549211459787593763180770981445016657342 : ℤ)⟩ from rfl]
