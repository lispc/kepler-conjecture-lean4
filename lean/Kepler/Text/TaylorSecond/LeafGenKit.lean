  exact (QInterval.mem_mul (QInterval.mem_neg h_K1) h_sumSEDD)

theorem g_pos_mem (y4 y5 y6 : ℝ) (IK2 : QInterval) (Ipq1 : QInterval) (Ipq2 : QInterval) (Ipq3 : QInterval) (Ipq4 : QInterval) (h_K2 : IK2.mem ((8 * mm2 / Real.pi))) (h_pq1 : Ipq1.mem ((lfun (y4 * 0.5) * h0cut y4 * w1DIHCDD y4 y5 y6))) (h_pq2 : Ipq2.mem ((2 * (-(25 / 13)) * w1DIHAD y4 y5 y6))) (h_pq3 : Ipq3.mem ((lfun (y5 * 0.5) * w1DIHADD y4 y5 y6))) (h_pq4 : Ipq4.mem ((lfun (y6 * 0.5) * w1DIHBDD y4 y5 y6))) :
    (gtree_pos IK2 Ipq1 Ipq2 Ipq3 Ipq4).mem
      (((8 * mm2 / Real.pi) * (((lfun (y4 * 0.5) * h0cut y4 * w1DIHCDD y4 y5 y6) + ((2 * (-(25 / 13)) * w1DIHAD y4 y5 y6) + (lfun (y5 * 0.5) * w1DIHADD y4 y5 y6))) + (lfun (y6 * 0.5) * w1DIHBDD y4 y5 y6)))) := by
  exact (QInterval.mem_mul h_K2 (QInterval.mem_add (QInterval.mem_add h_pq1 (QInterval.mem_add h_pq2 h_pq3)) h_pq4))

theorem g_neg2_mem (y4 y5 y6 : ℝ) (Ic008I : QInterval) (IDIHCDD : QInterval) (h_c008I : Ic008I.mem ((0.008 : ℝ))) (h_DIHCDD : IDIHCDD.mem (w1DIHCDD y4 y5 y6)) :
    (gtree_neg2 Ic008I IDIHCDD).mem
      (((0.008 : ℝ) * w1DIHCDD y4 y5 y6)) := by
  exact (QInterval.mem_mul h_c008I h_DIHCDD)

theorem g_D11_mem (y4 y5 y6 : ℝ) (Ineg1 : QInterval) (Ipos : QInterval) (Ineg2 : QInterval) (h_neg1 : Ineg1.mem ((-(2 * mm1 / Real.pi) * (w1SEADD y4 y5 y6 + w1SEBDD y4 y5 y6 + w1SECDD y4 y5 y6)))) (h_pos : Ipos.mem (((8 * mm2 / Real.pi) * (lfun (y4 * 0.5) * h0cut y4 * w1DIHCDD y4 y5 y6 + (2 * (-(25 / 13)) * w1DIHAD y4 y5 y6 + lfun (y5 * 0.5) * w1DIHADD y4 y5 y6) + lfun (y6 * 0.5) * w1DIHBDD y4 y5 y6)))) (h_neg2 : Ineg2.mem ((0.008 * w1DIHCDD y4 y5 y6))) :
    (gtree_D11 Ineg1 Ipos Ineg2).mem
      ((((-(2 * mm1 / Real.pi) * (w1SEADD y4 y5 y6 + w1SEBDD y4 y5 y6 + w1SECDD y4 y5 y6)) + ((8 * mm2 / Real.pi) * (lfun (y4 * 0.5) * h0cut y4 * w1DIHCDD y4 y5 y6 + (2 * (-(25 / 13)) * w1DIHAD y4 y5 y6 + lfun (y5 * 0.5) * w1DIHADD y4 y5 y6) + lfun (y6 * 0.5) * w1DIHBDD y4 y5 y6))) - (0.008 * w1DIHCDD y4 y5 y6))) := by
  exact (QInterval.mem_sub (QInterval.mem_add h_neg1 h_pos) h_neg2)

/-! ## 2. matan slot-range kit -/

/-- `matan` value on a whole slot interval, from the two point brackets. -/
theorem g_m_vf (TI Plo Phi : QInterval) (hpos : (0:ℚ) < TI.lo)
    (hPlo : Plo.mem (matan ((TI.lo : ℚ) : ℝ)))
    (hPhi : Phi.mem (matan ((TI.hi : ℚ) : ℝ))) :
    ∀ t : ℝ, ((TI.lo : ℚ) : ℝ) ≤ t → t ≤ ((TI.hi : ℚ) : ℝ) →
      (gM Plo Phi).mem (matan t) := by
  intro t h1 h2
  have hp0 : (0:ℝ) < ((TI.lo : ℚ) : ℝ) := by exact_mod_cast hpos
  exact lk_matan_val_transport ((TI.lo : ℚ) : ℝ) ((TI.hi : ℚ) : ℝ) t hp0 h1 h2
    Plo Phi hPlo hPhi

/-- `matanD` on a whole slot interval (pure interval ops). -/
theorem g_mD_vf (TI VI : QInterval) (hpos : (0:ℚ) < TI.lo)
    (horder : TI.lo ≤ TI.hi)
    (hVI : ∀ t : ℝ, ((TI.lo : ℚ) : ℝ) ≤ t → t ≤ ((TI.hi : ℚ) : ℝ) →
      VI.mem (matan t)) :
    ∀ t : ℝ, ((TI.lo : ℚ) : ℝ) ≤ t → t ≤ ((TI.hi : ℚ) : ℝ) →
      (gMD TI VI).mem (matanD t) :=
  lk_matanD_ops TI VI hpos horder hVI

/-- `matanDD` on a whole slot interval, from the two point brackets. -/
theorem g_mDD_vf (TI : QInterval) (Dl Dh : QInterval)
    (hpos : (0:ℚ) < TI.lo)
    (hDl : Dl.mem (matanDD ((TI.lo : ℚ) : ℝ)))
    (hDh : Dh.mem (matanDD ((TI.hi : ℚ) : ℝ))) :
    ∀ t : ℝ, ((TI.lo : ℚ) : ℝ) ≤ t → t ≤ ((TI.hi : ℚ) : ℝ) →
      (gMDD Dl Dh).mem (matanDD t) := by
  intro t h1 h2
  have hp0 : (0:ℝ) < ((TI.lo : ℚ) : ℝ) := by exact_mod_cast hpos
  exact lk_matanDD_transport ((TI.lo : ℚ) : ℝ) ((TI.hi : ℚ) : ℝ) t hp0 h1 h2
    Dl Dh hDl hDh

/-! ## 3. Eight-way terminal glue -/

/-- Bit convention: `ijk` with `i = 1` meaning `x 0` lies in the upper half
(`m4 ≤ x 0`), and so on. -/
theorem g_terminal3 {P : (Fin 3 → ℝ) → Prop}
    {a4 b4 a5 b5 a6 b6 m4 m5 m6 : ℝ}
    (h000 : ∀ x : Fin 3 → ℝ, a4 ≤ x 0 → x 0 ≤ m4 → a5 ≤ x 1 → x 1 ≤ m5 →
      a6 ≤ x 2 → x 2 ≤ m6 → P x)
    (h001 : ∀ x : Fin 3 → ℝ, a4 ≤ x 0 → x 0 ≤ m4 → a5 ≤ x 1 → x 1 ≤ m5 →
      m6 ≤ x 2 → x 2 ≤ b6 → P x)
    (h010 : ∀ x : Fin 3 → ℝ, a4 ≤ x 0 → x 0 ≤ m4 → m5 ≤ x 1 → x 1 ≤ b5 →
      a6 ≤ x 2 → x 2 ≤ m6 → P x)
    (h011 : ∀ x : Fin 3 → ℝ, a4 ≤ x 0 → x 0 ≤ m4 → m5 ≤ x 1 → x 1 ≤ b5 →
      m6 ≤ x 2 → x 2 ≤ b6 → P x)
    (h100 : ∀ x : Fin 3 → ℝ, m4 ≤ x 0 → x 0 ≤ b4 → a5 ≤ x 1 → x 1 ≤ m5 →
      a6 ≤ x 2 → x 2 ≤ m6 → P x)
    (h101 : ∀ x : Fin 3 → ℝ, m4 ≤ x 0 → x 0 ≤ b4 → a5 ≤ x 1 → x 1 ≤ m5 →
      m6 ≤ x 2 → x 2 ≤ b6 → P x)
    (h110 : ∀ x : Fin 3 → ℝ, m4 ≤ x 0 → x 0 ≤ b4 → m5 ≤ x 1 → x 1 ≤ b5 →
      a6 ≤ x 2 → x 2 ≤ m6 → P x)
    (h111 : ∀ x : Fin 3 → ℝ, m4 ≤ x 0 → x 0 ≤ b4 → m5 ≤ x 1 → x 1 ≤ b5 →
      m6 ≤ x 2 → x 2 ≤ b6 → P x)
    (x : Fin 3 → ℝ)
    (hx0 : a4 ≤ x 0) (hx1 : x 0 ≤ b4) (hx2 : a5 ≤ x 1) (hx3 : x 1 ≤ b5)
    (hx4 : a6 ≤ x 2) (hx5 : x 2 ≤ b6) : P x := by
  by_cases c4 : x 0 ≤ m4
  · by_cases c5 : x 1 ≤ m5
    · by_cases c6 : x 2 ≤ m6
      · exact h000 x hx0 c4 hx2 c5 hx4 c6
      · exact h001 x hx0 c4 hx2 c5 (le_of_lt (lt_of_not_ge c6)) hx5
    · by_cases c6 : x 2 ≤ m6
      · exact h010 x hx0 c4 (le_of_lt (lt_of_not_ge c5)) hx3 hx4 c6
      · exact h011 x hx0 c4 (le_of_lt (lt_of_not_ge c5)) hx3
          (le_of_lt (lt_of_not_ge c6)) hx5
  · by_cases c5 : x 1 ≤ m5
    · by_cases c6 : x 2 ≤ m6
      · exact h100 x (le_of_lt (lt_of_not_ge c4)) hx1 hx2 c5 hx4 c6
      · exact h101 x (le_of_lt (lt_of_not_ge c4)) hx1 hx2 c5
          (le_of_lt (lt_of_not_ge c6)) hx5
    · by_cases c6 : x 2 ≤ m6
      · exact h110 x (le_of_lt (lt_of_not_ge c4)) hx1
          (le_of_lt (lt_of_not_ge c5)) hx3 hx4 c6
      · exact h111 x (le_of_lt (lt_of_not_ge c4)) hx1
          (le_of_lt (lt_of_not_ge c5)) hx3 (le_of_lt (lt_of_not_ge c6)) hx5

