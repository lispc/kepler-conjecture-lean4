/-! ## 0a. Positivity combinators -/

/-- Positive `QInterval.mul` (both endpoints of both factors). -/
theorem g_pos_mul_pair (I J : QInterval)
    (hI : (0:ℚ) < I.lo ∧ (0:ℚ) < I.hi)
    (hJ : (0:ℚ) < J.lo ∧ (0:ℚ) < J.hi) :
    (0:ℚ) < (QInterval.mul I J).lo ∧ (0:ℚ) < (QInterval.mul I J).hi := by
  obtain ⟨h1, h2⟩ := hI
  obtain ⟨h3, h4⟩ := hJ
  have ha : (0:ℚ) < I.lo * J.lo := mul_pos h1 h3
  have hb : (0:ℚ) < I.lo * J.hi := mul_pos h1 h4
  have hc : (0:ℚ) < I.hi * J.lo := mul_pos h2 h3
  have hd : (0:ℚ) < I.hi * J.hi := mul_pos h2 h4
  constructor
  · simp only [QInterval.mul, lt_min_iff]
    exact ⟨⟨ha, hb⟩, hc, hd⟩
  · simp only [QInterval.mul, lt_max_iff]
    exact Or.inl (Or.inl ha)

/-- Positive `QInterval.add`. -/
theorem g_pos_add (I J : QInterval)
    (hI : (0:ℚ) < I.lo) (hJ : (0:ℚ) < J.lo) :
    (0:ℚ) < (QInterval.add I J).lo := by
  simp only [QInterval.add]
  exact add_pos hI hJ

/-- Positive `QInterval.inv` (positive denominator). -/
theorem g_pos_inv_pair (I : QInterval)
    (hI : (0:ℚ) < I.lo ∧ (0:ℚ) < I.hi) :
    (0:ℚ) < (QInterval.inv I).lo ∧ (0:ℚ) < (QInterval.inv I).hi := by
  obtain ⟨h1, h2⟩ := hI
  constructor
  · simp only [QInterval.inv, lt_min_iff]
    exact ⟨inv_pos.mpr h1, inv_pos.mpr h2⟩
  · simp only [QInterval.inv, lt_max_iff]
    exact Or.inl (inv_pos.mpr h1)

/-- The `hi` endpoint of `(A + B) - C` is exactly `A.hi + B.hi - C.lo`. -/
theorem g_hi_add_sub (A B C : QInterval) :
    ((A.add B).sub C).hi = A.hi + B.hi - C.lo := by
  simp only [QInterval.sub, QInterval.add, QInterval.neg]
  ring

/-! ## 0b. Generic definition layer -/

/-- `matan` direct-form point bracket (mirrors `lk_matan_direct`). -/
def gP_direct (t : ℚ) : QInterval :=
  QInterval.mk (1 - t / 3 + t ^ 2 / 5 - t ^ 3 / 7) (1 - t / 3 + t ^ 2 / 5)

/-- `matan` w-form point bracket for `1 < t` (mirrors `lk_matan_wplus`). -/
def gP_wplus (ql qh : ℚ) : QInterval :=
  QInterval.mk
    ((lkPIlo / 4 + ((ql - 1) / (qh + 1) - ((ql - 1) / (qh + 1)) ^ 3 / 3
        + ((ql - 1) / (qh + 1)) ^ 5 / 5 - ((ql - 1) / (qh + 1)) ^ 7 / 7)) / qh)
    ((lkPIhi / 4 + ((qh - 1) / (ql + 1) - ((qh - 1) / (ql + 1)) ^ 3 / 3
        + ((qh - 1) / (ql + 1)) ^ 5 / 5)) / ql)

/-- `matan` u-form point bracket for `1 < t` (mirrors `lk_matan_u`). -/
def gP_u (ql qh : ℚ) : QInterval :=
  QInterval.mk
    ((lkPIlo / 2 - (1 / ql - (1 / ql) ^ 3 / 3 + (1 / ql) ^ 5 / 5)) / qh)
    ((lkPIhi / 2 - (1 / qh - (1 / qh) ^ 3 / 3 + (1 / qh) ^ 5 / 5
        - (1 / qh) ^ 7 / 7)) / ql)

/-- `e(t) = 1/(1+t) − matan t` interval (mirrors `lk_matanDD_pt_mem`). -/
def gE (T : ℚ) (P : QInterval) : QInterval :=
  QInterval.sub (QInterval.const (1 / (1 + T))) P

/-- `matanDD` point interval (mirrors `lk_matanDD_pt_mem`). -/
def gDp (T : ℚ) (E : QInterval) : QInterval :=
  QInterval.sub (QInterval.neg (QInterval.mul (QInterval.const (3 / (4 * T * T))) E))
    (QInterval.const (1 / (2 * T * (1 + T) ^ 2)))

/-- Coherent matan value interval from the two endpoint brackets. -/
def gM (Plo Phi : QInterval) : QInterval := QInterval.mk Phi.lo Plo.hi

/-- `matanD` over a slot interval through `e(t) = 1/(1+t) − matan t`. -/
def gMD (TI VI : QInterval) : QInterval :=
  (((QInterval.const (1:ℚ)).add TI).inv.sub VI).mul
    (((QInterval.const (2:ℚ)).mul TI).inv)

