integer scale `2^KZ` and transported to `ℝ` by `dcSlack` below. -/
def slackZ : ℤ :=
  V.lo * (2 : ℤ) ^ (KZ - V.k).toNat -
    (wz0 * ((dAbs (G 0)).hi * (2 : ℤ) ^ (KZ - 201 - (G 0).k).toNat) +
     wz1 * ((dAbs (G 1)).hi * (2 : ℤ) ^ (KZ - 201 - (G 1).k).toNat) +
     wz2 * ((dAbs (G 2)).hi * (2 : ℤ) ^ (KZ - 201 - (G 2).k).toNat))

