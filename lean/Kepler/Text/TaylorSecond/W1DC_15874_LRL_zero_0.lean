/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(207 : ℤ), (992571512121656546425679704044693816551882833181655894211910 : ℤ), (992586180340874749482655118956833101306815910298264711901804 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(205 : ℤ), (140118001181325135444156758807652029495056318344718895058992 : ℤ), (1445667223529439393332267183686686675378182427231127255579984 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (230307923407937458641984897874895185431320048913100005505114 : ℤ), (1038496949654117379106080103171090180077615999588631204533025 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (129116636890555751207968869946694349416682448053208460771431 : ℤ), (905031469294846980296247510670920509616140026443504788354797 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(205 : ℤ), (140118001181325135444156758807652029495056318344718895058992 : ℤ), (1445667223529439393332267183686686675378182427231127255579984 : ℤ)⟩ from rfl]
