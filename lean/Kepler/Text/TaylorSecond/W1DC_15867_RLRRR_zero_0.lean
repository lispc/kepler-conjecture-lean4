/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(206 : ℤ), (1174987585953509829710298897199169884298987532008989226706103 : ℤ), (1174993524322405378747511584315278226258227644111067915843496 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(205 : ℤ), (161673941858074344770192906357405125879137616442163605705191 : ℤ), (1274068343725057425602435491049331645119974762592876957361583 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (233356007343463551527063738126833871389944784657626022776524 : ℤ), (888299447990365303967441421710706124261417330337492439858806 : ℤ)⟩
  | 2 => ⟨(205 : ℤ), (-180338058314260144002479963476384526244420797244673335697808 : ℤ), (1143072005170631110575928864859349816292853180565782664928152 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(205 : ℤ), (161673941858074344770192906357405125879137616442163605705191 : ℤ), (1274068343725057425602435491049331645119974762592876957361583 : ℤ)⟩ from rfl]
  exact Box.p0_Top.symm

theorem G1_eq : G 1 = Box.JTop.part 1 := by
  rw [show G 1 = ⟨(204 : ℤ), (233356007343463551527063738126833871389944784657626022776524 : ℤ), (888299447990365303967441421710706124261417330337492439858806 : ℤ)⟩ from rfl]
  exact Box.p1_Top.symm

