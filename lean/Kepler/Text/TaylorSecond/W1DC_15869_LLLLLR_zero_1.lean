/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(208 : ℤ), (409804727089393989993591541637023259152218890812311109297801 : ℤ), (409840306560531935355626482076384990027285568725513503682895 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(205 : ℤ), (242170254061663956523590152137099339188917632978650841885236 : ℤ), (946749019013351815886925733176408815170162319117921684612421 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (533156143850456033698366064162220802714486708997252195919700 : ℤ), (894172676637139829010505942839297452955175114125877756737144 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (538996895885054683625147894498494501255908389938909161043527 : ℤ), (905616611479646212294565419627698370448741327678964853891740 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(205 : ℤ), (242170254061663956523590152137099339188917632978650841885236 : ℤ), (946749019013351815886925733176408815170162319117921684612421 : ℤ)⟩ from rfl]
