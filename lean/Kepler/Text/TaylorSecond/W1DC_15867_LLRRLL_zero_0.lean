/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(207 : ℤ), (1528898162804046546212561559852434370694288218279270291654639 : ℤ), (1529030081481959519312380275191358838992724243274873658932968 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(204 : ℤ), (-236164629845673509832377141273865150064040338973446876214040 : ℤ), (897539165420949676759676719256127975793293882023706478578667 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (-36175234994834494690549614137580184784643549692854861898934 : ℤ), (1141571309812724311998191863218292519379429406497846466554084 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (-223472613416068251511764486075889368272930638327897809328309 : ℤ), (941790580671019316008354952156348544535636642042279428532013 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(204 : ℤ), (-236164629845673509832377141273865150064040338973446876214040 : ℤ), (897539165420949676759676719256127975793293882023706478578667 : ℤ)⟩ from rfl]
