/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(208 : ℤ), (119350411279963352368948704531232609782864945784875440693779 : ℤ), (119376241156394080974443608269074434397831307953687484424859 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(206 : ℤ), (999753843124462183094231971948869885758124258311174416991331 : ℤ), (1484179988448482412088792893458544166623211204050967155623919 : ℤ)⟩
  | 1 => ⟨(205 : ℤ), (1325824114330473819176929494928826112277212328567346818453299 : ℤ), (1604501557648451654693221171289025701978842478197462120679294 : ℤ)⟩
  | 2 => ⟨(205 : ℤ), (1328305876925955550971219626779369065790112444728962202235397 : ℤ), (1603960487483607250446231716519481171384815133472399859772883 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(206 : ℤ), (999753843124462183094231971948869885758124258311174416991331 : ℤ), (1484179988448482412088792893458544166623211204050967155623919 : ℤ)⟩ from rfl]
  exact Box.p0_Top.symm

theorem G1_eq : G 1 = Box.JTop.part 1 := by
  rw [show G 1 = ⟨(205 : ℤ), (1325824114330473819176929494928826112277212328567346818453299 : ℤ), (1604501557648451654693221171289025701978842478197462120679294 : ℤ)⟩ from rfl]
  exact Box.p1_Top.symm

theorem G2_eq : G 2 = Box.JTop.part 2 := by
