  have hs : 16 - ((y4 * y4) - 4) * ((y6 * y6) - 4)
      - 2 * ((y5 * y5) + (y5' * y5')) ≤ 0 := by
    have h1 : (0 : ℝ) ≤ ((y4 * y4) - 4) * ((y6 * y6) - 4) :=
      mul_nonneg (by linarith) (by linarith)
    linarith
