/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(207 : ℤ), (1505738866725297760761697511103657434580101174925191803448705 : ℤ), (1505873354894898806365486115043588704960264085006766352778182 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(204 : ℤ), (-30256238766362588541675114337632768102458147993209034569016 : ℤ), (862000240669762305660649605031966449611256641120264881819331 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (-136110737093616408576569033075009969846830832962658685634970 : ℤ), (849218718758151290874386614152571353155569498937250631426782 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (103014431828479674397338000283582345706051491363036034767771 : ℤ), (1101306051386285385514429001670903370082544491018895298997667 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(204 : ℤ), (-30256238766362588541675114337632768102458147993209034569016 : ℤ), (862000240669762305660649605031966449611256641120264881819331 : ℤ)⟩ from rfl]
