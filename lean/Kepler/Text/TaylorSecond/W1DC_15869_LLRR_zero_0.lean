theorem op_Top : dAdd ⟨(205 : ℤ), (230186380650989556366440994606500678651696198546327445892638 : ℤ), (230192589958040615032574398673859771274622747180200548562996 : ℤ)⟩ (dNeg ⟨(208 : ℤ), (853038492220514095884653128717985333266218767091914966460028 : ℤ), (853070305257167016689283506438519863468063483203839984004731 : ℤ)⟩) = ⟨(208 : ℤ), (988420739950749434242244450413485565745506105166779583136373 : ℤ), (988502227443810824375942060672892836930763210349689422043940 : ℤ)⟩ := by
