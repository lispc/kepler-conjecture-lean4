  | 2 => ⟨(204 : ℤ), (259784010395300168543098969832453250175796548525118864031563 : ℤ), (995561200652659083808629912419353229717945101600387926451995 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(205 : ℤ), (31794309450224123230755351050743881821099470233420851487922 : ℤ), (1420084845111271785077904624843850213919051622041033875333182 : ℤ)⟩ from rfl]
