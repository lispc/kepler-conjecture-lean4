theorem G_mem : ∀ x ∈ D, ∀ i, (G i).mem (partial1 i fTop x) := by
  intro x hx i
  rw [show G i = Box.JTop.part i from by
    fin_cases i
    · exact G0_eq
    · exact G1_eq
    · exact G2_eq]
