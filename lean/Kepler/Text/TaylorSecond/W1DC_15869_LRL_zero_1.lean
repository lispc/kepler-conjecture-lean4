theorem G1_eq : G 1 = Box.JTop.part 1 := by
  rw [show G 1 = ⟨(204 : ℤ), (229166670176413944916791089220251859580893960108987946320926 : ℤ), (985016420540726748473286922657130736434772389219413616518832 : ℤ)⟩ from rfl]
