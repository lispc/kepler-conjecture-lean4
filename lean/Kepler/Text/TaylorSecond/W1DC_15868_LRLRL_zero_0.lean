  rw [show G 2 = ⟨(204 : ℤ), (123692595258393353197632614663332189810867233368764007796906 : ℤ), (1098227989989272359341348951090582909377800890578930888228428 : ℤ)⟩ from rfl]
  exact Box.p2_Top.symm

theorem G_mem : ∀ x ∈ D, ∀ i, (G i).mem (partial1 i fTop x) := by
  intro x hx i
  rw [show G i = Box.JTop.part i from by
    fin_cases i
    · exact G0_eq
    · exact G1_eq
    · exact G2_eq]
