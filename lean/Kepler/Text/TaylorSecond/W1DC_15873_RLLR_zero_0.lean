/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(206 : ℤ), (1153708116321116357791745417917379054932238080678788143552856 : ℤ), (1153776496658082289173170487767726147671875664739946168503955 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(204 : ℤ), (136675061350008375256641362089003869313878657231230539701758 : ℤ), (803699369892176167473223723705378276731649310095380641299450 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (16528209611500213684763930256116063678398490215583920389271 : ℤ), (876563420263611643889712496487478143535931248073746298742580 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (-65841869579330954402952579258505319129806939215350824807689 : ℤ), (809558248485516614472403119605148593067722075053695946424029 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(204 : ℤ), (136675061350008375256641362089003869313878657231230539701758 : ℤ), (803699369892176167473223723705378276731649310095380641299450 : ℤ)⟩ from rfl]
