theorem G1_eq : G 1 = Box.JTop.part 1 := by
  rw [show G 1 = ⟨(204 : ℤ), (19185556648452607390398422350056341466547783200000420407957 : ℤ), (859214558271575717168138615037952962236637175549073846710766 : ℤ)⟩ from rfl]
