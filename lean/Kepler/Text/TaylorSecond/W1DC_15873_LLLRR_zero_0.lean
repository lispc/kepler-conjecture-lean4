/-! ## 5. The T2 terminal

`V` and `G` are the **literal** brackets of `Pt.JTop.value` / `Box.JTop.part i`
(proved equal to the tree slots in `V_mem`/`G_mem`), so the slack below is one
pure-integer kernel computation: `Nat.sqrt` inside the tree never reaches it. -/

def V : DC := ⟨(207 : ℤ), (1551196579650767963969902745475358041843870992126058977433470 : ℤ), (1551234262197707870737873602588358018255234293360686973330998 : ℤ)⟩

def G : Fin 3 → DC
  | 0 => ⟨(205 : ℤ), (196148313084074986515602636297542480009729042682080702070957 : ℤ), (1526377568337802050124801697683868404145754488869733506048610 : ℤ)⟩
  | 1 => ⟨(204 : ℤ), (19185556648452607390398422350056341466547783200000420407957 : ℤ), (859214558271575717168138615037952962236637175549073846710766 : ℤ)⟩
  | 2 => ⟨(204 : ℤ), (164684986923291624625092434910284933502299920677179073916845 : ℤ), (969922086569942247632474905485435701412203501377588958416633 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
  have h := Pt.JTop_mem.2.1 c (show c ∈ Dpt from rfl)
  rwa [Pt.ev_Top] at h

theorem G0_eq : G 0 = Box.JTop.part 0 := by
  rw [show G 0 = ⟨(205 : ℤ), (196148313084074986515602636297542480009729042682080702070957 : ℤ), (1526377568337802050124801697683868404145754488869733506048610 : ℤ)⟩ from rfl]
