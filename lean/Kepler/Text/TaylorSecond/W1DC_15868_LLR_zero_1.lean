  rw [show G 1 = ⟨(204 : ℤ), (-7522049887126494627414963266225089968091763713481173150333 : ℤ), (964083280632511983917817450757833630243824664514484823495658 : ℤ)⟩ from rfl]
  exact Box.p1_Top.symm

theorem G2_eq : G 2 = Box.JTop.part 2 := by
  rw [show G 2 = ⟨(204 : ℤ), (40817236644087979311274564082660320754272281188126116316898 : ℤ), (1036874423176927313049504013750946411470797931206261307400424 : ℤ)⟩ from rfl]
