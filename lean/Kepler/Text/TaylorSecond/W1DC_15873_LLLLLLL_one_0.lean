      deltaX (y4 * y4) 2 (y5' * y5') 2 (y6 * y6) 2 := by
  have hx4 : (4 : ℝ) ≤ y4 * y4 := by nlinarith
  have hx5 : (4 : ℝ) ≤ y5 * y5 := by nlinarith
  have hx5' : (4 : ℝ) ≤ y5' * y5' := by nlinarith
  have hx6 : (4 : ℝ) ≤ y6 * y6 := by nlinarith
