  | 2 => ⟨(204 : ℤ), (-282615052566159588172460513222006136858668308932271273923332 : ℤ), (1102699320788508798213237296494007828516341844794868305765253 : ℤ)⟩

theorem V_mem : V.mem (fTop c) := by
