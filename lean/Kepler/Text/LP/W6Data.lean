/-- Arithmetic cross-check: kernel-verified easy count + hard literal count
equals the 43,078/189 totals of the frozen registry. -/
theorem terminalCount_crossCheck :
    23640 + hardTerminalCount = 43078 := by decide

theorem infeasibleCount_crossCheck :
    41 + hardInfeasibleCount = 189 := by decide

/-- W6-A light contract on the easy batch: every terminal has empty
constraint tables (kernel-checked). The hard batch came from the same
generator path; its contract is a dumper invariant, not a Lean `decide`
fact (see module header). -/
theorem easyData_constraintsEmpty :
    easyData.all (fun g => g.rootCase.constraintsEmpty) = true := by
  simp only [easyData, List.all_append, Shard00.data_constraintsEmpty, Shard01.data_constraintsEmpty, Shard02.data_constraintsEmpty]
  all_goals rfl

/-- **hdata**: light data size and kernel-checked easy-batch shape facts.
Hard-batch tree counts are dumper literals (`hardTerminalCount_eq` etc.);
hard-batch membership/length is kernel-checked, and the full 43,078 record
coverage is kernel-checked by `Coverage.recordIds_eq_lpTerminalIds`. -/
theorem hdata :
    dataAll.length = 19715 ∧
    (easyData.map (fun g => g.rootCase.countTerminals)).sum = 23640 ∧
    (easyData.map (fun g => g.rootCase.countInfeasible)).sum = 41 ∧
    easyData.all (fun g => g.rootCase.constraintsEmpty) = true ∧
    hardData.length = 15 :=
  ⟨dataAll_length, easyData_terminalCount, easyData_infeasibleCount,
    easyData_constraintsEmpty, hardData_length⟩

end Kepler.Text.LP.W6Data
