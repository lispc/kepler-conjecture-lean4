set_option maxRecDepth 100000
set_option maxHeartbeats 0

namespace Kepler.Text.LP.W6Data

open Kepler.Text.LP

/-- Easy-batch certificate trees (19,700 graphs). -/
def easyData : List LpGraphCert :=
  Shard00.data ++
  Shard01.data ++
  Shard02.data

/-- Hard-batch certificate trees (15 graphs, large split trees). -/
def hardData : List LpGraphCert :=
  Hard00.data ++
  Hard01.data ++
  Hard02.data ++
  Hard03.data ++
  Hard04.data ++
  Hard05.data ++
  Hard06.data ++
  Hard07.data ++
  Hard08.data ++
  Hard09.data ++
  Hard10.data ++
  Hard11.data ++
  Hard12.data ++
  Hard13.data ++
  Hard14.data

/-- All 19,715 certificate trees (easy batch ++ hard batch). -/
def dataAll : List LpGraphCert :=
  easyData ++ hardData

theorem easyData_length : easyData.length = 19700 := by
  simp only [easyData, List.length_append, Shard00.data_length, Shard01.data_length, Shard02.data_length]

theorem hardData_length : hardData.length = 15 := by
  simp only [hardData, List.length_append, Hard00.data_length, Hard01.data_length, Hard02.data_length, Hard03.data_length, Hard04.data_length, Hard05.data_length, Hard06.data_length, Hard07.data_length, Hard08.data_length, Hard09.data_length, Hard10.data_length, Hard11.data_length, Hard12.data_length, Hard13.data_length, Hard14.data_length]

theorem dataAll_length : dataAll.length = 19715 := by
  simp only [dataAll, List.length_append, easyData_length, hardData_length]

/-- Kernel-checked easy-batch terminal total (small trees, `decide`). -/
theorem easyData_terminalCount :
    (easyData.map (fun g => g.rootCase.countTerminals)).sum = 23640 := by
  simp only [easyData, List.map_append, List.sum_append, Shard00.terminalCount, Shard01.terminalCount, Shard02.terminalCount]

/-- Kernel-checked easy-batch infeasible-terminal total. -/
theorem easyData_infeasibleCount :
    (easyData.map (fun g => g.rootCase.countInfeasible)).sum = 41 := by
  simp only [easyData, List.map_append, List.sum_append, Shard00.infeasibleCount, Shard01.infeasibleCount, Shard02.infeasibleCount]

/-- Kernel-checked easy-batch split-node total. -/
theorem easyData_splitCount :
    (easyData.map (fun g => g.rootCase.countSplits)).sum = 904 := by
  simp only [easyData, List.map_append, List.sum_append, Shard00.splitCount, Shard01.splitCount, Shard02.splitCount]

