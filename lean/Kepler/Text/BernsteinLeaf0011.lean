/-! ## The leaf theorem -/
/-- The 81-coefficient Bernstein leaf for the ZTGIJCF4 0_0_1_1 debt
(q = 36/25), face form: x1 pinned to the low endpoint 3793/625 and x4
pinned to the low endpoint 4 (the engine's two monotone prunes), the
four free coordinates in their exact debt sub-boxes.  Statement shape
identical to the bank's `ztgG_box5` conclusion
(lean/Kepler/NliBanksZTGIJCF4Dih.lean). -/
theorem ztgG_leaf_0_0_1_1 (x1 x2 x3 x4 x5 x6 : ℝ)
    (hx1 : x1 = (3793/625:ℝ)) (hx4 : x4 = (4:ℝ))
    (h2 : (4:ℝ) ≤ x2) (h2' : x2 ≤ (3969/625:ℝ))
    (h3 : (4:ℝ) ≤ x3) (h3' : x3 ≤ (3969/625:ℝ))
    (h5 : (3793/625:ℝ) ≤ x5) (h5' : x5 ≤ (8:ℝ))
    (h6 : (3793/625:ℝ) ≤ x6) (h6' : x6 ≤ (8:ℝ)) :
    (0:ℝ) ≤ 4 * x1 * deltaX x1 x2 x3 x4 x5 x6 - (36/25) * (deltaX4 x1 x2 x3 x4 x5 x6) ^ 2 := by
  subst hx1; subst hx4
  have hb0 : (0:ℝ) ≤ (3969/625:ℝ) - x2 := by linarith
  have hb1 : (0:ℝ) ≤ x2 - (4:ℝ) := by linarith
  have hs : (0:ℝ) ≤ ((3969/625:ℝ) - (4:ℝ)) ^ 2 * (4 * (3793/625:ℝ) * deltaX (3793/625:ℝ) x2 x3 (4:ℝ) x5 x6 - (36/25:ℝ) * (deltaX4 (3793/625:ℝ) x2 x3 (4:ℝ) x5 x6) ^ 2) := by
    rw [idL1 x2 x3 x5 x6]
    exact add_nonneg (add_nonneg (mul_nonneg (sq_nonneg _)
      (nnL2_0 x3 x5 x6 h3 h3' h5 h5' h6 h6'))
      (mul_nonneg (mul_nonneg hb1 hb0)
        (nnL2_1 x3 x5 x6 h3 h3' h5 h5' h6 h6')))
      (mul_nonneg (sq_nonneg _)
        (nnL2_2 x3 x5 x6 h3 h3' h5 h5' h6 h6'))
  exact nonneg_of_pos_mul (by norm_num) hs

