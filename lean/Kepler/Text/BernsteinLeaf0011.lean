theorem idL1 : ∀ x2 x3 x5 x6,
    ((3969/625:ℝ) - (4:ℝ)) ^ 2 * (4 * (3793/625:ℝ) * deltaX (3793/625:ℝ) x2 x3 (4:ℝ) x5 x6 - (36/25:ℝ) * (deltaX4 (3793/625:ℝ) x2 x3 (4:ℝ) x5 x6) ^ 2)
