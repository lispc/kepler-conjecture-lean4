/-
Kepler.Text.ZTGTrioSym — lane `ztg-joint6-trio-w1`, M2: the slot-symmetry
layer of the W1 trio (debts `1_0_0_0` / `0_0_1_0` / `0_0_0_1`).

The three trio debts share one geometry: exactly one critical slot with
`w = 2`, `m = 0` (`i4 = 0`).  The Klein four-group generated by the vertex
swaps `(y2 y6)(y3 y5)` (PA25 `sym26`) and `(y2 y3)(y5 y6)` (`sym23`) acts on
the slots `{y2, y3, y5, y6}` with `y1, y4` fixed, and

* `s26` maps the `0_0_1_0` box onto the `1_0_0_0` box (critical `y5 → y3`);
* `ψ = s26∘s23 = (y2 y5)(y3 y6)` maps the `0_0_0_1` box onto the `1_0_0_0`
  box (critical `y6 → y3`),

so one shared corner table for the base debt plus this module closes all
three.  `gamma4` symmetry consumes the public PA25 lemmas through the
definitional bridge `ztg_gamma4_bridge` (`gamma4fgcyP25` and `gamma4fgcy`
have verbatim-equal bodies); `dihY` symmetry is proved here from the
ring-level `deltaX`/`deltaX4` invariances.

No `sorry`/`axiom`/`native_decide`; every declaration is axiom-audited.
-/
import Kepler.Text.ZTGJointKit
import Kepler.Text.PackingAuto25

set_option maxHeartbeats 8000000

namespace Kepler.Text

open Kepler.NliBanksZTGIJCF4Route

/-! ## 1. Ring-level slot invariances of the polynomial layer -/

theorem ztg_deltaX_sym26 (x1 x2 x3 x4 x5 x6 : ℝ) :
    deltaX x1 x2 x3 x4 x5 x6 = deltaX x1 x6 x5 x4 x3 x2 := by
  unfold deltaX; ring

theorem ztg_deltaX4_sym26 (x1 x2 x3 x4 x5 x6 : ℝ) :
    deltaX4 x1 x2 x3 x4 x5 x6 = deltaX4 x1 x6 x5 x4 x3 x2 := by
  unfold deltaX4; ring

theorem ztg_deltaX_sym23 (x1 x2 x3 x4 x5 x6 : ℝ) :
    deltaX x1 x2 x3 x4 x5 x6 = deltaX x1 x3 x2 x4 x6 x5 := by
  unfold deltaX; ring

theorem ztg_deltaX4_sym23 (x1 x2 x3 x4 x5 x6 : ℝ) :
    deltaX4 x1 x2 x3 x4 x5 x6 = deltaX4 x1 x3 x2 x4 x6 x5 := by
  unfold deltaX4; ring

/-! ## 2. `dihY` symmetry under the two generators -/

theorem ztg_dihY_sym26 (y1 y2 y3 y4 y5 y6 : ℝ) :
    dihY y1 y2 y3 y4 y5 y6 = dihY y1 y6 y5 y4 y3 y2 := by
  unfold dihY dihXf
  rw [ztg_deltaX_sym26, ztg_deltaX4_sym26]

theorem ztg_dihY_sym23 (y1 y2 y3 y4 y5 y6 : ℝ) :
    dihY y1 y2 y3 y4 y5 y6 = dihY y1 y3 y2 y4 y6 y5 := by
  unfold dihY dihXf
  rw [ztg_deltaX_sym23, ztg_deltaX4_sym23]

/-- The fourth group element `ψ = s26∘s23 = (y2 y5)(y3 y6)`. -/
theorem ztg_dihY_sym_psi (y1 y2 y3 y4 y5 y6 : ℝ) :
    dihY y1 y2 y3 y4 y5 y6 = dihY y1 y5 y6 y4 y2 y3 := by
  rw [ztg_dihY_sym23, ztg_dihY_sym26]

/-! ## 3. `gamma4` symmetry (PA25 public lemmas through the body bridge) -/

/-- `gamma4fgcyP25` and `gamma4fgcy` have verbatim-equal bodies
(`volY − vol4f(±P25)`, PA20:105 = PA25:355). -/
theorem ztg_gamma4_bridge (y1 y2 y3 y4 y5 y6 : ℝ) (f : ℝ → ℝ) :
    gamma4fgcyP25 y1 y2 y3 y4 y5 y6 f = gamma4fgcy y1 y2 y3 y4 y5 y6 f := rfl

theorem ztg_gamma4_sym26 (y1 y2 y3 y4 y5 y6 : ℝ) (f : ℝ → ℝ) :
    gamma4fgcy y1 y2 y3 y4 y5 y6 f = gamma4fgcy y1 y6 y5 y4 y3 y2 f := by
  rw [← ztg_gamma4_bridge y1 y2 y3 y4 y5 y6 f, ← ztg_gamma4_bridge y1 y6 y5 y4 y3 y2 f,
    gamma4fgcy_sym26]

theorem ztg_gamma4_sym_psi (y1 y2 y3 y4 y5 y6 : ℝ) (f : ℝ → ℝ) :
    gamma4fgcy y1 y2 y3 y4 y5 y6 f = gamma4fgcy y1 y5 y6 y4 y2 y3 f := by
  rw [← ztg_gamma4_bridge y1 y2 y3 y4 y5 y6 f, ← ztg_gamma4_bridge y1 y5 y6 y4 y2 y3 f,
    gamma4fgcy_sym23P25, gamma4fgcy_sym26]

/-! ## 4. The bank-parameter equalities across the trio -/

theorem ztg_w_trio_eq : ztgW 1 0 0 0 = ztgW 0 0 1 0 ∧ ztgW 1 0 0 0 = ztgW 0 0 0 1 := by
  simp [ztgW, bankGenMid]

theorem ztg_m_trio_eq : ztgM 1 0 0 0 = 0 ∧ ztgM 0 0 1 0 = 0 ∧ ztgM 0 0 0 1 = 0 := by
  simp [ztgM, bankGenMid]

/-- The `s26` transfer of the main functional: `ztgMain 1 0 0 0` at the
swapped point equals `ztgMain 0 0 1 0` at the original point. -/
theorem ztg_main_eq_s26 (y1 y2 y3 y4 y5 y6 : ℝ) :
    ztgMain 1 0 0 0 y1 y6 y5 y4 y3 y2 = ztgMain 0 0 1 0 y1 y2 y3 y4 y5 y6 := by
  have hγ : gamma4fgcy y1 y6 y5 y4 y3 y2 lmfun = gamma4fgcy y1 y2 y3 y4 y5 y6 lmfun :=
    (ztg_gamma4_sym26 y1 y2 y3 y4 y5 y6 lmfun).symm
  have hd : dihY y1 y6 y5 y4 y3 y2 = dihY y1 y2 y3 y4 y5 y6 :=
    (ztg_dihY_sym26 y1 y2 y3 y4 y5 y6).symm
  unfold ztgMain
  rw [hγ, hd, ztg_w_trio_eq.1, ztg_m_trio_eq.1, ztg_m_trio_eq.2.1]

/-- The `ψ` transfer: `ztgMain 1 0 0 0` at the ψ-swapped point equals
`ztgMain 0 0 0 1` at the original point. -/
theorem ztg_main_eq_psi (y1 y2 y3 y4 y5 y6 : ℝ) :
    ztgMain 1 0 0 0 y1 y5 y6 y4 y2 y3 = ztgMain 0 0 0 1 y1 y2 y3 y4 y5 y6 := by
  have hγ : gamma4fgcy y1 y5 y6 y4 y2 y3 lmfun = gamma4fgcy y1 y2 y3 y4 y5 y6 lmfun :=
    (ztg_gamma4_sym_psi y1 y2 y3 y4 y5 y6 lmfun).symm
  have hd : dihY y1 y5 y6 y4 y2 y3 = dihY y1 y2 y3 y4 y5 y6 :=
    (ztg_dihY_sym_psi y1 y2 y3 y4 y5 y6).symm
  unfold ztgMain
  rw [hγ, hd, ztg_w_trio_eq.2, ztg_m_trio_eq.1, ztg_m_trio_eq.2.2]

/-! ## 5. The box transfers -/

/-- `s26` maps the `0_0_1_0` box onto the `1_0_0_0` box. -/
theorem ztg_box_0010_swap26 {y1 y2 y3 y4 y5 y6 : ℝ}
    (hy : ztgBox 0 0 1 0 y1 y2 y3 y4 y5 y6) :
    ztgBox 1 0 0 0 y1 y6 y5 y4 y3 y2 := by
  rcases hy with ⟨h1l, h1h, h2l, h2h, h3l, h3h, h4l, h4h, h5l, h5h, h6l, h6h⟩
  refine ⟨h1l, h1h, h6l, h6h, h5l, h5h, h4l, h4h, h3l, h3h, h2l, h2h⟩

/-- `ψ` maps the `0_0_0_1` box onto the `1_0_0_0` box. -/
theorem ztg_box_0001_swap_psi {y1 y2 y3 y4 y5 y6 : ℝ}
    (hy : ztgBox 0 0 0 1 y1 y2 y3 y4 y5 y6) :
    ztgBox 1 0 0 0 y1 y5 y6 y4 y2 y3 := by
  rcases hy with ⟨h1l, h1h, h2l, h2h, h3l, h3h, h4l, h4h, h5l, h5h, h6l, h6h⟩
  refine ⟨h1l, h1h, h5l, h5h, h6l, h6h, h4l, h4h, h2l, h2h, h3l, h3h⟩

/-- **The `0_0_1_0` debt reduces to the base debt** through `s26`. -/
theorem ztg_main_0010_of_1000
    (hbase : ∀ y1 y2 y3 y4 y5 y6, ztgBox 1 0 0 0 y1 y2 y3 y4 y5 y6 →
      0 < ztgMain 1 0 0 0 y1 y2 y3 y4 y5 y6) :
    ∀ y1 y2 y3 y4 y5 y6, ztgBox 0 0 1 0 y1 y2 y3 y4 y5 y6 →
      0 < ztgMain 0 0 1 0 y1 y2 y3 y4 y5 y6 := by
  intro y1 y2 y3 y4 y5 y6 hy
  rw [← ztg_main_eq_s26 y1 y2 y3 y4 y5 y6]
  exact hbase y1 y6 y5 y4 y3 y2 (ztg_box_0010_swap26 hy)

/-- **The `0_0_0_1` debt reduces to the base debt** through `ψ`. -/
theorem ztg_main_0001_of_1000
    (hbase : ∀ y1 y2 y3 y4 y5 y6, ztgBox 1 0 0 0 y1 y2 y3 y4 y5 y6 →
      0 < ztgMain 1 0 0 0 y1 y2 y3 y4 y5 y6) :
    ∀ y1 y2 y3 y4 y5 y6, ztgBox 0 0 0 1 y1 y2 y3 y4 y5 y6 →
      0 < ztgMain 0 0 0 1 y1 y2 y3 y4 y5 y6 := by
  intro y1 y2 y3 y4 y5 y6 hy
  rw [← ztg_main_eq_psi y1 y2 y3 y4 y5 y6]
  exact hbase y1 y5 y6 y4 y2 y3 (ztg_box_0001_swap_psi hy)

#print axioms ztg_deltaX_sym26
#print axioms ztg_deltaX4_sym26
#print axioms ztg_deltaX_sym23
#print axioms ztg_deltaX4_sym23
#print axioms ztg_dihY_sym26
#print axioms ztg_dihY_sym23
#print axioms ztg_dihY_sym_psi
#print axioms ztg_gamma4_bridge
#print axioms ztg_gamma4_sym26
#print axioms ztg_gamma4_sym_psi
#print axioms ztg_w_trio_eq
#print axioms ztg_m_trio_eq
#print axioms ztg_main_eq_s26
#print axioms ztg_main_eq_psi
#print axioms ztg_box_0010_swap26
#print axioms ztg_box_0001_swap_psi
#print axioms ztg_main_0010_of_1000
#print axioms ztg_main_0001_of_1000

end Kepler.Text
