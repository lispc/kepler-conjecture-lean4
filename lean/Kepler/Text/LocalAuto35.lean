  have h0d' : 0 < azim 0 (vv j) (vv (j + 1)) (vv (j + s.k - 1)) :=
    lt_of_le_of_ne h0d (fun hh => hθne hh.symm)
  have hbcd : (0:ℝ) < (crossProduct (vv j : Fin 3 → ℝ) (vv (j + 1) : Fin 3 → ℝ)) ⬝ᵥ
