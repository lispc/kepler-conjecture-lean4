          · exact Or.inl h'
          · exfalso
            rw [h'] at hzab
            have hmem : a ∈ ({a, b} : Set V3) := Set.mem_insert_iff.mpr (Or.inl rfl)
            rw [← hzab] at hmem
            rcases Set.mem_insert_iff.mp hmem with hq | hq
            · exact hab hq
            · exact hab hq
