    (hsgnUW : 0 < (crossProduct (eW : Fin 3 → ℝ) (dU'.1 : Fin 3 → ℝ)) ⬝ᵥ
      (dU'.2 : Fin 3 → ℝ))
    (hsgnWW : 0 < (crossProduct (eW : Fin 3 → ℝ) (dW'.1 : Fin 3 → ℝ)) ⬝ᵥ
