        exact ⟨hy2cone, hy2self⟩
      obtain ⟨r, hr0, hy2r⟩ := affGeOneRender_p35 hu0 hy2u
      exact (hncy2 ((collinear3_iff_smul (v := (0:V3)) (w := u) (w1 := y2)
