      · exact hncB _ (hiterV i') (fun hc => hNmin i' (by omega) hc)
  · -- 内点非零
    intro i h0i hik
    rcases i with _ | i'
    · omega
    · rw [hwS]
      rcases Nat.eq_zero_or_pos i' with h0 | h0
      · rw [h0, Function.iterate_zero]
