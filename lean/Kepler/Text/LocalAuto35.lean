      intro x hx s hs
      rw [hseteq] at hs
      exact hsub x hx hs
    exact nlLunarKillOne_p35 (V := V) (E := E) (FF := FF) (v := w) (w := v) (t := t)
      hfan hw hv hwv.symm hsub' hEE2 htz hcol (hHK w t hw ht htz.symm hcol hLunar)

