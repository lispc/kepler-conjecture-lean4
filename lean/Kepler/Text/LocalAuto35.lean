    exact hL
  have hNN1 : N + 1 - 1 = N := by omega
  have hNne0 : ¬(N = 0) := by omega
  have hwalkN : walkD (N + 1 - 1) = ivsRhoNode1 FF b := by
    rw [hNN1]
    simp only [hwd, if_neg hNne0]
