  -- KCHMAMG 总装：结论体 = 槽体（hint ∧ ∃A … ∃e …）；轴提出即槽
  obtain ⟨-, A, ⟨u0, v0, w0, hncA, hAdef⟩, h0A, hsubA, e, hperp, hcy, hq⟩ :=
    KCHMAMG_thm_p35 hfanLU hEE2U hplaneU hintU
