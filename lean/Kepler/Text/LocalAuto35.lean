    pmCrossGeDart_p35 hk3 hper hinj hE hFF hfan (j + 1) y hy
  have hhsd : ∀ y ∈ Set.range vv,
      0 ≤ (crossProduct (vv (j + s.k - 1) : Fin 3 → ℝ) (vv j : Fin 3 → ℝ)) ⬝ᵥ
        (y : Fin 3 → ℝ) := by
    intro y hy
