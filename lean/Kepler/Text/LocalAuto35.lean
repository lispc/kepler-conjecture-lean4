          (Set.mem_insert a (Set.singleton (rhoNode1 FF a)))))
        (Submodule.smul_mem _ _ (Submodule.subset_span
          (Set.mem_insert_of_mem a (Set.mem_singleton (rhoNode1 FF a)))))
    rw [← hzz]
