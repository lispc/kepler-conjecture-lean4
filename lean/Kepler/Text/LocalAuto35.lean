  obtain ⟨αu, βu, hucoe⟩ := hu
  obtain ⟨αw, βw, hwcoe⟩ := hw
  have hαu : 0 ≤ αu := pmAlphaGe_p35
    (hhse u (Set.mem_range.mpr ⟨p % s.k, hp⟩)) hucoe hbed
