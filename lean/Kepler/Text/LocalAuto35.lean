      · intro hz
        refine ⟨0, Set.mem_Iic.mpr (by omega), ?_⟩
        simpa using (Set.mem_singleton_iff.mp hz).symm
    have hvls : ls = v := by simp only [← hls, hl0, Function.iterate_zero_apply]
    rw [hvls]
