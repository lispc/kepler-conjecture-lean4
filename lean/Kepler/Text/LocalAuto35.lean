private theorem face3Rho_p35 {vv : ℕ → V3} {k p : ℕ} {Ff : Set (V3 × V3)}
    (hk0 : 0 < k) (hk3 : 3 < k) (hper : Periodic vv k)
    (hinj : ∀ i j, i < k → j < k → i ≠ j → vv i ≠ vv j)
    (hFf : Set.range (fun i => (vv (i % 3 + p), vv ((i + 1) % 3 + p))) = Ff)
