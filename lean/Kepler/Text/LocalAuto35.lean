          / (2 * (‖u‖ * ‖y1'‖))))
    (hwin2 : azim 0 ax y1' y2'
        ≤ Real.arccos ((‖y1'‖ ^ 2 + ‖y2'‖ ^ 2 - cstab ^ 2)
          / (2 * (‖y1'‖ * ‖y2'‖))))
    (hwin3 : azim 0 ax y2' w
