  have hselfW : (w, rhoNode1 FF w) ∈ HS.face (w, rhoNode1 FF w) := ⟨0, rfl⟩
  have hlfW := HAFL_CIRCLE_FORM_OF_HALF_CIRCLE_p35 hgraphW HS hHSw hfanAugW hdWw
