      ((rhoNode1 FF a : V3) : Fin 3 → ℝ))) a a <
      azim (0:V3) (WithLp.toLp 2 (crossProduct (a : Fin 3 → ℝ)
        ((rhoNode1 FF a : V3) : Fin 3 → ℝ))) a (rhoNode1 FF a) := by
    rw [azim_self]
    exact hd1pos.1
  -- 严格递增链（终点 π 封顶，无需 overshoot）
  have hchain : ∀ k m : ℕ, k < m → m ≤ n →
      azim (0:V3) (WithLp.toLp 2 (crossProduct (a : Fin 3 → ℝ)
