      (v1 := vv j) (v := vv (j + 1)) (u1 := vv (j + 1 + 1)) hncbe hncbc
      (lt_of_le_of_ne h0e (Ne.symm h0ne)) (lt_of_le_of_lt hle hθlt)
  obtain ⟨h0d, -⟩ := hsand (vv (j + s.k - 1))
    (Set.mem_range.mpr ⟨j + s.k - 1, rfl⟩)
  have hncbd : ¬ Collinear3 0 (vv j) (vv (j + s.k - 1)) := by
    intro hcol
