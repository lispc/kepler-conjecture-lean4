/-- **hnw 实例 hdUW**（W 面基 dart `dU' := (w, ρw)`）：换序实例化。 -/
theorem w2NwUW_p35 (V : Set V3) (E : Set (Set V3)) (FF : Set (V3 × V3))
    (v w : V3) (NW : ℕ) (HS : Hypermap (V3 × V3))
    (hfan : ConvexLocalFan V E FF) (hv : v ∈ V) (hw : w ∈ V) (hwv : v ≠ w)
