  -- 步骤5+6：窗口 U ⊆ 平面 P := affineSpan {0, a, ρa}（件2 系数渲染）
  have hstep : ∀ z ∈ V, z ≠ a → z ≠ b → ∃ ω s : ℝ, rhoNode1 FF z = ω • z + s • a :=
