  rw [hcs]
  have hsqc : ((301:ℝ) / 100) ^ 2 = 90601 / 10000 := by norm_num
  rw [hsqc]
  have h1 : (0:ℝ) ≤ p - 2 := by linarith
  have h2 : (0:ℝ) ≤ q - 5 / 2 := by linarith
