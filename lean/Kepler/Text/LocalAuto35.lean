  have hncEG : ¬ Collinear3 (0:V3) (WithLp.toLp 2 (crossProduct (a : Fin 3 → ℝ)
      ((rhoNode1 FF a : V3) : Fin 3 → ℝ))) (rhoNode1 FF a) :=
    hk3OrthNoncol_p35 _ (rhoNode1 FF a) he0 hkit.2.1 hdotG
  -- 步骤4b：dial(ρa) ∈ (0, π)（混积换位 (e×a)⬝ρa = (a×ρa)⬝e = e⬝e > 0）
