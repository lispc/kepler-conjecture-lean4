    show ({u, z} : Set V3) ∈ E
    rw [← heq]
    exact heE
  have hun := hdih.2.1 x₀ hx₀d
  have hdz2 : (u, z) ∈ FF ∪
      ((↑(@Hypermap.nodeMap (V3 × V3) (fun a b => instDecidableEqProd a b)
        (Fan.hypermapOfFan (0:V3) V E hF)) : V3 × V3 → V3 × V3) '' FF) := by
    rw [hFF, hun, hcoe]
