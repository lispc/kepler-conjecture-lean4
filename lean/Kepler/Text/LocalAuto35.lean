        ¬(azim 0 (w, rhoNode1 FF w).1 (w, rhoNode1 FF w).2 (ρ i) = Real.pi ∧
          azim 0 (w, rhoNode1 FF w).1 (w, rhoNode1 FF w).2 (ρ (i + 1)) = 0) := by
  have hnc' : ∀ z ∈ ({w, v} : Set V3), ∀ t ∈ V, t ≠ z → ¬ Collinear3 0 z t := by
