    simpa [sub_zero] using cross_dot_fully_surrounded_fan (x := 0) (v1 := vv j)
      (v := vv (j + 1)) (u1 := vv (j + s.k - 1)) hncbd hncbc h0d' hθlt
  have hhse : ∀ y ∈ Set.range vv,
