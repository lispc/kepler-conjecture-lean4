/-- 1e-20 pi bracket (Mathlib d20; same bracket as g4v_pi_bounds). -/
theorem cvp_pi_bounds :
    (3.14159265358979323846 : Real) < Real.pi /\
      Real.pi < 3.14159265358979323847 :=
  ⟨Real.pi_gt_d20, Real.pi_lt_d20⟩

/-- Division flips on a negative divisor (self-contained). -/
private theorem cvp_div_neg_lt {a b d : Real} (hab : a < b)
    (hd : d < 0) : b / d < a / d := by
  have hd0 : d ≠ 0 := by
    by_contra hc0
    rw [hc0] at hd
    norm_num at hd
  have key : (a / d - b / d) * d = a - b := by field_simp
  have hneg : a - b < 0 := by linarith
  by_contra hc
  push_neg at hc
  have h4 : a / d - b / d ≤ (0:Real) := by linarith [hc]
  have h5 : (0:Real) ≤ (a / d - b / d) * d := by nlinarith [h4, hd]
  linarith

/-- arctan at a rational point via the 32-term series wrapper
(body = tree g4v_atan_pos_bounds). -/
private theorem cvp_atan_of {x lo hi : Real} (hx0 : 0 ≤ x)
    (hx1 : x < 1)
    (h1 : lo + 1 / 100000000000 ≤
      ∑ i ∈ Finset.range 32,
        ((-1:Real)^i * x^(2*i+1))/((2*i+1 : ℕ):Real))
    (h2 : (∑ i ∈ Finset.range 32,
        ((-1:Real)^i * x^(2*i+1))/((2*i+1 : ℕ):Real)) ≤
      hi - 1 / 100000000000)
    (h3 : x^(2*32+1)/((2*32+1 : ℕ):Real) ≤ 1 / 100000000000) :
    lo ≤ Real.arctan x ∧ Real.arctan x ≤ hi := by
  have h := Kepler.Interval.arctan_abs_sub_partial_le hx0 hx1 32
  have hr := le_trans h h3
  have hb := abs_le.mp hr
  constructor <;> linarith [hb.1, hb.2]

/-- arctan mirror for negative arguments. -/
private theorem cvp_atan_neg {x lo hi : Real}
    (h : lo ≤ Real.arctan x ∧ Real.arctan x ≤ hi) :
    -hi ≤ Real.arctan (-x) ∧ Real.arctan (-x) ≤ -lo := by
  rw [Real.arctan_neg]
  constructor <;> linarith

/-- arctan via the pi/4 shift: shrinks the series argument from
`x` to `(x-1)/(x+1)` when `x` is near 1 (0 < x < 1). -/
private theorem cvp_atan_shift {x : Real} (hx0 : 0 < x) (hx1 : x < 1) :
    Real.arctan x = Real.pi / 4 + Real.arctan ((x - 1) / (x + 1)) := by
  have hxb : (0:Real) < Real.arctan x ∧ Real.arctan x < Real.pi / 4 := by
    constructor
    · exact Real.arctan_pos.mpr hx0
    · rw [← Real.arctan_one]
      exact Real.arctan_lt_arctan_iff.mpr hx1
  have hxne : ∀ k : ℤ, Real.arctan x ≠ (2 * (k:Real) + 1) * (Real.pi / 2) := by
    intro k hc2
    have hxb1 := hxb.1
    have hxb2 := hxb.2
    rw [hc2] at hxb1
    have hpi2 : (0:Real) < Real.pi / 2 := by linarith [Real.pi_pos]
    rcases lt_trichotomy (k:ℤ) 0 with hk | hk | hk
    · have hk1 : (k:ℤ) ≤ -1 := by omega
      have hkr : (k:Real) ≤ -1 := by exact_mod_cast hk1
      have hM : (2 * (k:Real) + 1) * (Real.pi / 2) ≤ -(Real.pi / 2) := by nlinarith [hkr, hpi2]
      linarith [hxb1, hM, hpi2]
    · rw [hk] at hc2
      norm_num at hc2
      linarith [hc2, hxb2, Real.pi_pos]
    · have hk1 : (1:ℤ) ≤ k := by omega
      have hkr : (k:Real) ≥ 1 := by exact_mod_cast hk1
      have hM : (2 * (k:Real) + 1) * (Real.pi / 2) ≥ (3 : Real) * (Real.pi / 2) := by nlinarith [hkr, hpi2]
      linarith [hxb1, hxb2, hM, hpi2]
  have hyne : ∀ l : ℤ, Real.pi / 4 ≠ (2 * (l:Real) + 1) * (Real.pi / 2) := by
    intro l hc2
    have hpi2 : (0:Real) < Real.pi / 2 := by linarith [Real.pi_pos]
    rcases lt_trichotomy (l:ℤ) 0 with hl | hl | hl
    · have hl1 : (l:ℤ) ≤ -1 := by omega
      have hlr : (l:Real) ≤ -1 := by exact_mod_cast hl1
      have hM : (2 * (l:Real) + 1) * (Real.pi / 2) ≤ -(Real.pi / 2) := by nlinarith [hlr, hpi2]
      linarith [hc2, hM, hpi2, Real.pi_pos]
    · rw [hl] at hc2
      norm_num at hc2
      linarith [hc2, hpi2, Real.pi_pos]
    · have hl1 : (1:ℤ) ≤ l := by omega
      have hlr : (l:Real) ≥ 1 := by exact_mod_cast hl1
      have hM : (2 * (l:Real) + 1) * (Real.pi / 2) ≥ (3 : Real) * (Real.pi / 2) := by nlinarith [hlr, hpi2]
      linarith [hc2, hM, hpi2, Real.pi_pos]
  have hne : Real.arctan x - Real.pi / 4 ≠ 0 := by
    linarith [hxb.2]
  have hpos : (0:Real) < 1 + x := by linarith [hx0]
  have hnz1 : (1:Real) - (-1) * x ≠ 0 := by linarith [hx0]
  have hnz2 : (x:Real) + 1 ≠ 0 := by linarith [hx0]
  have h2 := Real.arctan_add (x := (-1:Real)) (y := x) (by linarith [hx0])
  rw [Real.arctan_neg, Real.arctan_one] at h2
  rw [show (x - 1) / (x + 1) = ((-1:Real) + x) / (1 - (-1) * x) from by
    rw [div_eq_div_iff hnz2 hnz1]
    ring]
  linarith
