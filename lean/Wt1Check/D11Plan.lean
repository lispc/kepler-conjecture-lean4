/-! ### 1. Generic helpers (one-time) -/

/-- Generic outward grid comparison: `a/d ≤ n/b` from `a*b ≤ n*d`. -/
theorem grid_le_rat {a b n d : ℤ} (hb : 0 < b) (hd : 0 < d)
    (h : a * b ≤ n * d) : ((a : ℝ) / (d : ℝ)) ≤ ((n : ℝ) / (b : ℝ)) := by
  have hb' : (0 : ℝ) < (b : ℝ) := by exact_mod_cast hb
  have hd' : (0 : ℝ) < (d : ℝ) := by exact_mod_cast hd
  rw [le_div_iff₀ hb', div_mul_eq_mul_div, div_le_iff₀ hd']
  exact_mod_cast h

/-- Generic outward grid comparison: `n/b ≤ a/d` from `n*d ≤ a*b`. -/
theorem grid_ge_rat {a b n d : ℤ} (hb : 0 < b) (hd : 0 < d)
    (h : n * d ≤ a * b) : ((n : ℝ) / (b : ℝ)) ≤ ((a : ℝ) / (d : ℝ)) := by
  have hb' : (0 : ℝ) < (b : ℝ) := by exact_mod_cast hb
  have hd' : (0 : ℝ) < (d : ℝ) := by exact_mod_cast hd
  rw [div_le_iff₀ hb', div_mul_eq_mul_div, le_div_iff₀ hd']
  exact_mod_cast h

/-- `n/d ≤ a/2^96` from the integer inequality `n*2^96 ≤ a*d`. -/
theorem rat_le_grid {n d a : ℤ} (hd : 0 < d) (h : n * 2 ^ 96 ≤ a * d) :
    ((n : ℚ) / (d : ℚ)) ≤ ((a : ℚ) / (2 : ℚ) ^ 96) := by
  have hd' : (0:ℚ) < (d:ℚ) := by exact_mod_cast hd
  rw [le_div_iff₀ (show (0:ℚ) < (2:ℚ)^96 by norm_num)]
  rw [div_mul_eq_mul_div, div_le_iff₀ hd']
  have h' : ((n * 2 ^ 96 : ℤ) : ℚ) ≤ ((a * d : ℤ) : ℚ) := by
    exact_mod_cast h
  push_cast at h' ⊢
  linarith

/-- `a/2^96 ≤ n/d` from the integer inequality `a*d ≤ n*2^96`. -/
theorem grid_le_rat_q {n d a : ℤ} (hd : 0 < d) (h : a * d ≤ n * 2 ^ 96) :
    ((a : ℚ) / (2 : ℚ) ^ 96) ≤ ((n : ℚ) / (d : ℚ)) := by
  have hd' : (0:ℚ) < (d:ℚ) := by exact_mod_cast hd
  rw [div_le_iff₀ (show (0:ℚ) < (2:ℚ)^96 by norm_num)]
  rw [div_mul_eq_mul_div, le_div_iff₀ hd']
  have h' : ((a * d : ℤ) : ℚ) ≤ ((n * 2 ^ 96 : ℤ) : ℚ) := by
    exact_mod_cast h
  push_cast at h' ⊢
  linarith

/-- Real form: `n/d ≤ a/2^96` from the integer inequality. -/
theorem rat_le_gridR {n d a : ℤ} (hd : 0 < d) (h : n * 2 ^ 96 ≤ a * d) :
    ((n : ℝ) / (d : ℝ)) ≤ ((a : ℝ) / GR) := by
  have hq := rat_le_grid (n := n) (d := d) (a := a) hd h
  push_cast at hq ⊢
  rw [GR]
  exact_mod_cast hq

/-- Real form: `a/2^96 ≤ n/d` from the integer inequality. -/
theorem grid_le_ratR {n d a : ℤ} (hd : 0 < d) (h : a * d ≤ n * 2 ^ 96) :
    ((a : ℝ) / GR) ≤ ((n : ℝ) / (d : ℝ)) := by
  have hq := grid_le_rat_q (n := n) (d := d) (a := a) hd h
  push_cast at hq ⊢
  rw [GR]
  exact_mod_cast hq

/-- `ZInt.memR` from the two grid inequalities (definitional). -/
theorem memR_grid {a b : ℤ} {x : ℝ} (h1 : (a : ℝ) / GR ≤ x)
    (h2 : x ≤ (b : ℝ) / GR) : ZInt.memR ⟨a, b⟩ x := ⟨h1, h2⟩

/-- `ZInt.memR` of a grid interval containing a `QInterval` that contains `x`. -/
theorem memR_mono {a b : ℤ} {I : QInterval} {x : ℝ}
    (h1 : (a : ℝ) / GR ≤ (I.lo : ℝ)) (h2 : (I.hi : ℝ) ≤ (b : ℝ) / GR)
    (hx : I.mem x) : ZInt.memR ⟨a, b⟩ x :=
  ⟨le_trans h1 hx.1, le_trans hx.2 h2⟩

/-- Head of a `Forall₂` pair. -/
theorem forall₂_head {l₁ : List ZInt} {l₂ : List ℝ}
    (h : List.Forall₂ ZInt.memR l₁ l₂) {a : ZInt} {b : ℝ}
    (h1 : lget? l₁ 0 = some a) (h2 : lget? l₂ 0 = some b) : ZInt.memR a b := by
  cases h with
  | nil => simp [lget?] at h1
  | cons hab _ =>
      simp only [lget?] at h1 h2
      obtain rfl := Option.some.inj h1
      obtain rfl := Option.some.inj h2
      exact hab

/-- `head?` of `take (n+1)`. -/
theorem head?_take_succ : ∀ (l : List α) (n : Nat),
    (l.take (n + 1)).head? = l.head?
  | [], _ => rfl
  | _ :: _, _ => rfl

/-- `lget?` at index 0 is the head. -/
theorem lget?_zero : ∀ (l : List α), lget? l 0 = l.head?
  | [] => rfl
  | _ :: _ => rfl

/-- `lget?` of a `take`. -/
theorem lget?_take : ∀ (l : List α) (n i : Nat), i < n →
    lget? (l.take n) i = lget? l i
  | [], _, _, _ => by simp [List.take]
  | _ :: _, 0, _, h => by omega
  | _ :: l, m + 1, 0, _ => rfl
  | _ :: l, m + 1, j + 1, h => by
      simp only [List.take_succ_cons, lget?]
      exact lget?_take l m j (by omega)

/-- `{0}` contains `0`. -/
theorem memR_zero : ZInt.memR ⟨0, 0⟩ (0 : ℝ) := by
  refine ⟨?_, ?_⟩ <;> norm_num [GR, GD]

/-- `h0cut` is `{0,1}`-valued. -/
theorem h0cut_mem_01 (x : ℝ) : (0 : ℝ) ≤ h0cut x ∧ h0cut x ≤ 1 := by
  unfold h0cut
  by_cases h : x ≤ 2 * h0
  · rw [if_pos h]; norm_num
  · rw [if_neg h]; norm_num

/-- Below the kink the indicator is `1`. -/
theorem h0cut_eq_one {x : ℝ} (h : x ≤ 2 * h0) : h0cut x = 1 := by
  unfold h0cut; rw [if_pos h]

/-- The three `pq1` factors are non-negative where the product edge matters. -/
theorem h0cut_nonneg (x : ℝ) : (0 : ℝ) ≤ h0cut x := (h0cut_mem_01 x).1

